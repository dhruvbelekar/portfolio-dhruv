---
import Layout from "../layouts/Layout.astro";
import ScrollReveal from "../components/ScrollReveal";
import Marquee from "../components/Marquee";
import VideoCarousel from "../components/VideoCarousel";

const carouselA = ["/video/sidequest/reel-1.mp4", "/video/sidequest/reel-2.mp4", "/video/sidequest/reel-3.mp4"];
const carouselB = ["/video/sidequest/reel-4.mp4", "/video/sidequest/reel-5.mp4", "/video/sidequest/reel-6.mp4"];

const strips = [
  ["strip1-1.jpg", "strip1-2.jpg", "strip1-3.jpg", "strip1-4.jpg"],
  ["strip2-1.png", "strip2-2.png", "strip2-3.png", "strip2-4.png"],
  ["strip3-1.png", "strip3-2.png", "strip3-3.png", "strip3-4.png"],
];
---

<Layout title="Side Quest — Dhruv Belekar" ogImage="/og/og-home-sidequest.png">
  <section class="px-6 pt-16 md:px-10">
    <div class="mx-auto max-w-[1400px]">
      <ScrollReveal client:load>
        <p class="text-xs font-bold tracking-wide text-blue">SIDE QUEST</p>
        <h1
          class="mt-2 max-w-2xl font-black leading-tight text-ink"
          style="font-family: var(--font-display); font-size: var(--type-heading);"
        >
          A collection of photography, videography, and video editing projects.
        </h1>
      </ScrollReveal>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 md:max-w-2xl">
        <ScrollReveal client:load>
          <VideoCarousel client:load sources={carouselA} />
        </ScrollReveal>
        <ScrollReveal client:load delay={0.1}>
          <VideoCarousel client:load sources={carouselB} />
        </ScrollReveal>
      </div>

      <div class="mt-[var(--space-section)] space-y-6 pb-[var(--space-section)]">
        {
          strips.map((strip, i) => (
            <Marquee
              client:load
              speed={20 + i * 6}
              direction={i % 2 === 0 ? "left" : "right"}
              gap="1.5rem"
            >
              {strip.map((file) => (
                <img
                  src={`/img/sidequest/${file}`}
                  alt=""
                  class="h-56 w-auto rounded-xl object-cover sm:h-72"
                />
              ))}
            </Marquee>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
