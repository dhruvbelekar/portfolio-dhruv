---
import Layout from "../layouts/Layout.astro";
import ScrollReveal from "../components/ScrollReveal";
import Marquee from "../components/Marquee";
import BioCopy from "../components/BioCopy.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import OffTheClock from "../components/OffTheClock.astro";
import StatCounter from "../components/StatCounter";
import { skillsRowA, skillsRowB, aboutStats, testimonials } from "../data/projects";
---

<Layout title="About — Dhruv Belekar" ogImage="/og/og-projects-about-contact.png">
  <section class="px-6 pt-16 md:px-10">
    <div class="mx-auto max-w-[1400px]">
      <ScrollReveal client:load>
        <h1
          class="select-none text-center font-black leading-[0.9] text-blue"
          style="font-family: var(--font-display); font-size: var(--type-section);"
        >
          About Dhruv
        </h1>
      </ScrollReveal>

      <div class="mt-12 grid grid-cols-1 items-start gap-6 sm:grid-cols-[280px_1fr] sm:gap-10 md:grid-cols-[360px_1fr]">
        <ScrollReveal client:load>
          <div class="group w-full focus:outline-none" tabindex="0">
            <div class="relative aspect-square w-full overflow-hidden rounded-2xl group-focus-visible:ring-2 group-focus-visible:ring-blue">
              <img
                src="/img/about/portrait-illustration.png"
                alt="Illustrated portrait of Dhruv"
                class="absolute inset-0 h-full w-full object-cover transition-opacity duration-150 ease-out group-hover:opacity-0 group-focus-within:opacity-0"
              />
              <img
                src="/img/about/portrait-illustration-tongue.webp"
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-150 ease-out group-hover:opacity-100 group-focus-within:opacity-100"
              />
            </div>
            <p class="mt-3 text-center text-sm font-bold text-blue transition-opacity duration-200 ease-out group-hover:opacity-0 group-focus-within:opacity-0">
              <span class="sm:hidden">Tap me</span>
              <span class="hidden sm:inline">Hover over me</span>
            </p>
          </div>
        </ScrollReveal>
        <ScrollReveal client:load delay={0.1} className="min-w-0">
          <BioCopy />
        </ScrollReveal>
      </div>

      {/* Counts come from the work itself, so they cannot drift out of date. */}
      <ScrollReveal client:load delay={0.15}>
        <div class="mt-16 grid grid-cols-3 gap-6 border-y border-ink/10 py-10">
          {
            aboutStats.map((stat) => (
              <StatCounter client:load target={stat.value} label={stat.label} />
            ))
          }
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- Skills marquee (full-bleed, edge to edge) -->
  <div class="mt-10 space-y-2 py-2 text-2xl font-bold tracking-[-0.05em] text-blue sm:text-3xl">
    <Marquee client:load speed={90}>
      {
        Array(8)
          .fill(skillsRowA)
          .flat()
          .map((s, i) => (
            <span key={i} class="whitespace-nowrap">
              {s} <span class="text-gray-300">✦</span>
            </span>
          ))
      }
    </Marquee>
    <Marquee client:load speed={105} direction="right">
      {
        Array(8)
          .fill(skillsRowB)
          .flat()
          .map((s, i) => (
            <span key={i} class="whitespace-nowrap">
              {s} <span class="text-gray-300">✦</span>
            </span>
          ))
      }
    </Marquee>
  </div>

  <ScrollReveal client:load className="mt-16">
    <OffTheClock />
  </ScrollReveal>

  <section class="px-6 md:px-10">
    <div class="mx-auto max-w-[1400px]">
      <ScrollReveal client:load className="mt-20">
        <ExperienceSection />
      </ScrollReveal>
    </div>
  </section>

  {/* The quotes only ran on the home page; this is where someone is deciding
      whether to work with him, so they belong here too. Held still rather than
      marqueed, because the home page already moves them. */}
  <section class="px-6 pb-[var(--space-section)] md:px-10">
    <div class="mx-auto max-w-[1400px]">
      <ScrollReveal client:load>
        <h3
          class="text-center text-3xl font-black text-blue sm:text-4xl"
          style="font-family: var(--font-display);"
        >
          Kind words
        </h3>
      </ScrollReveal>
      <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          testimonials.map((t, i) => (
            <ScrollReveal client:load delay={Math.min(i, 3) * 0.08}>
              <li class="group flex h-full flex-col rounded-2xl border border-ink/10 p-6 transition-[transform,border-color,box-shadow] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-blue/40 hover:shadow-[0_14px_34px_rgba(19,67,240,0.10)]">
                <div class="flex items-center gap-3">
                  <img
                    src={t.avatar}
                    alt=""
                    loading="lazy"
                    class="h-10 w-10 shrink-0 rounded-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110"
                  />
                  <div class="min-w-0">
                    <p class="truncate font-bold text-ink transition-colors duration-300 group-hover:text-blue">
                      {t.name}
                    </p>
                    <p class="truncate text-sm text-ink-muted">{t.role}</p>
                  </div>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-ink-muted">{t.quote}</p>
              </li>
            </ScrollReveal>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
