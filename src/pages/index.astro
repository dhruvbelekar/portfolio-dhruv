---
import Layout from "../layouts/Layout.astro";
import ScrollReveal from "../components/ScrollReveal";
import Marquee from "../components/Marquee";
import ProjectCard from "../components/ProjectCard.astro";
import BioCopy from "../components/BioCopy.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import {
  projects,
  testimonials,
  skillsRowA,
  skillsRowB,
  clientLogos,
} from "../data/projects";
---

<Layout>
  <!-- Hero -->
  <section class="px-6 md:px-10">
    <div class="flex min-h-screen flex-col justify-center pt-10">
      <h1
        class="select-none text-center font-black leading-[0.85] text-blue"
        style="font-family: var(--font-display); font-size: clamp(3.5rem, 23vw, 900px);"
      >
        dhruv
      </h1>
      <p
        class="mt-6 font-black leading-tight text-gray-400"
        style="font-family: var(--font-display); font-size: clamp(1.125rem, 2.3vw, 40px); text-indent: 42%;"
      >
        I design <span class="text-blue">digital experiences</span>,{" "}
        create <span class="text-blue">visual stories</span>,{" "}
        and bring ideas to life through <span class="text-blue">design and film</span>.{" "}
        I also have a slight obsession with the color <span class="text-blue">blue</span>. You'll notice.
      </p>
    </div>

    <div class="pb-6">
      <div class="overflow-hidden rounded-3xl bg-black/5">
        <video
          class="h-auto w-full"
          src="/video/hero.mp4"
          autoplay
          muted
          loop
          playsinline
        ></video>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="px-6 pt-[var(--space-section)] md:px-10">
    <div class="mx-auto max-w-[1400px]">
      <ScrollReveal client:load>
        <h2
          class="select-none font-black leading-[0.9] text-blue"
          style="font-family: var(--font-display); font-size: var(--type-section);"
        >
          Featured Projects
        </h2>
      </ScrollReveal>

      <div class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2">
        {
          projects.map((p, i) => (
            <ScrollReveal client:load delay={i * 0.08}>
              <ProjectCard
                slug={p.slug}
                title={p.title}
                category={p.category}
                image={p.thumb}
                alt={p.thumbAlt}
              />
            </ScrollReveal>
          ))
        }
      </div>

      <a
        href="/projects"
        class="mt-12 inline-block text-2xl font-bold text-blue transition-opacity hover:opacity-70 sm:text-3xl"
      >
        View all projects
      </a>
    </div>
  </section>

  <!-- About preview -->
  <section class="px-6 pt-[var(--space-section)] md:px-10">
    <div class="mx-auto max-w-[1400px]">
      <ScrollReveal client:load>
        <h2
          class="select-none text-center font-black leading-[0.9] text-blue"
          style="font-family: var(--font-display); font-size: var(--type-section);"
        >
          About Dhruv
        </h2>
      </ScrollReveal>

      <div class="mt-12 grid grid-cols-[160px_1fr] items-start gap-6 sm:grid-cols-[280px_1fr] sm:gap-10 md:grid-cols-[360px_1fr]">
        <ScrollReveal client:load>
          <img
            src="/img/about/portrait-halftone-blue.png"
            alt="About Image of Designer"
            class="aspect-square w-full rounded-2xl object-cover"
          />
        </ScrollReveal>

        <ScrollReveal client:load delay={0.1} className="min-w-0">
          <BioCopy />
        </ScrollReveal>
      </div>

    </div>
  </section>

  <!-- Skills marquee (full-bleed, edge to edge) -->
  <div class="mt-10 space-y-2 py-2 text-2xl font-bold tracking-[-0.05em] text-blue sm:text-3xl">
    <Marquee client:load speed={55}>
      {
        Array(8)
          .fill(skillsRowA)
          .flat()
          .map((s, i) => (
            <span key={i} class="whitespace-nowrap">
              {s} <span class="text-gray-300">✦</span>
            </span>
          ))
      }
    </Marquee>
    <Marquee client:load speed={65} direction="right">
      {
        Array(8)
          .fill(skillsRowB)
          .flat()
          .map((s, i) => (
            <span key={i} class="whitespace-nowrap">
              {s} <span class="text-gray-300">✦</span>
            </span>
          ))
      }
    </Marquee>
  </div>

  <section class="px-6 md:px-10">
    <div class="mx-auto max-w-[1400px]">
      <ScrollReveal client:load className="mt-12">
        <ExperienceSection />
      </ScrollReveal>
    </div>
  </section>

  <!-- Client logos -->
  <section class="mt-[var(--space-section)] border-y border-black/5 py-10">
    <Marquee client:load speed={60} gap="4rem">
      {
        Array(6)
          .fill(clientLogos)
          .flat()
          .map((logo, i) => (
            <img key={i} src={logo} alt="" class="h-8 w-auto object-contain sm:h-10" />
          ))
      }
    </Marquee>
  </section>

  <!-- Testimonials -->
  <section class="px-6 py-[var(--space-section)] md:px-10">
    <div class="mx-auto max-w-[1400px]">
      <ScrollReveal client:load>
        <h2
          class="select-none text-center font-black leading-[0.9] text-blue"
          style="font-family: var(--font-display); font-size: var(--type-section);"
        >
          Testimonials
        </h2>
      </ScrollReveal>

      <div class="mt-12 flex flex-col gap-10">
        <Marquee client:load speed={38} gap="1rem">
          {
            Array(4)
              .fill([testimonials[2], testimonials[3]])
              .flat()
              .map((t, i) => (
                <div key={i} class="flex h-[230px] w-[320px] shrink-0 flex-col rounded-2xl border border-black/10 p-6">
                  <div class="flex items-center gap-3">
                    <img src={t.avatar} alt="" class="h-10 w-10 shrink-0 rounded-full object-cover" />
                    <div>
                      <p class="font-bold text-ink">{t.name}</p>
                      <p class="text-sm text-ink-muted">{t.role}</p>
                    </div>
                  </div>
                  <p class="mt-4 line-clamp-4 text-sm text-ink-muted">{t.quote}</p>
                </div>
              ))
          }
        </Marquee>
        <Marquee client:load speed={44} gap="1rem" direction="right">
          {
            Array(4)
              .fill([testimonials[0], testimonials[1]])
              .flat()
              .map((t, i) => (
                <div key={i} class="flex h-[230px] w-[320px] shrink-0 flex-col rounded-2xl border border-black/10 p-6">
                  <div class="flex items-center gap-3">
                    <img src={t.avatar} alt="" class="h-10 w-10 shrink-0 rounded-full object-cover" />
                    <div>
                      <p class="font-bold text-ink">{t.name}</p>
                      <p class="text-sm text-ink-muted">{t.role}</p>
                    </div>
                  </div>
                  <p class="mt-4 line-clamp-4 text-sm text-ink-muted">{t.quote}</p>
                </div>
              ))
          }
        </Marquee>
      </div>
    </div>
  </section>
</Layout>
