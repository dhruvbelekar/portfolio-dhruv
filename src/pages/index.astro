---
import Layout from "../layouts/Layout.astro";
import IntroLoader from "../components/IntroLoader.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import Marquee from "../components/Marquee.astro";
import ProjectRow from "../components/ProjectRow.astro";
import ProjectFilterNav from "../components/ProjectFilterNav.astro";
import BioCopy from "../components/BioCopy.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import ClientLogos from "../components/ClientLogos.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import { projects, filterCategories, skillsRowA, skillsRowB } from "../data/projects";
---

<Layout>
  <IntroLoader />

  <!-- Hero -->
  <section class="overflow-x-hidden px-6">
    <div
      class="mx-auto flex min-h-[calc(100svh-96px)] w-full max-w-[1400px] flex-col justify-center pt-6 sm:min-h-[calc(100svh-112px)]"
      style="--name-font: clamp(1.5rem, var(--shell) * 0.135, 380px); --name-width: calc(var(--name-font) * 5.7);"
    >
      <h1
        class="select-none text-center font-bold leading-[0.8] text-blue"
        style="font-family: var(--font-display); font-size: var(--name-font); letter-spacing: -0.05em;"
      >
        <span class="relative inline-block whitespace-nowrap">
          {/*
            Both faces ship stacked and cross-faded: fetching the second on first
            hover would land it after the pointer had gone. `active` carries the
            swap to touch, where there is no hover.
          */}
          <span class="group absolute left-[4.475em] -top-[0.375em] block w-[0.70em]">
            <span
              class="block rotate-[8deg] transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-rotate-[5deg] group-hover:scale-105 group-active:-rotate-[5deg] group-active:scale-105 motion-reduce:transition-none"
            >
              <img
                src="/img/hero/face.webp"
                width={420}
                height={400}
                alt="Dhruv Belekar, drawn in blue line art"
                fetchpriority="high"
                class="w-full transition-opacity duration-300 ease-out group-hover:opacity-0 group-active:opacity-0"
              />
              <img
                src="/img/hero/face-tongue.webp"
                width={420}
                height={400}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 w-full opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100 group-active:opacity-100"
              />
            </span>
          </span>
          dhruv belekar
        </span>
      </h1>
      <p
        class="mx-auto w-full font-bold leading-tight text-gray-400"
        style="font-family: var(--font-display); font-size: clamp(1.125rem, var(--shell) * 0.028, 40px); text-indent: 42%; margin-top: clamp(1rem, var(--shell) * 0.048, 70px); max-width: var(--name-width);"
      >
        I design <span class="text-blue">digital experiences</span>,{" "}
        create <span class="text-blue">visual stories</span>,{" "}
        and bring ideas to life through <span class="text-blue">design and film</span>.{" "}
        I&nbsp;also have a&nbsp;slight obsession with the color <span class="text-blue">blue</span>. You'll notice.
      </p>
    </div>

    <ClientLogos class="-mx-6 mb-6" />
  </section>

  <!-- Projects -->
  <section
    id="projects"
    class="scroll-mt-24 px-6 pt-[var(--space-section)] md:px-10 sm:scroll-mt-28"
    data-projects-section
  >
    <div class="mx-auto max-w-[1400px]">
      <ScrollReveal>
        <h2
          class="select-none text-center font-black leading-[0.9] text-blue"
          style="font-family: var(--font-display); font-size: var(--type-section);"
        >
          Projects
        </h2>
      </ScrollReveal>

      <div class="mt-12 pb-24">
        {
          projects.map((p, i) => (
            <div data-project-category={p.filterCategory}>
              <ScrollReveal delay={0.05} y={40}>
                <ProjectRow
                  slug={p.slug}
                  title={p.title}
                  category={p.category}
                  image={p.thumb}
                  alt={p.thumbAlt}
                  description={p.description}
                  timeline={p.timeline}
                  index={i}
                />
              </ScrollReveal>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ProjectFilterNav
    categories={filterCategories}
    itemSelector="[data-project-category]"
    sectionSelector="[data-projects-section]"
  />

  <!-- About preview -->
  <section class="px-6 pt-[var(--space-section)] md:px-10">
    <div class="mx-auto max-w-[1400px]">
      <ScrollReveal>
        <h2
          class="select-none text-center font-black leading-[0.9] text-blue"
          style="font-family: var(--font-display); font-size: var(--type-section);"
        >
          About Dhruv
        </h2>
      </ScrollReveal>

      <div class="mt-12 grid grid-cols-1 items-start gap-6 sm:grid-cols-[280px_1fr] sm:gap-10 md:grid-cols-[360px_1fr]">
        <ScrollReveal>
          <div class="group w-full focus:outline-none" tabindex="0">
            <div class="relative aspect-square w-full overflow-hidden rounded-2xl group-focus-visible:ring-2 group-focus-visible:ring-blue">
              <img
                src="/img/about/portrait-illustration.webp"
                alt="Illustrated portrait of Dhruv"
                class="absolute inset-0 h-full w-full object-cover transition-opacity duration-150 ease-out group-hover:opacity-0 group-focus-within:opacity-0"
              />
              <img
                src="/img/about/portrait-illustration-tongue.webp"
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-150 ease-out group-hover:opacity-100 group-focus-within:opacity-100"
              />
            </div>
            <p class="mt-3 text-center text-sm font-bold text-blue transition-opacity duration-200 ease-out group-hover:opacity-0 group-focus-within:opacity-0">
              <span class="sm:hidden">Tap me</span>
              <span class="hidden sm:inline">Hover over me</span>
            </p>
          </div>
        </ScrollReveal>

        <ScrollReveal delay={0.1} class="min-w-0">
          <BioCopy />
        </ScrollReveal>
      </div>

    </div>
  </section>

  <!-- Skills marquee (full-bleed, edge to edge) -->
  <div class="mt-10 space-y-2 py-2 text-2xl font-bold tracking-[-0.05em] text-blue sm:text-3xl">
    <Marquee speed={90}>
      {
        Array(8)
          .fill(skillsRowA)
          .flat()
          .map((s, i) => (
            <span key={i} class="whitespace-nowrap">
              {s} <span class="text-gray-300">✦</span>
            </span>
          ))
      }
    </Marquee>
    <Marquee speed={105} direction="right">
      {
        Array(8)
          .fill(skillsRowB)
          .flat()
          .map((s, i) => (
            <span key={i} class="whitespace-nowrap">
              {s} <span class="text-gray-300">✦</span>
            </span>
          ))
      }
    </Marquee>
  </div>

  <section class="px-6 md:px-10">
    <div class="mx-auto max-w-[1400px]">
      <ScrollReveal class="mt-12">
        <ExperienceSection />
      </ScrollReveal>
    </div>
  </section>

  <TestimonialsSection />
</Layout>
