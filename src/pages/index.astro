---
import Layout from "../layouts/Layout.astro";
import IntroLoader from "../components/IntroLoader.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import ProjectRow from "../components/ProjectRow.astro";
import ProjectFilterNav from "../components/ProjectFilterNav.astro";
import HighlightsCarousel from "../components/HighlightsCarousel.astro";
import BioCopy from "../components/BioCopy.astro";
import MagicText from "../components/MagicText.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import ServicesSection from "../components/ServicesSection.astro";
import TechStackSection from "../components/TechStackSection.astro";
import ClientLogos from "../components/ClientLogos.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import HeroPortal from "../components/HeroPortal";
import { projects, filterCategories } from "../data/projects";

// The landing page leads with these few; the rest wait behind a button.
const highlightSlugs = ["mahavitaran", "drive", "frelo", "mp4"];
const highlights = highlightSlugs.map((slug) => projects.find((p) => p.slug === slug)!);
const moreProjects = projects.filter((p) => !highlightSlugs.includes(p.slug));
---

<Layout>
  <IntroLoader />

  <!--
    Hero. The name is a way in: scrolling takes the camera into one of its
    letters until the screen is all blue, and the introduction is inside.
    The face and the introduction are written here and handed to the portal,
    so the intro reaches them as it always has.
  -->
  <div data-hero-portal>
    <HeroPortal client:load>
      <div slot="front" class="hero-front">
        <h1 class="sr-only">Dhruv Belekar</h1>
        <div class="hero-face-spot" data-hero-depth="28">
          {/*
            Both faces ship stacked and cross-faded: fetching the second on first
            hover would land it after the pointer had gone. `active` carries the
            swap to touch, where there is no hover.
          */}
          <span data-hero-face data-hero-depth="20" class="group block">
            <span
              class="block rotate-[8deg] transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-rotate-[5deg] group-hover:scale-105 group-active:-rotate-[5deg] group-active:scale-105 motion-reduce:transition-none"
            >
              <img
                src="/img/hero/face.webp"
                width={420}
                height={400}
                alt="Dhruv Belekar, drawn in blue line art"
                fetchpriority="high"
                class="w-full transition-opacity duration-300 ease-out group-hover:opacity-0 group-active:opacity-0"
              />
              <img
                src="/img/hero/face-tongue.webp"
                width={420}
                height={400}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 w-full opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100 group-active:opacity-100"
              />
            </span>
          </span>
        </div>
      </div>

      <p class="hero-intro" style="font-family: var(--font-display);">
        I design <span>digital experiences</span>,{" "}
        create <span>visual stories</span>,{" "}
        and bring ideas to life through <span>design and film</span>.{" "}
        I&nbsp;also have a&nbsp;slight obsession with the color <span>blue</span>. You'll notice.
      </p>
    </HeroPortal>
  </div>

  <section class="overflow-x-hidden px-6 pt-[var(--space-section)]">
    <ClientLogos class="-mx-6 mb-6" />
  </section>

  <!-- Highlights, with the full project list folded away beneath them -->
  <section
    id="projects"
    class="scroll-mt-24 px-6 pt-[var(--space-section)] md:px-10 sm:scroll-mt-28"
  >
    <div class="mx-auto max-w-[1400px]">
      <ScrollReveal>
        <h2
          class="select-none text-center font-black leading-[0.9] text-blue"
          style="font-family: var(--font-display); font-size: var(--type-section);"
        >
          Highlights
        </h2>
        <p class="mt-4 text-center text-base text-ink-muted">A few projects I'm proud of.</p>
      </ScrollReveal>

      <ScrollReveal delay={0.05} y={40} class="mt-12">
        <HighlightsCarousel projects={highlights} />
      </ScrollReveal>

      <div class="mt-12 flex justify-center">
        <button
          type="button"
          data-more-projects
          aria-expanded="false"
          aria-controls="all-projects"
          class="group flex items-center gap-2 rounded-full border border-blue/30 px-6 py-3 text-sm font-bold text-blue transition-[background-color,border-color,color] duration-300 ease-out hover:border-blue hover:bg-blue hover:text-white"
        >
          <span data-more-label>View more projects</span>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="h-4 w-4 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-aria-expanded:rotate-180"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>
      </div>

      <div
        id="all-projects"
        hidden
        class="mt-12 scroll-mt-24 pb-24 sm:scroll-mt-28"
        data-projects-section
      >
        {
          moreProjects.map((p, i) => (
            <div data-project-category={p.filterCategory}>
              <ScrollReveal delay={0.05} y={40}>
                <ProjectRow
                  slug={p.slug}
                  title={p.title}
                  category={p.category}
                  image={p.thumb}
                  alt={p.thumbAlt}
                  description={p.description}
                  timeline={p.timeline}
                  index={i}
                  promo={p.promo}
                  cycle={p.thumbCycle}
                />
              </ScrollReveal>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    const button = document.querySelector<HTMLButtonElement>("[data-more-projects]");
    const list = document.getElementById("all-projects");
    const label = button?.querySelector("[data-more-label]");

    button?.addEventListener("click", () => {
      if (!list || !label) return;
      const open = list.hidden;
      list.hidden = !open;
      button.setAttribute("aria-expanded", String(open));
      label.textContent = open ? "Show fewer projects" : "View more projects";
      // The list folding away from under someone halfway down it would drop
      // them somewhere unrelated, so they are brought back to the button.
      if (!open) button.scrollIntoView({ block: "center" });
      // The filter bar decides whether to show itself on scroll; this nudges
      // it to look again now the list has appeared or gone.
      window.dispatchEvent(new Event("scroll"));
    });
  </script>

  <ProjectFilterNav
    categories={filterCategories}
    itemSelector="[data-project-category]"
    sectionSelector="[data-projects-section]"
  />

  {/* Straight after the work, where people actually reach it; at the foot of
      the page, past the experience timeline, hardly anyone did. */}
  <TestimonialsSection />

  {/*
    Straight after the testimonials: what the work is made with, then where
    it was made, before the longer introduction.
  */}
  <TechStackSection />

  {/*
    Outside the usual shell: the section pins itself and hands the screen to
    one company at a time, revealing what was done there as the page scrolls.
  */}
  <ExperienceSection />

  <!-- About preview. No top padding: the experience section above already
       ends on a full section gap. -->
  <section class="px-6 md:px-10">
    <div class="mx-auto max-w-[1400px]">
      <ScrollReveal>
        <h2
          class="select-none text-center font-black leading-[0.9] text-blue"
          style="font-family: var(--font-display); font-size: var(--type-section);"
        >
          About Dhruv
        </h2>
      </ScrollReveal>

      <div class="mt-12 grid grid-cols-1 items-start gap-6 sm:grid-cols-[280px_1fr] sm:gap-10 md:grid-cols-[360px_1fr]">
        <ScrollReveal>
          <div class="group w-full focus:outline-none" tabindex="0">
            <div class="relative aspect-square w-full overflow-hidden rounded-2xl group-focus-visible:ring-2 group-focus-visible:ring-blue">
              <img
                src="/img/about/portrait-illustration.webp"
                alt="Illustrated portrait of Dhruv"
                class="absolute inset-0 h-full w-full object-cover transition-opacity duration-150 ease-out group-hover:opacity-0 group-focus-within:opacity-0"
              />
              <img
                src="/img/about/portrait-illustration-tongue.webp"
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-150 ease-out group-hover:opacity-100 group-focus-within:opacity-100"
              />
            </div>
            <p class="mt-3 text-center text-sm font-bold text-blue transition-opacity duration-200 ease-out group-hover:opacity-0 group-focus-within:opacity-0">
              <span class="sm:hidden">Tap me</span>
              <span class="hidden sm:inline">Hover over me</span>
            </p>
          </div>
        </ScrollReveal>

        {/*
          No ScrollReveal around the bio: the words lighting up one by one is
          the reveal, and fading the whole block in underneath it just made the
          same copy fade twice.
        */}
        <MagicText class="min-w-0">
          <BioCopy />
        </MagicText>
      </div>

    </div>
  </section>

  {/*
    The skills used to stream past in two tickers, which meant none of them
    could be read for longer than a second and none of them could be shown.
    They stand still now, and each one has a picture.
  */}
  <ServicesSection />
</Layout>

<script>
  /*
    The hero follows the pointer. Each layer carries a reach in pixels and the
    ones further forward travel further, so the face clears the name and the
    hero reads as having depth rather than sliding as one sheet. The name is
    drawn by the portal, cut out of its blue layer, so that layer is what
    moves; the face rides with it and then a little further on its own.

    It writes `translate` rather than `transform`: the intro owns `transform`
    on the face while it reveals it, and the face tilts on hover from its own,
    so neither is touched.

    Once the camera starts into the name, the lean is let go over the first
    stretch of the scroll: the blue layer fills the screen by the end, and a
    screen of blue sliding about would show its edges.
  */
  const hero = document.querySelector<HTMLElement>("[data-hero-portal]");
  const layers: { find: () => HTMLElement | null; reach: number }[] = [
    { find: () => document.querySelector(".hero-portal [data-gp-field]"), reach: 28 },
    ...[...document.querySelectorAll<HTMLElement>("[data-hero-depth]")].map((el) => ({
      find: () => el,
      reach: Number(el.dataset.heroDepth) || 0,
    })),
  ];

  if (hero) {
    const fine = window.matchMedia("(pointer: fine)");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    // The share of the remaining distance covered each 60th of a second. Low
    // enough that the hero drifts after the pointer rather than snapping to it.
    const EASE = 0.14;
    // How far into the dive, as the portal counts it, the lean is gone.
    const LET_GO = 0.08;

    let listening = false;
    let onScreen = true;
    let frame = 0;
    let last = 0;
    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;

    const presence = () => {
      const progress = Number(document.querySelector<HTMLElement>(".hero-portal")?.dataset.gpProgress ?? 0);
      const t = Math.min(Math.max(progress / LET_GO, 0), 1);
      return 1 - t * t * (3 - 2 * t);
    };

    const paint = (now: number) => {
      // Scaled by the time since the last frame, so a 120Hz screen eases at
      // the same pace as a 60Hz one instead of twice as fast.
      const steps = last ? Math.min((now - last) / (1000 / 60), 4) : 1;
      last = now;
      const k = 1 - Math.pow(1 - EASE, steps);
      x += (targetX - x) * k;
      y += (targetY - y) * k;

      // Close enough to land on the target exactly, so the hero comes to rest
      // where it was set rather than a hundredth of a pixel off it.
      const settled = Math.abs(targetX - x) < 0.0005 && Math.abs(targetY - y) < 0.0005;
      if (settled) {
        x = targetX;
        y = targetY;
      }

      const share = presence();
      for (const { find, reach } of layers) {
        const el = find();
        if (!el) continue;
        const dx = x * reach * share;
        const dy = y * reach * share;
        el.style.translate = dx || dy ? `${dx.toFixed(2)}px ${dy.toFixed(2)}px` : "";
      }

      // Once it has caught up there is nothing to draw until the pointer moves.
      if (settled) {
        frame = 0;
        last = 0;
        return;
      }
      frame = requestAnimationFrame(paint);
    };

    const wake = () => {
      if (!frame && onScreen) frame = requestAnimationFrame(paint);
    };

    // Measured against the whole window rather than the hero, as the reference
    // does: the pointer anywhere on screen is somewhere the hero can lean to.
    const onMove = (e: MouseEvent) => {
      targetX = (e.clientX / window.innerWidth - 0.5) * 2;
      targetY = (e.clientY / window.innerHeight - 0.5) * 2;
      wake();
    };

    // Leaving the window lets the hero settle back to where it was set.
    const onLeave = () => {
      targetX = 0;
      targetY = 0;
      wake();
    };

    // Scrolled past, the hero is not drawn at all.
    const observer = new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (onScreen) wake();
    });

    const start = () => {
      if (listening) return;
      listening = true;
      document.addEventListener("mousemove", onMove, { passive: true });
      document.documentElement.addEventListener("mouseleave", onLeave);
      // The lean follows the scroll out as well as the pointer.
      window.addEventListener("scroll", wake, { passive: true });
      observer.observe(hero);
    };

    const stop = () => {
      if (!listening) return;
      listening = false;
      cancelAnimationFrame(frame);
      frame = 0;
      last = 0;
      targetX = targetY = x = y = 0;
      document.removeEventListener("mousemove", onMove);
      document.documentElement.removeEventListener("mouseleave", onLeave);
      window.removeEventListener("scroll", wake);
      observer.disconnect();
      for (const { find } of layers) {
        const el = find();
        if (el) el.style.translate = "";
      }
    };

    // Touch has no pointer to follow, and reduced motion asked for stillness.
    const sync = () => (fine.matches && !reduced.matches ? start() : stop());
    sync();
    fine.addEventListener("change", sync);
    reduced.addEventListener("change", sync);
  }
</script>

<style>
  /*
    The face sits where it did on the old heading: 4.475em along the name,
    its top 1.14em above the baseline, 0.7em wide. The portal draws the name
    centred and publishes where the top and bottom of its letters land, which
    gives both the size of an em and the baseline. The constants are Inter
    Bold's, tracked to -0.05em: the letters stand 0.7393em tall, 0.7275em of
    it above the baseline, and run 5.7095em wide, starting 0.0283em in.
  */
  /*
    The portal's frame is a whole screen tall and pins to the top of it, where
    the sticky nav sits over it. Starting it under the nav, rather than below
    it, keeps the frame in the same place before and after it pins, and lets
    the name be centred on the whole screen. The nav is a 3.5rem logo, 4.5rem
    from `sm`, with 1.25rem above and below.
  */
  @media (prefers-reduced-motion: no-preference) {
    [data-hero-portal] {
      margin-top: -6rem;
    }
    @media (min-width: 640px) {
      [data-hero-portal] {
        margin-top: -7rem;
      }
    }
  }

  .hero-front {
    --em: calc((var(--gp-word-bottom, 60%) - var(--gp-word-top, 40%)) / 0.7393);
    position: absolute;
    inset: 0;
  }
  .hero-face-spot {
    position: absolute;
    left: calc(50cqw + (4.475 - 0.0283 - 5.7095 / 2) * var(--em));
    top: calc(var(--gp-word-top, 40%) + (0.7275 - 1.14) * var(--em));
    width: calc(0.7 * var(--em));
    /* The front layer ignores the pointer; the face still wants its hover. */
    pointer-events: auto;
  }

  /* Inside the blue: the introduction, in white, with the parts that matter
     at full strength and the rest let back. */
  .hero-intro {
    max-width: 22em;
    margin: 0 auto;
    text-align: center;
    color: rgb(255 255 255 / 0.62);
    font-weight: 700;
    font-size: clamp(1.625rem, 1rem + 2.6vw, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .hero-intro span {
    color: var(--color-paper);
  }

  /* The portal's own caption, as one quiet line under the name. Picking a
     letter is by pointer or tap on the letters themselves, so the dropdown it
     offers touch screens is not needed. */
  :global(.hero-portal [data-gp-caption]) {
    inset: calc(var(--gp-word-bottom, 60%) + clamp(2rem, 7vh, 4.5rem)) 1.5rem auto;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  :global(.hero-portal [data-gp-hint]),
  :global(.hero-portal [data-gp-touch-picker]) {
    display: none !important;
  }
  /* The link into the section is kept for the keyboard, where it skips the
     dive, and only shows once it has focus. */
  :global(.hero-portal [data-gp-caption]:not(:focus-within)) {
    clip-path: inset(50%);
  }
  :global(.hero-portal [data-gp-enter]) {
    gap: 0.5rem;
    transition: color 0.3s ease;
  }
  :global(.hero-portal [data-gp-enter]:hover) {
    color: var(--color-blue);
  }
</style>
