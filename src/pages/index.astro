---
import Layout from "../layouts/Layout.astro";
import IntroLoader from "../components/IntroLoader.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import ProjectRow from "../components/ProjectRow.astro";
import ProjectFilterNav from "../components/ProjectFilterNav.astro";
import BioCopy from "../components/BioCopy.astro";
import MagicText from "../components/MagicText.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import ServicesSection from "../components/ServicesSection.astro";
import TechStackSection from "../components/TechStackSection.astro";
import ClientLogos from "../components/ClientLogos.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import { projects, filterCategories } from "../data/projects";
---

<Layout>
  <IntroLoader />

  <!-- Hero -->
  <section class="overflow-x-hidden px-6">
    <div
      class="mx-auto flex min-h-[calc(100svh-96px)] w-full max-w-[1400px] flex-col justify-center pt-6 sm:min-h-[calc(100svh-112px)]"
      style="--name-font: clamp(1.5rem, var(--shell) * 0.135, 380px); --name-width: calc(var(--name-font) * 5.7);"
    >
      <h1
        data-hero-name
        data-hero-depth="28"
        class="select-none text-center font-bold leading-[0.8] text-blue"
        style="font-family: var(--font-display); font-size: var(--name-font); letter-spacing: -0.05em;"
      >
        <span class="relative inline-block whitespace-nowrap">
          {/*
            Both faces ship stacked and cross-faded: fetching the second on first
            hover would land it after the pointer had gone. `active` carries the
            swap to touch, where there is no hover.
          */}
          <span
            data-hero-face
            data-hero-depth="20"
            class="group absolute left-[4.475em] -top-[0.375em] block w-[0.70em]"
          >
            <span
              class="block rotate-[8deg] transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-rotate-[5deg] group-hover:scale-105 group-active:-rotate-[5deg] group-active:scale-105 motion-reduce:transition-none"
            >
              <img
                src="/img/hero/face.webp"
                width={420}
                height={400}
                alt="Dhruv Belekar, drawn in blue line art"
                fetchpriority="high"
                class="w-full transition-opacity duration-300 ease-out group-hover:opacity-0 group-active:opacity-0"
              />
              <img
                src="/img/hero/face-tongue.webp"
                width={420}
                height={400}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 w-full opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100 group-active:opacity-100"
              />
            </span>
          </span>
          dhruv belekar
        </span>
      </h1>
      <p
        data-hero-copy
        data-hero-depth="14"
        class="mx-auto w-full font-bold leading-tight text-gray-400"
        style="font-family: var(--font-display); font-size: clamp(1.125rem, var(--shell) * 0.028, 40px); text-indent: 42%; margin-top: clamp(1rem, var(--shell) * 0.048, 70px); max-width: var(--name-width);"
      >
        I design <span class="text-blue">digital experiences</span>,{" "}
        create <span class="text-blue">visual stories</span>,{" "}
        and bring ideas to life through <span class="text-blue">design and film</span>.{" "}
        I&nbsp;also have a&nbsp;slight obsession with the color <span class="text-blue">blue</span>. You'll notice.
      </p>
    </div>

    <ClientLogos class="-mx-6 mb-6" />
  </section>

  <!-- Projects -->
  <section
    id="projects"
    class="scroll-mt-24 px-6 pt-[var(--space-section)] md:px-10 sm:scroll-mt-28"
    data-projects-section
  >
    <div class="mx-auto max-w-[1400px]">
      <ScrollReveal>
        <h2
          class="select-none text-center font-black leading-[0.9] text-blue"
          style="font-family: var(--font-display); font-size: var(--type-section);"
        >
          Projects
        </h2>
      </ScrollReveal>

      <div class="mt-12 pb-24">
        {
          projects.map((p, i) => (
            <div data-project-category={p.filterCategory}>
              <ScrollReveal delay={0.05} y={40}>
                <ProjectRow
                  slug={p.slug}
                  title={p.title}
                  category={p.category}
                  image={p.thumb}
                  alt={p.thumbAlt}
                  description={p.description}
                  timeline={p.timeline}
                  index={i}
                  promo={p.promo}
                  cycle={p.thumbCycle}
                />
              </ScrollReveal>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ProjectFilterNav
    categories={filterCategories}
    itemSelector="[data-project-category]"
    sectionSelector="[data-projects-section]"
  />

  <!-- About preview -->
  <section class="px-6 pt-[var(--space-section)] md:px-10">
    <div class="mx-auto max-w-[1400px]">
      <ScrollReveal>
        <h2
          class="select-none text-center font-black leading-[0.9] text-blue"
          style="font-family: var(--font-display); font-size: var(--type-section);"
        >
          About Dhruv
        </h2>
      </ScrollReveal>

      <div class="mt-12 grid grid-cols-1 items-start gap-6 sm:grid-cols-[280px_1fr] sm:gap-10 md:grid-cols-[360px_1fr]">
        <ScrollReveal>
          <div class="group w-full focus:outline-none" tabindex="0">
            <div class="relative aspect-square w-full overflow-hidden rounded-2xl group-focus-visible:ring-2 group-focus-visible:ring-blue">
              <img
                src="/img/about/portrait-illustration.webp"
                alt="Illustrated portrait of Dhruv"
                class="absolute inset-0 h-full w-full object-cover transition-opacity duration-150 ease-out group-hover:opacity-0 group-focus-within:opacity-0"
              />
              <img
                src="/img/about/portrait-illustration-tongue.webp"
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-150 ease-out group-hover:opacity-100 group-focus-within:opacity-100"
              />
            </div>
            <p class="mt-3 text-center text-sm font-bold text-blue transition-opacity duration-200 ease-out group-hover:opacity-0 group-focus-within:opacity-0">
              <span class="sm:hidden">Tap me</span>
              <span class="hidden sm:inline">Hover over me</span>
            </p>
          </div>
        </ScrollReveal>

        {/*
          No ScrollReveal around the bio: the words lighting up one by one is
          the reveal, and fading the whole block in underneath it just made the
          same copy fade twice.
        */}
        <MagicText class="min-w-0">
          <BioCopy />
        </MagicText>
      </div>

    </div>
  </section>

  {/*
    The skills used to stream past in two tickers, which meant none of them
    could be read for longer than a second and none of them could be shown.
    They stand still now, and each one has a picture.
  */}
  <ServicesSection />

  {/*
    Straight after the services, because it answers the question the list of
    them raises: what any of it is actually made with.
  */}
  <TechStackSection />

  {/*
    Full bleed and outside the usual shell: the section pins itself and runs a
    track the width of the window, which a 1400px column with padding would
    crop. The reveal wrapper goes too — the milestones arrive on their own as
    the track brings them in.
  */}
  <ExperienceSection />

  <TestimonialsSection />
</Layout>

<script>
  /*
    The hero follows the pointer. Each layer carries a reach in pixels and the
    ones further forward travel further, so the face clears the name and the
    name clears the line under it, and the hero reads as having depth rather
    than sliding as one sheet. The face sits inside the name, so its reach is
    on top of the name's.

    It writes `translate` rather than `transform`: the intro owns `transform`
    on these same elements while it reveals them, and the face tilts on hover
    from its own, so neither is touched.
  */
  const layers = [...document.querySelectorAll<HTMLElement>("[data-hero-depth]")].map((el) => ({
    el,
    reach: Number(el.dataset.heroDepth) || 0,
  }));

  if (layers.length) {
    const fine = window.matchMedia("(pointer: fine)");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    // The share of the remaining distance covered each 60th of a second. Low
    // enough that the hero drifts after the pointer rather than snapping to it.
    const EASE = 0.08;

    let listening = false;
    let onScreen = true;
    let frame = 0;
    let last = 0;
    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;

    const paint = (now: number) => {
      // Scaled by the time since the last frame, so a 120Hz screen eases at
      // the same pace as a 60Hz one instead of twice as fast.
      const steps = last ? Math.min((now - last) / (1000 / 60), 4) : 1;
      last = now;
      const k = 1 - Math.pow(1 - EASE, steps);
      x += (targetX - x) * k;
      y += (targetY - y) * k;

      // Close enough to land on the target exactly, so the hero comes to rest
      // where it was set rather than a hundredth of a pixel off it.
      const settled = Math.abs(targetX - x) < 0.0005 && Math.abs(targetY - y) < 0.0005;
      if (settled) {
        x = targetX;
        y = targetY;
      }

      for (const { el, reach } of layers) {
        el.style.translate = x || y ? `${(x * reach).toFixed(2)}px ${(y * reach).toFixed(2)}px` : "";
      }

      // Once it has caught up there is nothing to draw until the pointer moves.
      if (settled) {
        frame = 0;
        last = 0;
        return;
      }
      frame = requestAnimationFrame(paint);
    };

    const wake = () => {
      if (!frame && onScreen) frame = requestAnimationFrame(paint);
    };

    // Measured against the whole window rather than the hero, as the reference
    // does: the pointer anywhere on screen is somewhere the hero can lean to.
    const onMove = (e: MouseEvent) => {
      targetX = (e.clientX / window.innerWidth - 0.5) * 2;
      targetY = (e.clientY / window.innerHeight - 0.5) * 2;
      wake();
    };

    // Leaving the window lets the hero settle back to where it was set.
    const onLeave = () => {
      targetX = 0;
      targetY = 0;
      wake();
    };

    // Scrolled past, the hero is not drawn at all.
    const observer = new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (onScreen) wake();
    });

    const start = () => {
      if (listening) return;
      listening = true;
      document.addEventListener("mousemove", onMove, { passive: true });
      document.documentElement.addEventListener("mouseleave", onLeave);
      observer.observe(layers[0].el);
    };

    const stop = () => {
      if (!listening) return;
      listening = false;
      cancelAnimationFrame(frame);
      frame = 0;
      last = 0;
      targetX = targetY = x = y = 0;
      document.removeEventListener("mousemove", onMove);
      document.documentElement.removeEventListener("mouseleave", onLeave);
      observer.disconnect();
      for (const { el } of layers) el.style.translate = "";
    };

    // Touch has no pointer to follow, and reduced motion asked for stillness.
    const sync = () => (fine.matches && !reduced.matches ? start() : stop());
    sync();
    fine.addEventListener("change", sync);
    reduced.addEventListener("change", sync);
  }
</script>
