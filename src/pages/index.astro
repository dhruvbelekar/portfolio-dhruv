---
import Layout from "../layouts/Layout.astro";
import IntroLoader from "../components/IntroLoader.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import LetterReveal from "../components/LetterReveal.astro";
import ProjectRow from "../components/ProjectRow.astro";
import ProjectFilterNav from "../components/ProjectFilterNav.astro";
import HighlightsCarousel from "../components/HighlightsCarousel.astro";
import BioCopy from "../components/BioCopy.astro";
import MagicText from "../components/MagicText.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import SkillsSection from "../components/SkillsSection.astro";
import ClientLogos from "../components/ClientLogos.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import HeroPortal from "../components/HeroPortal";
import { projects, filterCategories } from "../data/projects";

// The landing page leads with these few; the rest wait behind a button.
const highlightSlugs = ["mahavitaran", "drive", "frelo", "mp4", "ai-film"];
const highlights = highlightSlugs.map((slug) => projects.find((p) => p.slug === slug)!);
const moreProjects = projects.filter((p) => !highlightSlugs.includes(p.slug));
---

<Layout>
  <IntroLoader />

  <!--
    Hero. The name is a way in: scrolling takes the camera into one of its
    letters until the screen is all blue, and the introduction is inside.
    The face is written here and handed to the portal, so the intro reaches
    it as it always has; the lines that burn through the blue come in as data.
  -->
  <div data-hero-portal>
    <HeroPortal
      client:load
      intro={[
        "i take ideas from 0 to 1, turning them into things people need.",
        "from designing products to creating visuals, i combine human thinking with AI to make ideas happen.",
        "i also have a slight obsession with the color blue. you'll notice.",
      ]}
    >
      <div slot="front" class="hero-front">
        <h1 class="sr-only">Dhruv Belekar</h1>
        <div class="hero-face-spot">
          {/*
            Both faces ship stacked and cross-faded: fetching the second on first
            hover would land it after the pointer had gone. `active` carries the
            swap to touch, where there is no hover.
          */}
          <span data-hero-face class="group block">
            <span
              class="block rotate-[8deg] transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-rotate-[5deg] group-hover:scale-105 group-active:-rotate-[5deg] group-active:scale-105 motion-reduce:transition-none"
            >
              <img
                src="/img/hero/face.webp"
                width={420}
                height={400}
                alt="Dhruv Belekar, drawn in blue line art"
                fetchpriority="high"
                class="w-full transition-opacity duration-300 ease-out group-hover:opacity-0 group-active:opacity-0"
              />
              <img
                src="/img/hero/face-tongue.webp"
                width={420}
                height={400}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 w-full opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100 group-active:opacity-100"
              />
            </span>
          </span>
        </div>
      </div>
    </HeroPortal>
  </div>

  <section class="overflow-x-hidden px-6 pt-[var(--space-section)]">
    <ClientLogos class="-mx-6 mb-6" />
  </section>

  <!-- Highlights, with the full project list folded away beneath them -->
  <section
    id="projects"
    class="scroll-mt-24 px-6 pt-[var(--space-section)] md:px-10 sm:scroll-mt-28"
  >
    <div class="mx-auto max-w-[1400px]">
      <LetterReveal
        class="select-none text-center font-black leading-[0.9] text-blue"
        style="font-family: var(--font-display); font-size: var(--type-section);"
      >
        Highlights
      </LetterReveal>
      <LetterReveal as="p" by="words" class="mt-4 text-center text-base text-ink-muted">
        A few projects I'm proud of.
      </LetterReveal>

      <ScrollReveal delay={0.05} y={40} class="mt-12">
        <HighlightsCarousel projects={highlights} />
      </ScrollReveal>

      <div class="mt-12 flex justify-center">
        <button
          type="button"
          data-more-projects
          aria-expanded="false"
          aria-controls="all-projects"
          class="group flex items-center gap-2 rounded-full border border-blue/30 px-6 py-3 text-sm font-bold text-blue transition-[background-color,border-color,color] duration-300 ease-out hover:border-blue hover:bg-blue hover:text-white"
        >
          <span data-more-label>View more projects</span>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="h-4 w-4 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-aria-expanded:rotate-180"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>
      </div>

      <div
        id="all-projects"
        hidden
        class="mt-12 scroll-mt-24 pb-24 sm:scroll-mt-28"
        data-projects-section
      >
        {
          moreProjects.map((p, i) => (
            <div data-project-category={p.filterCategory}>
              <ScrollReveal delay={0.05} y={40}>
                <ProjectRow
                  slug={p.slug}
                  title={p.title}
                  category={p.category}
                  image={p.thumb}
                  alt={p.thumbAlt}
                  description={p.description}
                  timeline={p.timeline}
                  index={i}
                  promo={p.promo}
                  cycle={p.thumbCycle}
                />
              </ScrollReveal>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    const button = document.querySelector<HTMLButtonElement>("[data-more-projects]");
    const list = document.getElementById("all-projects");
    const label = button?.querySelector("[data-more-label]");

    button?.addEventListener("click", () => {
      if (!list || !label) return;
      const open = list.hidden;
      list.hidden = !open;
      button.setAttribute("aria-expanded", String(open));
      label.textContent = open ? "Show fewer projects" : "View more projects";
      // The list folding away from under someone halfway down it would drop
      // them somewhere unrelated, so they are brought back to the button.
      if (!open) button.scrollIntoView({ block: "center" });
      // The filter bar decides whether to show itself on scroll; this nudges
      // it to look again now the list has appeared or gone.
      window.dispatchEvent(new Event("scroll"));
    });
  </script>

  <ProjectFilterNav
    categories={filterCategories}
    itemSelector="[data-project-category]"
    sectionSelector="[data-projects-section]"
  />

  {/* Straight after the work, where people actually reach it; at the foot of
      the page, past the experience timeline, hardly anyone did. */}
  <TestimonialsSection />

  {/*
    Straight after the testimonials: where the work was made, a trail drawn
    down the page from one company to the next, before the longer
    introduction.
  */}
  <ExperienceSection />

  <!-- About preview. No top padding: the experience section above already
       ends on a full section gap. A narrow centred column with room either
       side: the portrait, then the bio set quietly beneath it. -->
  <section class="px-6 sm:px-12 md:px-20 lg:px-32">
    <div class="mx-auto max-w-[960px]">
      <LetterReveal
        class="select-none text-center font-black leading-[0.9] text-blue"
        style="font-family: var(--font-display); font-size: var(--type-section);"
      >
        About Dhruv
      </LetterReveal>

      <div class="mt-12 flex flex-col items-center gap-10 text-center">
        <ScrollReveal class="w-[220px] sm:w-[260px]">
          <div class="group w-full focus:outline-none" tabindex="0">
            <div class="relative aspect-square w-full overflow-hidden rounded-2xl group-focus-visible:ring-2 group-focus-visible:ring-blue">
              <img
                src="/img/about/portrait-illustration.webp"
                alt="Illustrated portrait of Dhruv"
                class="absolute inset-0 h-full w-full object-cover transition-opacity duration-150 ease-out group-hover:opacity-0 group-focus-within:opacity-0"
              />
              <img
                src="/img/about/portrait-illustration-tongue.webp"
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-150 ease-out group-hover:opacity-100 group-focus-within:opacity-100"
              />
            </div>
            <p class="mt-3 text-center text-sm font-bold text-blue transition-opacity duration-200 ease-out group-hover:opacity-0 group-focus-within:opacity-0">
              <span class="sm:hidden">Tap me</span>
              <span class="hidden sm:inline">Hover over me</span>
            </p>
          </div>
        </ScrollReveal>

        {/*
          No ScrollReveal around the bio: the words lighting up one by one is
          the reveal, and fading the whole block in underneath it just made the
          same copy fade twice.
        */}
        <MagicText class="w-full max-w-[42rem]">
          <BioCopy quiet />
        </MagicText>
      </div>
    </div>
  </section>

  {/*
    Last before the footer: every skill and tool in one pile, which rains in
    as it comes into view and can be picked up and thrown.
  */}
  <SkillsSection />
</Layout>

<style>
  /*
    The face sits where it did on the old heading: 4.475em along the name,
    its top 1.14em above the baseline, 0.7em wide. The portal draws the name
    centred and publishes where the top and bottom of its letters land, which
    gives both the size of an em and the baseline. The constants are Inter
    Bold's, tracked to -0.05em: the letters stand 0.7393em tall, 0.7275em of
    it above the baseline, and run 5.7095em wide, starting 0.0283em in.
  */
  /*
    The portal's frame is a whole screen tall and pins to the top of it, where
    the sticky nav sits over it. Starting it under the nav, rather than below
    it, keeps the frame in the same place before and after it pins, and lets
    the name be centred on the whole screen. The nav is a 3.5rem logo, 4.5rem
    from `sm`, with 1.25rem above and below.
  */
  @media (prefers-reduced-motion: no-preference) {
    [data-hero-portal] {
      margin-top: -6rem;
    }
    @media (min-width: 640px) {
      [data-hero-portal] {
        margin-top: -7rem;
      }
    }
  }

  .hero-front {
    --em: calc((var(--gp-word-bottom, 60%) - var(--gp-word-top, 40%)) / 0.7393);
    position: absolute;
    inset: 0;
  }
  .hero-face-spot {
    position: absolute;
    left: calc(50cqw + (4.475 - 0.0283 - 5.7095 / 2) * var(--em));
    top: calc(var(--gp-word-top, 40%) + (0.7275 - 1.14) * var(--em));
    width: calc(0.7 * var(--em));
    /* While the name follows the pointer its weight moves the k; the face
       moves with it. */
    translate: var(--face-shift, 0px) 0;
    /* The front layer ignores the pointer; the face still wants its hover. */
    pointer-events: auto;
  }

  /*
    The name that answers the pointer, laid exactly over the portal's own: the
    same face, size, tracking and kerning, on the baseline the portal drew.
    The line's box is centred, so heavier and lighter weights grow evenly
    either side; at Bold its letters sit 0.0323em right of the box's centre,
    which is taken back so the two names coincide.
  */
  :global(.hero-name) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  :global(.hero-name-row) {
    --em: calc((var(--gp-word-bottom, 60%) - var(--gp-word-top, 40%)) / 0.7393);
    position: absolute;
    left: 50%;
    top: calc(var(--gp-word-top, 40%) + (0.7275 - 0.765) * var(--em));
    translate: calc(-50% - 0.0323 * var(--em)) 0;
    font-family: var(--font-display);
    font-size: var(--em);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.05em;
    font-kerning: normal;
    white-space: nowrap;
    color: var(--color-blue);
  }
  /* One name at a time: the live line while it follows the pointer, the
     portal's own once it is back at Bold. */
  :global(.hero-portal:not([data-name-live]) .hero-name) {
    visibility: hidden;
  }
  :global(.hero-portal[data-name-live] [data-gp-field]) {
    visibility: hidden;
  }

  /*
    Inside the blue: the three lines that burn through, one after another.
    The portal's content box drops its padding so the burn can pin the whole
    screen, and the burn draws no background of its own, so the portal's blue
    behind it carries on unbroken from the dive.
  */
  :global(.hero-portal [data-gp-content]) {
    padding: 0;
  }
  :global(.hero-burn) {
    --color-background: transparent;
    --color-foreground: var(--color-paper);
    --color-muted-foreground: rgb(255 255 255 / 0.6);
  }

  /* The portal's own caption, as one quiet line under the name. Picking a
     letter is by pointer or tap on the letters themselves, so the dropdown it
     offers touch screens is not needed. */
  :global(.hero-portal [data-gp-caption]) {
    inset: calc(var(--gp-word-bottom, 60%) + clamp(2rem, 7vh, 4.5rem)) 1.5rem auto;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  :global(.hero-portal [data-gp-hint]),
  :global(.hero-portal [data-gp-touch-picker]) {
    display: none !important;
  }
  /* The link into the section is kept for the keyboard, where it skips the
     dive, and only shows once it has focus. */
  :global(.hero-portal [data-gp-caption]:not(:focus-within)) {
    clip-path: inset(50%);
  }
  :global(.hero-portal [data-gp-enter]) {
    gap: 0.5rem;
    transition: color 0.3s ease;
  }
  :global(.hero-portal [data-gp-enter]:hover) {
    color: var(--color-blue);
  }
</style>
