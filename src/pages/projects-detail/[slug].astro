---
import path from "node:path";
import sharp from "sharp";
import Layout from "../../layouts/Layout.astro";
import ScrollReveal from "../../components/ScrollReveal";
import StatCounter from "../../components/StatCounter";
import Marquee from "../../components/Marquee";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;

const isBento = project.slug === "frelo";
const freloMarqueeReels = Array.from(
  { length: 8 },
  (_, i) => `/video/projects/frelo/marquee/reel-${String(i + 1).padStart(2, "0")}.mp4`
);
const gigsTalksBlurb = {
  label: "Gigs & Talks \u00b7 Presented by Pearl Academy",
  heading: "Navigating opportunities in Design and Creative Domains in the age of AI",
  body: "Frelo's first community chapter event, held on campus at Pearl Academy: an in-person evening built as guidance for freelancers, hosted by Vaishakh Sajeevan with speakers from McCann Worldgroup, Fractal Analytics, Lollypop Design, Traya and AiVANTA.",
  aside:
    "Part panel, part hangout. The night ran on questions from the room rather than a script, which is why the poster puts the speakers in the frame instead of the agenda.",
};
const gigsTalksCards = [
  {
    slug: "lokesh-zope",
    name: "Lokesh Zope",
    role: "Head of Design, Traya",
    note: "Lokesh, I think I have known you for a very long time. That is what I felt when I first gave you a call. So welcoming and willing to give back to the community, that is what real hustle is. I guess that is the Mechanical DNA in us :) Thank you for joining us. We are excited to have you again. Welcome to the Frelo family!",
  },
  {
    slug: "rupak-shah",
    name: "Rupak Shah",
    role: "Co-Founder, AiVANTA",
    note: "From our early customers who believed in us to the speaker for our first community chapter event, Frelo and Aivanta have come a long way, and we are really happy to have you with us on this journey. Thank you, dear Rupak, for joining us. To many more collaborations ahead.",
  },
  {
    slug: "ameet-palkar",
    name: "Ameet Palkar",
    role: "Design Director, Lollypop Design",
    note: "Empathy + willingness to share knowledge + A sense of wittiness = Ameet. I have never seen you say no to Frelo. \u201cYes, I will be happy to do it\u201d is what I have heard from you. The passion with which you teach and share your knowledge with people is really great. Wishing you the best always, and we will be happy to see you at the next one by Frelo.",
  },
  {
    slug: "anil-kumar",
    name: "P. K. Anil Kumar",
    role: "Director \u2013 Creative Excellence, McCann Worldgroup",
    note: "One who makes someone laugh is the one who can make them think. You are the person who epitomizes this line, dear Anil Sir. Thank you so much for joining us today. What I felt most nice was the humbleness in you. We will do more collaborations together ahead. I wish to write this note handwritten later. I realized my handwriting is of a Doctor.",
  },
  {
    slug: "shreya-shah",
    name: "Shreya Shah",
    role: "Design Director, Fractal Analytics",
    note: "Calmness and knowledge can go hand in hand. I learned this from you, Shreya. Thank you so much for joining Frelo at its events. You are already a member of the Frelo family, and I am happy that well experienced people like you are supporting our vision to build a future skilled workforce.",
  },
];
const isMp4 = project.slug === "mp4";
const isAiFilm = project.slug === "ai-film";
const isPassionProject = project.slug === "passion-project";
const isDrive = project.slug === "drive";
// Mp4 is one continuous artboard and Drive is a deck whose pages carry their
// own tinted background: in both, a gap between items shows as a white band,
// so they butt together with a hairline overlap against fractional scaling.
const isSeamless = isMp4 || isDrive;
// Passion Project's cover is a poster and Drive's is a deck slide; both are
// shown whole. Every other cover runs edge to edge, cropped to 16:9.
const coverFitsNatural = isPassionProject || isDrive;
const thumbSize = coverFitsNatural
  ? await sharp(path.join(process.cwd(), "public", project.thumb)).metadata()
  : null;
// A portrait cover run edge to edge would stand thousands of pixels tall, so
// those stay contained and height-capped instead.
const coverIsPortrait = thumbSize ? thumbSize.height > thumbSize.width : false;

// A capped clip stops short of the page edge, so its own left and right edges
// show as hard borders. Masking the outer tenth of each side fades the footage
// into the page instead of ending it on a line.
const sideFade =
  "linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%)";
const sideFadeStyle = `-webkit-mask-image: ${sideFade}; mask-image: ${sideFade};`;
// Galleries that close on a video: the image run is followed by a clip at `index`.
// `hoverSound` unmutes on hover, so it is only for clips that carry audio.
const trailingVideos: Record<
  string,
  { index: number; hoverSound: boolean; maxWidth?: string; fadeEdges?: boolean }
> = {
  "ai-film": { index: 12, hoverSound: true },
  "passion-project": { index: 12, hoverSound: true },
  coke: { index: 7, hoverSound: true },
  // The mockup clip is 1288x962; edge to edge it upscales and towers over the
  // stills around it, so it is capped at its comfortable reading size.
  mahavitaran: {
    index: 14,
    hoverSound: false,
    maxWidth: "mx-auto w-full max-w-[1000px]",
    fadeEdges: true,
  },
};
const trailingVideo = trailingVideos[project.slug];

const gallery = await Promise.all(
  Array.from({ length: project.galleryCount }, (_, i) => i).map(async (i) => {
    if (trailingVideo && i === trailingVideo.index) {
      return {
        type: "video",
        src: `/video/projects/${project.slug}/gallery-${String(i + 1).padStart(2, "0")}.mp4`,
        hoverSound: trailingVideo.hoverSound,
        maxWidth: trailingVideo.maxWidth,
        fadeEdges: trailingVideo.fadeEdges,
      };
    }
    const ext = isAiFilm || isMp4 || isDrive ? "webp" : "png";
    const src = `/img/projects/${project.slug}/gallery-${String(i + 1).padStart(2, "0")}.${ext}`;
    const { width, height } = await sharp(path.join(process.cwd(), "public", src)).metadata();
    return { type: "image", src, width, height };
  })
);
const isDark = isAiFilm;
const sectionBg = isDark ? "bg-black" : "";
const titleColor = "text-blue";
const categoryColor = isDark ? "text-white/50" : "text-ink-muted";
const descriptionColor = isDark ? "text-white/70" : "text-ink-muted";
const labelColor = isDark ? "text-white/50" : "text-ink-muted";
const valueColor = isDark ? "text-white" : "text-ink";
const dividerColor = isDark ? "border-white/10" : "border-black/5";
const nextTitleColor = isDark ? "text-white" : "text-ink";
---

<Layout title={`${project.title} — Dhruv Belekar`}>
  <section class={`${sectionBg} pt-16 pb-[var(--space-section)]`}>
    <ScrollReveal client:load>
      {
        coverIsPortrait ? (
          <div class="mx-auto max-w-[1400px] px-6 md:px-10">
            <img
              src={project.thumb}
              alt={project.thumbAlt}
              width={thumbSize.width}
              height={thumbSize.height}
              class="mx-auto max-h-[80vh] w-auto rounded-3xl object-contain"
            />
          </div>
        ) : coverFitsNatural ? (
          <img
            src={project.thumb}
            alt={project.thumbAlt}
            width={thumbSize.width}
            height={thumbSize.height}
            class="w-full"
          />
        ) : (
          <img
            src={project.thumb}
            alt={project.thumbAlt}
            class="aspect-[16/9] w-full object-cover"
          />
        )
      }
    </ScrollReveal>

    <div class="mx-auto max-w-[1400px] px-6 md:px-10">
      <div class="mt-10 grid gap-10 md:grid-cols-[1fr_auto] md:items-start">
        <ScrollReveal client:load>
          <h1
            class={`font-black leading-none ${titleColor}`}
            style="font-family: var(--font-display); font-size: var(--type-heading); font-size: clamp(2.5rem, 1.5rem + 5vw, 5rem);"
          >
            {project.title}
          </h1>
          <p class={`mt-2 text-sm font-bold tracking-wide ${categoryColor}`}>{project.category}</p>
          <p class={`mt-6 max-w-2xl text-base sm:text-lg ${descriptionColor}`}>{project.description}</p>
        </ScrollReveal>

        <ScrollReveal client:load delay={0.1} className="flex flex-col gap-4 sm:min-w-[220px]">
          {
            project.timeline && (
              <div>
                <p class={`text-xs font-bold tracking-wide ${labelColor}`}>Timeline</p>
                <p class={`text-base font-bold ${valueColor}`}>{project.timeline}</p>
              </div>
            )
          }
          {
            project.live && (
              <span class="w-fit rounded-full bg-blue/10 px-3 py-1 text-xs font-bold text-blue">
                Live Project
              </span>
            )
          }
          {
            project.links.length > 0 && (
              <ul class="space-y-1">
                {project.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-block text-sm font-bold text-blue transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:translate-x-1.5"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </ScrollReveal>
      </div>

      {
        isBento ? (
          <div class="mt-16 pb-[var(--space-section)]">
            <div class="grid items-center gap-10 sm:grid-cols-2 sm:gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,0.85fr)] lg:gap-10">
              <ScrollReveal client:load className="mx-auto w-full max-w-sm">
                <video
                  src="/video/projects/frelo/punit-chawla-reel.mp4"
                  autoplay
                  muted
                  loop
                  playsinline
                  class="aspect-[0.53/1] w-full rounded-2xl object-cover object-right"
                />
                <div class="mt-4 flex items-center justify-center gap-3">
                  <img
                    src="/img/projects/frelo/punit-chawla-avatar.png"
                    alt="Punit Chawla"
                    class="h-11 w-11 rounded-full object-cover"
                  />
                  <div>
                    <p class="text-sm font-bold text-ink">Punit Chawla</p>
                    <p class="text-xs text-ink-muted">@punitchawlaofficial</p>
                  </div>
                </div>
              </ScrollReveal>
              <ScrollReveal client:load delay={0.1} className="mx-auto w-full max-w-sm">
                <div
                  class="group relative overflow-hidden rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-blue"
                  tabindex="0"
                >
                  <img
                    src="/img/projects/frelo/dev-de-poster.webp"
                    width={1200}
                    height={1500}
                    alt="DEV-DE poster: a Development-Design online workshop with Punit Chawla, 8-9 November 2025"
                    loading="lazy"
                    class="w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 group-focus-within:scale-105"
                  />
                  <div class="pointer-events-none absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/95 via-black/75 to-black/10 p-6 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-within:opacity-100">
                    <p class="text-xs font-bold tracking-wide text-blue">DEV-DE &middot; 8-9 Nov 2025</p>
                    <p class="mt-2 text-lg font-black leading-tight text-white">
                      A two-day workshop on where design hands off to development
                    </p>
                    <p class="mt-3 text-sm leading-relaxed text-white/80">
                      Run online for the Frelo freelancer community with Punit Chawla, and Figma
                      Indore as community partner, on the UI/UX decisions that survive the handoff
                      to code.
                    </p>
                    <p class="mt-3 text-sm leading-relaxed text-white/60">
                      The poster puts the title inside an old CRT because this was something you
                      tuned into, not walked into. Monochrome blue, film grain and a "block your
                      calendar" line treat an online workshop like a broadcast slot.
                    </p>
                  </div>
                </div>
                <p class="mt-4 text-center text-xs font-bold tracking-wide text-ink-muted">
                  <span class="sm:hidden">Tap the poster for the story</span>
                  <span class="hidden sm:inline">Hover the poster for the story</span>
                </p>
              </ScrollReveal>
              <ScrollReveal client:load delay={0.15} className="sm:col-span-2 lg:col-span-1">
                <StatCounter client:load target={33} suffix="K+" />
              </ScrollReveal>
            </div>

            <ScrollReveal client:load delay={0.15} className="mt-16">
              <Marquee client:load direction="right" speed={40} gap="1.25rem">
                {
                  freloMarqueeReels.map((src) => (
                    <video
                      src={src}
                      autoplay
                      muted
                      loop
                      playsinline
                      class="h-64 w-auto shrink-0 rounded-xl object-cover sm:h-80"
                    />
                  ))
                }
              </Marquee>
            </ScrollReveal>

            <div class="mt-24">
              <ScrollReveal client:load>
                <div
                  class="group relative overflow-hidden rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-blue"
                  tabindex="0"
                >
                  <img
                    src="/img/projects/frelo/gigs-talks-poster.webp"
                    width={1600}
                    height={900}
                    alt="Gigs & Talks poster: a Frelo event presented by Pearl Academy on navigating opportunities in design and creative domains in the age of AI"
                    loading="lazy"
                    class="w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 group-focus-within:scale-105"
                  />
                  <div class="pointer-events-none absolute inset-0 hidden flex-col justify-end bg-gradient-to-t from-black/95 via-black/70 to-black/20 p-6 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-within:opacity-100 sm:flex sm:p-8 lg:p-10">
                    <p class="text-xs font-bold tracking-wide text-blue">{gigsTalksBlurb.label}</p>
                    <p class="mt-2 max-w-2xl text-lg font-black leading-tight text-white lg:text-2xl">
                      {gigsTalksBlurb.heading}
                    </p>
                    <p class="mt-3 max-w-2xl text-xs leading-relaxed text-white/80 lg:text-sm">
                      {gigsTalksBlurb.body}
                    </p>
                    <p class="mt-2 hidden max-w-2xl text-xs leading-relaxed text-white/60 md:block lg:mt-3 lg:text-sm">
                      {gigsTalksBlurb.aside}
                    </p>
                  </div>
                </div>
                <div class="mt-5 sm:hidden">
                  <p class="text-xs font-bold tracking-wide text-blue">{gigsTalksBlurb.label}</p>
                  <p class="mt-2 text-lg font-black leading-tight text-ink">
                    {gigsTalksBlurb.heading}
                  </p>
                  <p class="mt-3 text-sm leading-relaxed text-ink-muted">{gigsTalksBlurb.body}</p>
                  <p class="mt-3 text-sm leading-relaxed text-ink-muted">{gigsTalksBlurb.aside}</p>
                </div>
              </ScrollReveal>

              <ScrollReveal client:load delay={0.1} className="mt-14 text-center">
                <p class="text-sm font-bold tracking-wide text-ink">
                  Every speaker went home with a superhero card
                </p>
                <p class="mx-auto mt-2 max-w-xl text-sm text-ink-muted">
                  <span class="sm:hidden">Tap a card to flip it over and read the thank-you note on the back.</span>
                  <span class="hidden sm:inline">
                    Hover a card to flip it over and read the thank-you note on the back.
                  </span>
                </p>
              </ScrollReveal>

              <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 lg:gap-5">
                {
                  gigsTalksCards.map((card, i) => (
                    <ScrollReveal client:load delay={Math.min(i, 4) * 0.08}>
                      <div class="group [perspective:1400px] focus:outline-none" tabindex="0">
                        <div class="relative aspect-[760/1079] w-full transition-transform duration-700 ease-out [transform-style:preserve-3d] group-focus-within:[transform:rotateY(180deg)] group-hover:[transform:rotateY(180deg)]">
                          <div class="absolute inset-0 overflow-hidden rounded-2xl [backface-visibility:hidden]">
                            <img
                              src={`/img/projects/frelo/gigs-cards/${card.slug}.webp`}
                              width={760}
                              height={1079}
                              alt={`${card.name} drawn as a superhero on a Frelo thank-you card`}
                              loading="lazy"
                              class="h-full w-full object-cover"
                            />
                            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent p-3 pt-10">
                              <p class="text-xs font-bold leading-tight text-white">{card.name}</p>
                              <p class="mt-0.5 text-[0.65rem] leading-tight text-white/70">
                                {card.role}
                              </p>
                            </div>
                          </div>
                          <div class="absolute inset-0 flex flex-col items-center justify-between rounded-2xl border border-ink/10 bg-white p-4 text-center [backface-visibility:hidden] [transform:rotateY(180deg)]">
                            <img
                              src="/img/projects/frelo/gigs-cards/thank-you-lettering.webp"
                              width={420}
                              height={131}
                              alt="Thank you"
                              loading="lazy"
                              class="w-[60%]"
                            />
                            <p class="text-[clamp(0.58rem,0.42rem+0.36vw,0.78rem)] leading-[1.45] text-ink">
                              {card.note}
                            </p>
                            <img
                              src="/img/projects/frelo/gigs-cards/frelo-logo.webp"
                              width={200}
                              height={79}
                              alt="Frelo"
                              loading="lazy"
                              class="w-[38%]"
                            />
                          </div>
                        </div>
                      </div>
                    </ScrollReveal>
                  ))
                }
              </div>
            </div>
          </div>
        ) : null
      }
    </div>

    {
      !isBento && (
        <div
          class={`mt-16 flex flex-col pb-[var(--space-section)] ${isSeamless ? "gap-0" : "gap-8"}`}
        >
            {
              gallery.map((img, i) => (
                <ScrollReveal client:load delay={Math.min(i, 4) * 0.06}>
                  {
                    img.type === "video" ? (
                      <>
                        <video
                          src={img.src}
                          autoplay
                          muted
                          loop
                          playsinline
                          data-hover-sound={img.hoverSound ? "true" : undefined}
                          class={img.maxWidth ?? "w-full"}
                          style={img.fadeEdges ? sideFadeStyle : undefined}
                        />
                        {isAiFilm && img.hoverSound && (
                          <a
                            href="https://www.instagram.com/p/DEsODJ8B3Vx/?hl=en"
                            target="_blank"
                            rel="noreferrer"
                            class="mt-4 block text-center text-lg font-bold text-blue transition-transform duration-300 ease-out hover:-translate-y-0.5"
                          >
                            Want to watch part two and three?
                          </a>
                        )}
                      </>
                    ) : (
                      <img
                        src={img.src}
                        width={img.width}
                        height={img.height}
                        alt=""
                        loading="lazy"
                        class={`block w-full object-cover ${isSeamless && i > 0 ? "-mt-px" : ""}`}
                      />
                    )
                  }
                </ScrollReveal>
            ))
          }
        </div>
      )
    }

    <div class="mx-auto max-w-[1400px] px-6 md:px-10">
      <ScrollReveal client:load className={`border-t ${dividerColor} py-16`}>
        <a href={`/projects-detail/${next.slug}`} class="group ml-auto flex w-fit flex-col items-end gap-4 sm:flex-row sm:items-center sm:gap-10">
          <div class="text-right">
            <p class={`text-xs font-bold tracking-wide ${labelColor}`}>Next project</p>
            <h2
              class={`font-black transition-colors group-hover:text-blue ${nextTitleColor}`}
              style="font-family: var(--font-display); font-size: var(--type-heading);"
            >
              {next.title}
            </h2>
          </div>
          <div class="aspect-[4/5] w-48 shrink-0 overflow-hidden rounded-xl sm:w-80">
            <img
              src={next.thumb}
              alt={next.thumbAlt}
              class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            />
          </div>
          <span class="hidden shrink-0 text-3xl text-blue opacity-0 transition-opacity group-hover:opacity-100 sm:inline">
            →
          </span>
        </a>
      </ScrollReveal>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLVideoElement>('video[data-hover-sound="true"]').forEach((video) => {
    video.addEventListener("mouseenter", () => {
      video.muted = false;
    });
    video.addEventListener("mouseleave", () => {
      video.muted = true;
    });
  });
</script>
