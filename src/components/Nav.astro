---
import Clock from "./Clock";

const links = [
  { href: "/projects", label: "PROJECTS" },
  { href: "/side-quest", label: "SIDE QUEST" },
  { href: "/about", label: "ABOUT" },
  { href: "/contact", label: "CONTACT" },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-[1400px] items-center justify-between gap-2 px-4 py-5 sm:gap-4 sm:px-6 md:px-10">
    <a href="/" aria-label="Home" class="shrink-0 text-blue">
      <img src="/icons/logo-mark.png" alt="" class="h-5 w-auto sm:h-6" />
    </a>
    <ul class="flex flex-nowrap items-center gap-x-2 whitespace-nowrap text-[10px] font-bold tracking-wide text-blue sm:gap-x-6 sm:text-sm">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="transition-colors hover:text-ink">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="hidden sm:block">
      <Clock client:load />
    </div>
  </nav>
</header>
