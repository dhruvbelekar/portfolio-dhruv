---
import Clock from "./Clock";

const links = [
  { href: "/#projects", label: "PROJECTS" },
  { href: "/about", label: "ABOUT" },
  { href: "/contact", label: "CONTACT" },
  { href: "/dhruv-belekar-resume.pdf", label: "RESUME", external: true },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-sm">
  <nav class="mx-auto grid max-w-[1400px] grid-cols-[1fr_auto_1fr] items-center gap-2 px-4 py-5 sm:gap-4 sm:px-6 md:px-10">
    <a href="/" aria-label="Home" class="shrink-0 justify-self-start text-blue">
      <img
        src="/icons/logo-mark.png"
        alt=""
        class="h-14 w-14 rounded-lg transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-rotate-6 hover:scale-105 active:scale-95 sm:h-18 sm:w-18"
      />
    </a>
    <ul class="flex flex-nowrap items-center justify-self-center gap-x-2 whitespace-nowrap text-[10px] font-bold tracking-wide text-blue sm:gap-x-6 sm:text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="group relative block py-3 transition-colors duration-300 hover:text-ink"
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer" : undefined}
            >
              {link.label}
              <span
                aria-hidden="true"
                class="absolute inset-x-0 bottom-1.5 h-[2px] origin-left scale-x-0 rounded-full bg-current transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-x-100"
              />
            </a>
          </li>
        ))
      }
    </ul>
    <div class="hidden justify-self-end sm:block">
      <Clock client:load />
    </div>
  </nav>
</header>
