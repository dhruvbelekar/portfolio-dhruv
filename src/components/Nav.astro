---
import Clock from "./Clock";

const links = [
  { href: "/projects", label: "PROJECTS" },
  { href: "/about", label: "ABOUT" },
  { href: "/contact", label: "CONTACT" },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-sm">
  <nav class="mx-auto grid max-w-[1400px] grid-cols-[1fr_auto_1fr] items-center gap-2 px-4 py-5 sm:gap-4 sm:px-6 md:px-10">
    <a href="/" aria-label="Home" class="shrink-0 justify-self-start text-blue">
      <img src="/icons/logo-mark.png" alt="" class="h-8 w-8 rounded-lg sm:h-9 sm:w-9" />
    </a>
    <ul class="flex flex-nowrap items-center justify-self-center gap-x-2 whitespace-nowrap text-[10px] font-bold tracking-wide text-blue sm:gap-x-6 sm:text-sm">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="transition-colors hover:text-ink">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="hidden justify-self-end sm:block">
      <Clock client:load />
    </div>
  </nav>
</header>
