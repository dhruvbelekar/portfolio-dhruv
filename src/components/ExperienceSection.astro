---
import { experience } from "../data/projects";

/*
  Oldest first. The rest of the site lists the roles newest first, which is
  right for a CV, but a timeline read left to right has to start where the
  work started.
*/
const milestones = [...experience].reverse();
---

<section class="exp" data-exp>
  <div class="exp-stage" data-exp-stage>
    <div class="exp-track" data-exp-track>
      <header class="exp-panel">
        <p class="exp-eyebrow">(Experience)</p>
        {/*
          Two headings, one of which is always hidden. The sideways line is only
          true where the track actually runs; a phone gets the list, so it gets
          the plain word instead of copy describing something it is not doing.
        */}
        <h3 class="exp-title">
          <span class="exp-title-plain">Experience</span>
          <span class="exp-title-run">Three roles,<br />one sideways scroll.</span>
        </h3>
        <p class="exp-lede">
          Keep scrolling — the section holds still and the years move past instead.
        </p>
      </header>

      <ol class="exp-items">
        {/* The rail lives inside the row so it can stretch the whole run of
            milestones, and the fill is driven from the same progress that
            moves the track. */}
        <span class="exp-rail" data-exp-rail aria-hidden="true">
          <span class="exp-rail-fill" data-exp-fill />
        </span>

        {
          milestones.map((e, i) => (
            <li class:list={["exp-item", i % 2 === 0 ? "is-above" : "is-below"]} data-exp-item>
              <span class="exp-dot" aria-hidden="true" />
              <span class="exp-stem" aria-hidden="true" />
              <article class="exp-card">
                <img
                  class="exp-logo"
                  src={e.logo}
                  alt={e.company}
                  loading="lazy"
                  decoding="async"
                />
                <p class="exp-dates">{e.dates}</p>
                <p class="exp-role">{e.role}</p>
              </article>
            </li>
          ))
        }
      </ol>

      <footer class="exp-panel exp-close">
        <p class="exp-lede">From a first design internship to leading the work.</p>
      </footer>
    </div>
  </div>
</section>

<style>
  /*
    The list below is the real section: it is what ships in the markup, what a
    phone gets, what reduced motion gets and what anyone without JS gets. The
    pinned horizontal run is added on top by script, and every rule for it is
    scoped under `.is-pinned` so none of it can strand the content.
  */
  .exp {
    padding: 0 1.5rem var(--space-section);
  }

  .exp-track {
    margin: 0 auto;
    max-width: 42rem;
  }

  .exp-panel {
    text-align: center;
  }

  .exp-eyebrow {
    color: var(--color-gray, #8a8a8a);
    font-size: 0.95rem;
  }

  .exp-title {
    margin-top: 0.5rem;
    color: var(--color-blue);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.25rem + 2.5vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .exp-title-run,
  .exp-lede {
    display: none;
  }

  .exp-lede {
    margin: 0.75rem auto 0;
    max-width: 32rem;
    color: var(--color-gray, #8a8a8a);
  }

  .exp-items {
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .exp-item {
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
  }
  .exp-item:first-of-type {
    border-top: 1px solid rgb(0 0 0 / 0.08);
  }

  .exp-rail,
  .exp-dot,
  .exp-stem {
    display: none;
  }

  .exp-card {
    display: grid;
    align-items: center;
    gap: 0.5rem;
    padding: 1.5rem 1rem;
    text-align: center;
  }

  .exp-logo {
    height: 1.75rem;
    width: auto;
    max-width: 100%;
    margin: 0 auto;
    object-fit: contain;
  }

  .exp-dates {
    color: var(--color-gray, #8a8a8a);
    font-size: 0.9rem;
  }

  .exp-role {
    color: var(--color-ink);
    font-weight: 700;
  }

  .exp-close {
    margin-top: 2.5rem;
  }

  @media (min-width: 640px) {
    .exp-card {
      grid-template-columns: 1fr 1fr 1fr;
      text-align: left;
    }
    .exp-logo {
      margin: 0;
    }
  }

  /* ---- pinned horizontal run, switched on by script ---- */

  .exp.is-pinned {
    padding: 0;
  }

  .exp.is-pinned .exp-stage {
    position: sticky;
    top: 0;
    display: flex;
    height: 100vh;
    align-items: center;
    overflow: hidden;
  }

  .exp.is-pinned .exp-track {
    display: flex;
    max-width: none;
    align-items: center;
    margin: 0;
    will-change: transform;
  }

  .exp.is-pinned .exp-panel {
    flex: 0 0 auto;
    width: min(88vw, 38rem);
    padding: 0 clamp(2rem, 6vw, 6rem);
    text-align: left;
  }
  .exp.is-pinned .exp-title-plain {
    display: none;
  }
  .exp.is-pinned .exp-title-run {
    display: inline;
  }
  .exp.is-pinned .exp-lede {
    display: block;
    margin-left: 0;
  }
  .exp.is-pinned .exp-close {
    margin-top: 0;
  }

  .exp.is-pinned .exp-items {
    position: relative;
    display: flex;
    height: 60vh;
    align-items: center;
    margin: 0;
    padding-right: clamp(2rem, 6vw, 6rem);
    /* A run-up before the first dot, so the rail is already travelling by the
       time a milestone reaches the middle of the window. */
    padding-left: clamp(3rem, 8vw, 9rem);
  }

  .exp.is-pinned .exp-rail {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    display: block;
    height: 1px;
    background: rgb(0 0 0 / 0.1);
  }

  .exp-rail-fill {
    display: block;
    height: 100%;
    background: var(--color-blue);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .exp.is-pinned .exp-item {
    position: relative;
    flex: 0 0 auto;
    /*
      Wide on purpose. Narrow columns fit all three milestones on screen at
      once, which leaves nothing to arrive — at this width about two and a half
      are in view and each one travels in on its own.
    */
    width: clamp(17rem, 38vw, 32rem);
    height: 100%;
    border: 0;
  }

  .exp.is-pinned .exp-dot {
    position: absolute;
    top: 50%;
    left: 0;
    display: block;
    height: 0.625rem;
    width: 0.625rem;
    margin: -0.3125rem 0 0 -0.3125rem;
    border-radius: 999px;
    background: var(--color-blue);
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity 0.35s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Drawn rather than faded, so each milestone reaches up to its own card. */
  .exp.is-pinned .exp-stem {
    position: absolute;
    left: 0;
    display: block;
    width: 1px;
    height: 3.25rem;
    background: rgb(0 0 0 / 0.18);
    transform: scaleY(0);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.06s;
  }
  .exp.is-pinned .is-above .exp-stem {
    bottom: 50%;
    transform-origin: bottom center;
  }
  .exp.is-pinned .is-below .exp-stem {
    top: 50%;
    transform-origin: top center;
  }

  .exp.is-pinned .exp-card {
    position: absolute;
    left: 0;
    width: min(calc(100% - 2rem), 22rem);
    display: block;
    padding: 0;
    text-align: left;
    opacity: 0;
    transition:
      opacity 0.5s ease 0.12s,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.12s;
  }
  .exp.is-pinned .is-above .exp-card {
    bottom: calc(50% + 3.25rem);
    transform: translateY(0.75rem);
  }
  .exp.is-pinned .is-below .exp-card {
    top: calc(50% + 3.25rem);
    transform: translateY(-0.75rem);
  }

  /*
    The logo is the milestone's headline — these are all wordmarks, so setting
    the company name beside it would only say the same thing twice.
  */
  .exp.is-pinned .exp-logo {
    height: 2.25rem;
    margin: 0 0 1rem;
  }

  .exp.is-pinned .exp-dates {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .exp.is-pinned .exp-role {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .exp.is-pinned .exp-item.is-in .exp-dot {
    opacity: 1;
    transform: scale(1);
  }
  .exp.is-pinned .exp-item.is-in .exp-stem {
    transform: scaleY(1);
  }
  .exp.is-pinned .exp-item.is-in .exp-card {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-exp]");
  const stage = document.querySelector<HTMLElement>("[data-exp-stage]");
  const track = document.querySelector<HTMLElement>("[data-exp-track]");
  const fill = document.querySelector<HTMLElement>("[data-exp-fill]");
  const rail = document.querySelector<HTMLElement>("[data-exp-rail]");
  const items = [...document.querySelectorAll<HTMLElement>("[data-exp-item]")];

  if (section && stage && track && fill && rail && items.length) {
    // Pinning takes the section out of the normal flow of the page for as long
    // as it is on screen, which is a lot to do to a phone for a list of three
    // jobs — and on touch it fights the scroll it is riding on.
    const wide = window.matchMedia("(min-width: 768px)");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    let distance = 0;
    let frame = 0;
    let io: IntersectionObserver | null = null;
    let ro: ResizeObserver | null = null;

    const paint = () => {
      frame = 0;
      if (distance <= 0) return;
      const travel = section.offsetHeight - window.innerHeight;
      if (travel <= 0) return;
      const progress = Math.min(1, Math.max(0, -section.getBoundingClientRect().top / travel));
      track.style.transform = `translate3d(${-progress * distance}px, 0, 0)`;

      /*
        The rail is drawn to the edge of the window, not to the fraction of the
        run that has been scrolled. Scaling it by progress alone measures it
        against the whole track — most of which is off to the left — so the
        drawn end trails a long way behind the milestone being read.
      */
      const railBox = rail.getBoundingClientRect();
      const drawn = Math.min(Math.max(stage.getBoundingClientRect().right - railBox.left, 0), railBox.width);
      fill.style.transform = `scaleX(${railBox.width ? drawn / railBox.width : 0})`;
    };

    const request = () => {
      if (!frame) frame = requestAnimationFrame(paint);
    };

    /*
      The page has to grow by exactly as much as the track has left to travel,
      so the sideways run finishes precisely as the section lets go — any less
      and it is still moving when it unpins, any more and it sits there stuck.
    */
    /*
      Giving the section its height makes the page taller, which can bring the
      scrollbar in, which narrows the stage and changes the answer. So this
      settles rather than measures once: it re-runs on any size change and does
      nothing when the number has not moved, which stops it chasing itself.
    */
    const measure = () => {
      const next = track.scrollWidth - stage.clientWidth;
      if (next === distance) return;
      distance = next;
      if (distance <= 0) {
        section.style.height = "";
        track.style.transform = "";
        return;
      }
      section.style.height = `${distance + window.innerHeight}px`;
      paint();
    };

    const enable = () => {
      section.classList.add("is-pinned");
      measure();
      if (!io) {
        // Rooted on the stage, so a milestone is "in" when it has travelled
        // into the window rather than when the page scrolled past it.
        io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) entry.target.classList.add("is-in");
            });
          },
          { root: stage, rootMargin: "0px -22% 0px -8%" }
        );
        items.forEach((item) => io!.observe(item));
      }
      if (!ro) {
        ro = new ResizeObserver(() => measure());
        ro.observe(track);
        ro.observe(stage);
      }
    };

    const disable = () => {
      section.classList.remove("is-pinned");
      section.style.height = "";
      track.style.transform = "";
      fill.style.transform = "";
      distance = 0;
      io?.disconnect();
      io = null;
      ro?.disconnect();
      ro = null;
      items.forEach((item) => item.classList.remove("is-in"));
    };

    const sync = () => (wide.matches && !reduced.matches ? enable() : disable());

    sync();
    wide.addEventListener("change", sync);
    reduced.addEventListener("change", sync);
    window.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", () => {
      if (section.classList.contains("is-pinned")) measure();
      request();
    });
    // Logos arriving late change how wide the track is.
    window.addEventListener("load", () => {
      if (section.classList.contains("is-pinned")) measure();
    });
  }
</script>
