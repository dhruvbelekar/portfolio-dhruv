---
import { experience } from "../data/projects";

/*
  Oldest first. The data is stored newest first, which is right for a CV, but
  a timeline read left to right has to start where the work started.
*/
const milestones = [...experience].reverse();
---

<section class="exp" data-exp>
  <div class="exp-stage" data-exp-stage>
    <div class="exp-track" data-exp-track>
      <header class="exp-panel">
        {/* Two words, two spans: the run wants them stacked, the list wants
            them on one line with the space between them still there. */}
        <h3 class="exp-title"><span>My</span> <span>Experience</span></h3>
      </header>

      {/*
        The rail spans the whole track rather than just the run of roles, so it
        is already crossing the window when the section takes hold instead of
        appearing out of nowhere beside the title.
      */}
      <span class="exp-rail" data-exp-rail aria-hidden="true">
        <span class="exp-rail-fill" data-exp-fill />
      </span>

      <ol class="exp-items">
        {
          milestones.map((e, i) => (
            <li class:list={["exp-item", i % 2 === 0 ? "is-above" : "is-below"]} data-exp-item>
              <span class="exp-dot" aria-hidden="true" />
              <span class="exp-stem" aria-hidden="true" />
              <article class="exp-card">
                <img
                  class="exp-logo"
                  src={e.logo}
                  alt={e.company}
                  loading="lazy"
                  decoding="async"
                />
                <p class="exp-dates">{e.dates}</p>
                <p class="exp-role">
                  {e.promotedFrom && (
                    <>
                      <span class="exp-prev">{e.promotedFrom}</span>
                      <span class="exp-arrow" aria-hidden="true">
                        →
                      </span>
                      <span class="exp-sr">promoted to</span>
                    </>
                  )}
                  {e.role}
                </p>
                <p class="exp-meta">{e.meta}</p>
                <ul class="exp-points">
                  {e.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </article>
            </li>
          ))
        }

        {/* Somewhere for the last role to travel to, so it is read in the
            middle of the window rather than pinned against its right edge. */}
        <li class="exp-tail" aria-hidden="true" />
      </ol>
    </div>
  </div>
</section>

<style>
  /*
    The list below is the real section: it is what ships in the markup, what a
    phone gets, what reduced motion gets and what anyone without JS gets. The
    pinned sideways run is added on top by script, and every rule for it is
    scoped under `.is-pinned` so none of it can strand the content.
  */
  .exp {
    padding: 0 1.5rem var(--space-section);
  }

  .exp-track {
    margin: 0 auto;
    max-width: 44rem;
  }

  .exp-title {
    color: var(--color-blue);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    text-align: center;
  }

  .exp-items {
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .exp-item {
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
    padding: 1.75rem 0;
  }
  .exp-item:first-of-type {
    border-top: 1px solid rgb(0 0 0 / 0.08);
  }

  .exp-rail,
  .exp-dot,
  .exp-stem,
  .exp-tail {
    display: none;
  }

  .exp-logo {
    height: 1.75rem;
    width: auto;
    max-width: 10rem;
    object-fit: contain;
    object-position: left center;
  }

  .exp-dates {
    margin-top: 0.85rem;
    color: var(--color-blue);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .exp-role {
    margin-top: 0.3rem;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .exp-prev {
    color: var(--color-ink-muted);
    font-weight: 400;
  }

  .exp-arrow {
    margin: 0 0.4em;
    color: var(--color-blue);
  }

  /* The arrow carries the meaning visually; this carries it to a reader. */
  .exp-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .exp-meta {
    margin-top: 0.15rem;
    color: var(--color-ink-muted);
    font-size: 0.85rem;
  }

  .exp-points {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    /*
      Not --color-gray: that token is #b3b3b3, a hairline tone for timestamps,
      and it left this copy too faint to read. --color-ink-muted is the one the
      rest of the site uses for secondary text people actually read.
    */
    color: var(--color-ink-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .exp-points li {
    position: relative;
    padding-left: 0.9rem;
  }
  .exp-points li + li {
    margin-top: 0.3rem;
  }
  .exp-points li::before {
    position: absolute;
    left: 0;
    content: "—";
  }

  /* ---- pinned sideways run, switched on by script ---- */

  .exp.is-pinned {
    padding: 0;
  }

  .exp.is-pinned .exp-stage {
    position: sticky;
    top: 0;
    display: flex;
    height: 100vh;
    align-items: center;
    overflow: hidden;
    /*
      The rail sits in the middle of whatever is left below the header. Centred
      on the whole window instead, the tallest card above the line runs up
      behind the nav and loses its logo to it.
    */
    padding-top: clamp(4.5rem, 7vw, 7rem);
  }

  .exp.is-pinned .exp-track {
    position: relative;
    display: flex;
    max-width: none;
    align-items: center;
    margin: 0;
    will-change: transform;
  }

  .exp.is-pinned .exp-panel {
    flex: 0 0 auto;
    width: min(70vw, 26rem);
    padding: 0 clamp(2rem, 6vw, 6rem);
  }

  .exp.is-pinned .exp-title {
    text-align: left;
  }
  .exp.is-pinned .exp-title span {
    display: block;
  }

  .exp.is-pinned .exp-items {
    position: relative;
    display: flex;
    height: 74vh;
    align-items: center;
    margin: 0;
    /* A run-up before the first dot, so the rail is already travelling by the
       time a role reaches the middle of the window. */
    padding-left: clamp(3rem, 8vw, 9rem);
  }

  .exp.is-pinned .exp-rail {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    display: block;
    height: 1px;
    background: rgb(0 0 0 / 0.12);
  }

  .exp-rail-fill {
    display: block;
    height: 100%;
    background: var(--color-blue);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .exp.is-pinned .exp-item {
    position: relative;
    /*
      Wide on purpose. Narrow columns fit the whole run on screen at once,
      which leaves nothing to arrive.
    */
    width: clamp(19rem, 34vw, 30rem);
    height: 100%;
    flex: 0 0 auto;
    border: 0;
    padding: 0;
  }

  .exp.is-pinned .exp-tail {
    display: block;
    width: 40vw;
    flex: 0 0 auto;
  }

  .exp.is-pinned .exp-dot {
    position: absolute;
    top: 50%;
    left: 0;
    display: block;
    height: 0.625rem;
    width: 0.625rem;
    margin: -0.3125rem 0 0 -0.3125rem;
    border-radius: 999px;
    background: var(--color-blue);
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity 0.35s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Drawn rather than faded, so each role reaches up to its own card. */
  .exp.is-pinned .exp-stem {
    position: absolute;
    left: 0;
    display: block;
    width: 1px;
    height: 2.75rem;
    background: rgb(0 0 0 / 0.18);
    transform: scaleY(0);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.06s;
  }
  .exp.is-pinned .is-above .exp-stem {
    bottom: 50%;
    transform-origin: bottom center;
  }
  .exp.is-pinned .is-below .exp-stem {
    top: 50%;
    transform-origin: top center;
  }

  .exp.is-pinned .exp-card {
    position: absolute;
    left: 0;
    width: min(calc(100% - 2rem), 24rem);
    opacity: 0;
    transition:
      opacity 0.5s ease 0.12s,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.12s;
  }
  .exp.is-pinned .is-above .exp-card {
    bottom: calc(50% + 2.75rem);
    transform: translateY(0.75rem);
  }
  .exp.is-pinned .is-below .exp-card {
    top: calc(50% + 2.75rem);
    transform: translateY(-0.75rem);
  }

  .exp.is-pinned .exp-logo {
    height: 2rem;
  }

  .exp.is-pinned .exp-item.is-in .exp-dot {
    opacity: 1;
    transform: scale(1);
  }
  .exp.is-pinned .exp-item.is-in .exp-stem {
    transform: scaleY(1);
  }
  .exp.is-pinned .exp-item.is-in .exp-card {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-exp]");
  const stage = document.querySelector<HTMLElement>("[data-exp-stage]");
  const track = document.querySelector<HTMLElement>("[data-exp-track]");
  const fill = document.querySelector<HTMLElement>("[data-exp-fill]");
  const rail = document.querySelector<HTMLElement>("[data-exp-rail]");
  const items = [...document.querySelectorAll<HTMLElement>("[data-exp-item]")];

  if (section && stage && track && fill && rail && items.length) {
    // Pinning takes the section out of the flow of the page for as long as it
    // is on screen, which is a lot to do to a phone for a list of jobs — and on
    // touch it fights the scroll it is riding on.
    const wide = window.matchMedia("(min-width: 768px)");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    let distance = 0;
    let frame = 0;
    let io: IntersectionObserver | null = null;
    let ro: ResizeObserver | null = null;

    const paint = () => {
      frame = 0;
      if (distance <= 0) return;
      const travel = section.offsetHeight - window.innerHeight;
      if (travel <= 0) return;
      const progress = Math.min(1, Math.max(0, -section.getBoundingClientRect().top / travel));
      track.style.transform = `translate3d(${-progress * distance}px, 0, 0)`;

      /*
        The rail is drawn to the edge of the window, not to the fraction of the
        run that has been scrolled. Scaling it by progress alone measures it
        against the whole track — most of which is off to the left — so the
        drawn end trails a long way behind the role being read.
      */
      const railBox = rail.getBoundingClientRect();
      const stageBox = stage.getBoundingClientRect();
      /*
        Drawn to a little past the middle of the window rather than to its right
        edge: the rail now runs the length of the track, so filling it to the
        edge would leave every visible inch of it already blue and nothing left
        to draw. This keeps the drawn end near whatever is being read.
      */
      const readingLine = stageBox.left + stageBox.width * 0.55;
      const drawn = Math.min(Math.max(readingLine - railBox.left, 0), railBox.width);
      fill.style.transform = `scaleX(${railBox.width ? drawn / railBox.width : 0})`;
    };

    const request = () => {
      if (!frame) frame = requestAnimationFrame(paint);
    };

    /*
      The page has to grow by exactly what the track has left to travel, so the
      run finishes as the section lets go — any less and it is still moving when
      it unpins, any more and it sits there stuck.

      Giving the section that height also makes the page taller, which can bring
      the scrollbar in, which narrows the stage and changes the answer. So this
      settles rather than measures once: it re-runs on any size change and does
      nothing when the number has not moved, which stops it chasing itself.
    */
    const measure = () => {
      const next = track.scrollWidth - stage.clientWidth;
      if (next === distance) return;
      distance = next;
      if (distance <= 0) {
        section.style.height = "";
        track.style.transform = "";
        return;
      }
      section.style.height = `${distance + window.innerHeight}px`;
      paint();
    };

    const enable = () => {
      section.classList.add("is-pinned");
      measure();
      if (!io) {
        // Rooted on the stage, so a role is "in" once it has travelled into the
        // window rather than when the page scrolled past it.
        io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) entry.target.classList.add("is-in");
            });
          },
          { root: stage, rootMargin: "0px -22% 0px -8%" }
        );
        items.forEach((item) => io!.observe(item));
      }
      if (!ro) {
        ro = new ResizeObserver(() => measure());
        ro.observe(track);
        ro.observe(stage);
      }
    };

    const disable = () => {
      section.classList.remove("is-pinned");
      section.style.height = "";
      track.style.transform = "";
      fill.style.transform = "";
      distance = 0;
      io?.disconnect();
      io = null;
      ro?.disconnect();
      ro = null;
      items.forEach((item) => item.classList.remove("is-in"));
    };

    const sync = () => (wide.matches && !reduced.matches ? enable() : disable());

    sync();
    wide.addEventListener("change", sync);
    reduced.addEventListener("change", sync);
    window.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", () => {
      if (section.classList.contains("is-pinned")) measure();
      request();
    });
    // Logos arriving late change how wide the track is.
    window.addEventListener("load", () => {
      if (section.classList.contains("is-pinned")) measure();
    });
  }
</script>
