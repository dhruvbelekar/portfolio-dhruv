---
import { experience } from "../data/projects";
---

<div class="pb-[var(--space-section)]">
  <h3
    class="text-center text-3xl font-black text-blue sm:text-4xl"
    style="font-family: var(--font-display);"
  >
    Experience
  </h3>

  <ul class="mx-auto mt-10 max-w-2xl">
    {
      experience.map((e) => (
        <li class="group border-b border-ink/10 first:border-t">
          <div class="grid grid-cols-1 items-center gap-2 px-4 py-6 text-center sm:grid-cols-3 sm:gap-4 sm:py-7">
            {/* Three equal columns keep the logos, roles and dates on their own
                vertical lines while the block stays centred under the heading.
                The logo stands in for the company name, so alt carries it. */}
            <span class="flex h-7 items-center justify-center">
              <img
                src={e.logo}
                alt={e.company}
                loading="lazy"
                decoding="async"
                class="h-6 w-auto max-w-full object-contain transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105 sm:h-7"
              />
            </span>

            <p class="text-base font-bold text-ink transition-colors duration-300 group-hover:text-blue sm:text-lg">
              {e.role}
            </p>

            <p class="text-sm text-ink-muted sm:text-base">{e.dates}</p>
          </div>
        </li>
      ))
    }
  </ul>
</div>
