---
import LetterReveal from "./LetterReveal.astro";
import ExperienceTrail from "./ExperienceTrail";
import { experience } from "../data/projects";

/*
  Oldest first. The data is stored newest first, which is right for a CV, but
  a story told by scrolling has to start where the work started: the trail
  sets off at Lit Lamps and arrives at Frelo.
*/
const roles = [...experience].reverse().map((r) => ({
  company: r.company,
  role: r.role,
  promotedFrom: "promotedFrom" in r ? r.promotedFrom : undefined,
  promotion: "promotion" in r ? r.promotion : undefined,
  meta: r.meta,
  dates: r.dates,
  logo: r.logo,
  points: r.points,
}));
---

<section class="px-6 pt-[var(--space-section)] md:px-10">
  <div class="mx-auto max-w-[1400px]">
    <LetterReveal
      class="select-none text-center font-black leading-[0.9] text-blue"
      style="font-family: var(--font-display); font-size: var(--type-section);"
    >
      My Experience
    </LetterReveal>
  </div>
</section>

<div class="trail-shell">
  <ExperienceTrail client:load roles={roles} />
</div>

<style is:global>
  /*
    The section is as tall as the trail, which the script sets once it has
    fitted the line to the width; each company is then placed where the line
    swings out to a side. Before that, and with no JS, they are just listed.
  */
  .trail-shell {
    padding: 0 1.5rem var(--space-section);
  }
  .trail {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
  }
  .trail:not([data-placed]) {
    display: grid;
    gap: 4rem;
    padding-top: 3rem;
  }
  .trail-line {
    position: absolute;
    inset: 0;
    overflow: visible;
    pointer-events: none;
  }

  /* The line runs behind the companies, never through their text: each one
     has the page's own white behind it, so the stroke simply passes under. */
  .trail-card {
    position: relative;
    z-index: 1;
    max-width: 34rem;
    padding: 1.5rem;
    background: var(--color-paper);
  }
  .trail[data-placed] .trail-card {
    position: absolute;
    max-width: none;
  }

  /* A large, quiet index above the company: which of the three this is,
     readable from across the room. */
  .trail-num {
    display: block;
    color: rgb(19 67 240 / 0.14);
    font-family: var(--font-display);
    font-size: clamp(3rem, 1.5rem + 5vw, 7.5rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 0.8;
    font-variant-numeric: tabular-nums;
  }
  .trail-company {
    margin-top: clamp(1rem, 2.5vh, 1.75rem);
  }
  .trail-logo {
    display: block;
    height: clamp(2.5rem, 1.3rem + 3vw, 4.5rem);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }
  .trail-dates {
    margin-top: clamp(0.9rem, 2.2vh, 1.4rem);
    color: var(--color-blue);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .trail-title {
    margin-top: 0.75rem;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1rem + 1.2vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .trail-prev {
    color: var(--color-ink-muted);
    font-weight: 400;
  }
  .trail-arrow {
    margin: 0 0.4em;
    color: var(--color-blue);
  }
  .trail-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.6rem;
    color: var(--color-ink-muted);
    font-size: 0.9rem;
  }
  .trail-promotion {
    color: var(--color-ink);
  }
  .trail-points {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--color-ink);
    font-size: clamp(1rem, 0.85rem + 0.4vw, 1.2rem);
    line-height: 1.5;
  }
  .trail-points li {
    position: relative;
    padding: 0.9rem 0 0.9rem 1.75rem;
    border-top: 1px solid rgb(0 0 0 / 0.08);
  }
  .trail-points li::before {
    position: absolute;
    top: 1.6em;
    left: 0.15rem;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-blue);
    content: "";
    transform: translateY(-50%);
  }
  /* The number that says what the work came to. */
  .trail-points strong {
    color: var(--color-blue);
    font-weight: 700;
  }

  .trail-card [data-trail-item] {
    will-change: opacity, transform;
  }

  @media (max-width: 767px) {
    .trail-card {
      padding: 1.25rem 0.25rem;
    }
  }
</style>
