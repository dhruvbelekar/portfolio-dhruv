---
import { experience } from "../data/projects";
---

<div class="pb-[var(--space-section)] text-center">
  <h3 class="text-2xl font-black text-blue" style="font-family: var(--font-display);">
    Experience
  </h3>

  <ul class="mx-auto mt-10 max-w-md space-y-6 text-left">
    {
      experience.map((e) => (
        <li>
          <p class="text-ink-muted">{e.role}</p>
          <p class="font-bold text-ink">
            <span class="text-blue">{e.company}</span> - {e.dates}
          </p>
        </li>
      ))
    }
  </ul>

  <a
    href="https://drive.google.com/drive/folders/1e92a3IZ8tz1NUu0pfwsmL1pdgHECwokr"
    target="_blank"
    rel="noreferrer"
    class="mt-12 inline-block text-2xl font-black text-blue transition-opacity hover:opacity-70"
    style="font-family: var(--font-display);"
  >
    Resume
  </a>
</div>
