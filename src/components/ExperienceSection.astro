---
import ScrollReveal from "./ScrollReveal.astro";
import { experience } from "../data/projects";

/*
  Oldest first. The data is stored newest first, which is right for a CV, but
  a story told by scrolling has to start where the work started.

  One company at a time: the frame pins while the page scrolls past it, and
  each stretch of scroll hands the whole stage to the next role. Laid out side
  by side, all three were on screen at once and none of them was the one being
  read.
*/
const roles = [...experience].reverse();

// "**100+ members**" in the data becomes a highlighted run of text here.
const split = (point: string) =>
  point.split(/\*\*(.+?)\*\*/).map((text, i) => ({ text, strong: i % 2 === 1 }));

const pad = (n: number) => String(n).padStart(2, "0");
---

<section class="px-6 pt-[var(--space-section)] md:px-10">
  <div class="mx-auto max-w-[1400px]">
    <ScrollReveal>
      <h2
        class="select-none text-center font-black leading-[0.9] text-blue"
        style="font-family: var(--font-display); font-size: var(--type-section);"
      >
        My Experience
      </h2>
    </ScrollReveal>
  </div>
</section>

<section class="xp" data-xp style={`--xp-count: ${roles.length}`}>
  <div class="xp-frame">
    <div class="xp-inner">
      {/* Where you are in the run: one bar per company, filling as its
          stretch of scroll is read. Hidden in the stacked list. */}
      <div class="xp-steps" role="tablist" aria-label="Experience">
        {
          roles.map((r, i) => (
            <button
              type="button"
              role="tab"
              class="xp-step"
              data-xp-step={i}
              aria-selected={i === 0 ? "true" : "false"}
            >
              <span class="xp-step-label">
                <span class="xp-step-year">{r.year}</span>
                {r.company}
              </span>
              <span class="xp-step-bar" aria-hidden="true">
                <span class="xp-step-fill" data-xp-fill />
              </span>
            </button>
          ))
        }
      </div>

      <div class="xp-stage">
        {
          roles.map((r, i) => (
            <ScrollReveal class="xp-slot">
              <article class="xp-role" data-xp-role={i} data-state={i === 0 ? "now" : "next"}>
                <div class="xp-head" data-xp-head>
                  <span class="xp-num" aria-hidden="true">
                    {pad(i + 1)}
                  </span>
                  {/* The logo is the name: set out again in type beside it, the
                      company read twice. */}
                  <h3 class="xp-company">
                    <img
                      class="xp-logo"
                      src={r.logo}
                      alt={r.company}
                      loading="lazy"
                      decoding="async"
                    />
                  </h3>
                  <p class="xp-dates">{r.dates}</p>
                </div>

                <div class="xp-body">
                  <p class="xp-title" data-xp-line>
                    {r.promotedFrom && (
                      <>
                        <span class="xp-prev">{r.promotedFrom}</span>
                        <span class="xp-arrow" aria-hidden="true">
                          →
                        </span>
                        <span class="xp-sr">promoted to</span>
                      </>
                    )}
                    {r.role}
                  </p>
                  <p class="xp-meta" data-xp-line>
                    {r.meta}
                    {r.promotion && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span class="xp-promotion">{r.promotion}</span>
                      </>
                    )}
                  </p>
                  <ul class="xp-points">
                    {r.points.map((point) => (
                      <li data-xp-line>
                        {split(point).map((part) =>
                          part.strong ? <strong>{part.text}</strong> : part.text
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            </ScrollReveal>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /*
    The stacked list is the real section: it is what ships in the markup, what
    a phone or a short window gets, what reduced motion gets and what anyone
    without JS gets. The pinned stage is added on top by script, and every rule
    for it is scoped under `.is-live` so none of it can strand the content.
  */
  .xp {
    padding: clamp(2rem, 5vw, 4rem) 1.5rem var(--space-section);
  }

  .xp-inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .xp-steps {
    display: none;
  }

  .xp-stage {
    display: grid;
    gap: 1rem;
  }

  .xp-role {
    display: grid;
    gap: 1.25rem;
    padding: 1.75rem;
    border-radius: 1.5rem;
    background: rgb(19 67 240 / 0.04);
  }

  .xp-head {
    position: relative;
  }

  /* A large, quiet index behind the company name: which of the three this is,
     readable from across the room. */
  .xp-num {
    display: block;
    color: rgb(19 67 240 / 0.14);
    font-family: var(--font-display);
    font-size: clamp(3rem, 1.5rem + 6.5vw, 9rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 0.8;
    font-variant-numeric: tabular-nums;
  }

  .xp-company {
    margin-top: clamp(1.25rem, 3vh, 2rem);
  }

  .xp-logo {
    display: block;
    height: clamp(2.75rem, 1.4rem + 3.4vw, 5rem);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }

  .xp-dates {
    margin-top: clamp(1rem, 2.5vh, 1.5rem);
    color: var(--color-blue);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .xp-title {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1rem + 1.3vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .xp-prev {
    color: var(--color-ink-muted);
    font-weight: 400;
  }

  .xp-arrow {
    margin: 0 0.4em;
    color: var(--color-blue);
  }

  /* The arrow carries the meaning visually; this carries it to a reader. */
  .xp-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .xp-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.6rem;
    color: var(--color-ink-muted);
    font-size: 0.9rem;
  }

  /* Said plainly, in the same line as the rest of the details; the arrow in
     the title above already makes the point. */
  .xp-promotion {
    color: var(--color-ink);
  }

  .xp-points {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--color-ink);
    font-size: clamp(1rem, 0.85rem + 0.55vw, 1.35rem);
    line-height: 1.5;
  }

  .xp-points li {
    position: relative;
    padding: 1rem 0 1rem 2rem;
    border-top: 1px solid rgb(0 0 0 / 0.08);
  }
  .xp-points li::before {
    position: absolute;
    top: 1.65em;
    left: 0.15rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-blue);
    content: "";
    transform: translateY(-50%);
  }

  /* The number that says what the work came to. */
  .xp-points strong {
    color: var(--color-blue);
    font-weight: 700;
  }

  /* ---- pinned stage, switched on by script ---- */

  .xp.is-live {
    position: relative;
    height: calc(100svh + (var(--xp-count) - 1) * 110svh);
    padding: 0;
  }

  .xp.is-live .xp-frame {
    position: sticky;
    top: 0;
    display: flex;
    height: 100svh;
    align-items: center;
    padding: clamp(5.5rem, 12vh, 7.5rem) clamp(1.5rem, 4vw, 3rem) clamp(1.5rem, 4vh, 2.5rem);
  }

  .xp.is-live .xp-inner {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: clamp(1.5rem, 5vh, 3.5rem);
  }

  /* Along the foot of the frame, clear of the nav, like the progress of a
     story you are partway through. */
  .xp.is-live .xp-steps {
    order: 2;
    display: grid;
    grid-template-columns: repeat(var(--xp-count), 1fr);
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .xp-step {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--color-ink-muted);
    font-size: 0.9rem;
    font-weight: 700;
    text-align: left;
    opacity: 0.6;
    transition:
      color 0.4s ease,
      opacity 0.4s ease;
  }
  .xp-step:hover {
    opacity: 0.85;
  }
  .xp-step[aria-selected="true"] {
    color: var(--color-blue);
    opacity: 1;
  }
  .xp-step:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 6px;
    border-radius: 2px;
  }
  .xp-step-year {
    margin-right: 0.6em;
    font-variant-numeric: tabular-nums;
    font-weight: 400;
  }
  .xp-step-bar {
    display: block;
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(0 0 0 / 0.1);
  }
  .xp-step-fill {
    display: block;
    height: 100%;
    background: var(--color-blue);
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* Every role sits in the same cell, so changing between them moves nothing
     around it. */
  .xp.is-live .xp-stage {
    flex: 1;
    min-height: 0;
    gap: 0;
    align-items: center;
  }
  /* The slot is ScrollReveal's own element, so it carries that component's
     scope rather than this one's. */
  .xp.is-live .xp-stage > :global(.xp-slot) {
    grid-area: 1 / 1;
    /* Moved by the script in step with the scroll; the reveal's own fade
       would only lag behind it. */
    opacity: 1;
    transform: none;
    transition: none;
  }

  .xp.is-live .xp-role {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding: 0;
    background: none;
    will-change: opacity, transform, filter;
  }
  .xp.is-live .xp-role[data-state="next"],
  .xp.is-live .xp-role[data-state="past"] {
    pointer-events: none;
  }

  .xp.is-live .xp-points li,
  .xp.is-live .xp-title,
  .xp.is-live .xp-meta {
    will-change: opacity, transform;
  }

  /* A laptop window: the same stage, a size down, so the longest role still
     fits between the nav and the bottom of the screen. */
  @media (max-height: 820px) {
    .xp.is-live .xp-num {
      font-size: clamp(3rem, 1.5rem + 4.5vw, 6.5rem);
    }
    .xp.is-live .xp-logo {
      height: clamp(2.5rem, 1.2rem + 2.6vw, 4rem);
    }
    .xp.is-live .xp-points {
      margin-top: 1rem;
      font-size: 1.05rem;
    }
    .xp.is-live .xp-points li {
      padding: 0.75rem 0 0.75rem 2rem;
    }
  }
</style>

<script>
  // Of each role's stretch of scroll, the share either side of its middle it
  // holds still for, and the share it spends arriving or leaving.
  const HOLD = 0.28;
  const FADE = 0.22;
  // How far a role travels as it arrives or leaves, in pixels.
  const LIFT = 64;
  // The most blur a role carries, reached as it fades out completely.
  const BLUR = 10;
  // Where in a role's stretch its lines start and finish coming in. Each line
  // takes `LINE` of the stretch, and they are spread evenly between the two.
  const LINES_FROM = 0.06;
  const LINES_TO = 0.62;
  const LINE = 0.16;
  // The share of the remaining distance covered each frame, so the steps of a
  // mouse wheel become one glide.
  const EASE = 0.14;

  const clamp = (v: number) => Math.min(Math.max(v, 0), 1);
  const smooth = (t: number) => t * t * (3 - 2 * t);

  document.querySelectorAll<HTMLElement>("[data-xp]").forEach((section) => {
    const roles = [...section.querySelectorAll<HTMLElement>("[data-xp-role]")];
    const steps = [...section.querySelectorAll<HTMLButtonElement>("[data-xp-step]")];
    const fills = [...section.querySelectorAll<HTMLElement>("[data-xp-fill]")];
    const lines = roles.map((r) => [...r.querySelectorAll<HTMLElement>("[data-xp-line]")]);
    const heads = roles.map((r) => r.querySelector<HTMLElement>("[data-xp-head]"));
    const count = roles.length;

    // A pinned stage needs a screen wide and tall enough to hold the longest
    // role. Anything smaller keeps the stacked list, which scrolls on its own.
    const room = window.matchMedia("(min-width: 768px) and (min-height: 600px)");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let live = false;
    let active = -1;
    let frame = 0;

    // How far through its pinned stretch the section is, in roles: 0 at the
    // start, `count` at the end.
    const target = () => {
      const rect = section.getBoundingClientRect();
      const travel = rect.height - window.innerHeight;
      const progress = travel > 0 ? clamp(-rect.top / travel) : 0;
      return progress * count;
    };
    let current = 0;

    const mark = (index: number) => {
      if (index === active) return;
      active = index;
      roles.forEach((r, i) => {
        r.dataset.state = i === index ? "now" : i < index ? "past" : "next";
        r.setAttribute("aria-hidden", i === index ? "false" : "true");
      });
      steps.forEach((s, i) => s.setAttribute("aria-selected", i === index ? "true" : "false"));
    };

    const paint = (pos: number) => {
      roles.forEach((role, i) => {
        const local = pos - i;
        // Distance from this role's middle, in roles. The first has nothing to
        // arrive after and the last nothing to leave for, so they hold at the
        // ends instead.
        let d = local - 0.5;
        if (i === 0 && d < 0) d = 0;
        if (i === count - 1 && d > 0) d = 0;
        const away = smooth(clamp((Math.abs(d) - HOLD) / FADE));
        role.style.opacity = String(1 - away);
        role.style.transform = `translate3d(0, ${-Math.sign(d) * away * LIFT}px, 0)`;
        role.style.filter =
          away > 0.005 && away < 0.995 ? `blur(${(away * BLUR).toFixed(2)}px)` : "";

        // The company lands with the role; what was done there is revealed a
        // line at a time as the scroll carries on, so it is read in order. A
        // role that has been read keeps its lines while it leaves.
        const head = heads[i];
        const arrive = i === 0 ? 1 : smooth(clamp(local / (0.5 - HOLD)));
        if (head) head.style.transform = `translate3d(${(1 - arrive) * -40}px, 0, 0)`;

        const own = lines[i];
        const span = own.length > 1 ? (LINES_TO - LINE - LINES_FROM) / (own.length - 1) : 0;
        own.forEach((line, j) => {
          const start = LINES_FROM + j * span;
          const t = local >= 1 ? 1 : smooth(clamp((local - start) / LINE));
          line.style.opacity = String(t);
          line.style.transform = `translate3d(0, ${(1 - t) * 28}px, 0)`;
        });

        if (fills[i]) fills[i].style.transform = `scaleX(${clamp(local)})`;
      });
      mark(Math.min(Math.floor(pos), count - 1));
    };

    const tick = () => {
      frame = 0;
      if (!live) return;
      const goal = target();
      current += (goal - current) * EASE;
      if (Math.abs(goal - current) < 0.001) current = goal;
      paint(current);
      if (current !== goal) frame = requestAnimationFrame(tick);
    };
    const wake = () => {
      if (!live || frame) return;
      frame = requestAnimationFrame(tick);
    };

    const clear = (el: HTMLElement | null) => {
      if (!el) return;
      el.style.opacity = "";
      el.style.transform = "";
      el.style.filter = "";
    };

    const sync = () => {
      const next = room.matches && !reduced.matches;
      if (next === live) return;
      live = next;
      section.classList.toggle("is-live", live);
      if (live) {
        active = -1;
        current = target();
        paint(current);
      } else {
        roles.forEach((r) => {
          clear(r);
          r.removeAttribute("aria-hidden");
          r.dataset.state = "now";
        });
        heads.forEach(clear);
        lines.flat().forEach(clear);
        fills.forEach(clear);
      }
    };

    // Picking a company scrolls to the point where all of its lines are in,
    // so the page and the role on screen never disagree.
    steps.forEach((step, i) =>
      step.addEventListener("click", () => {
        const travel = section.offsetHeight - window.innerHeight;
        const top = section.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({ top: top + ((i + 0.66) / count) * travel, behavior: "smooth" });
      })
    );

    sync();
    room.addEventListener("change", sync);
    reduced.addEventListener("change", sync);
    window.addEventListener("scroll", wake, { passive: true });
    window.addEventListener("resize", wake);
  });
</script>
