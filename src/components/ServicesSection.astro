---
import { services } from "../data/projects";

/*
  Split at build time into words, and words into letters, each carrying its
  place in the line. Every letter is its own little window holding the grey
  face and the ink face stacked, and the stagger is what makes the swap sweep
  across the word instead of flipping all at once.

  Words stay whole so the line can still wrap between them rather than
  mid-word.
*/
const lettered = services.map((service) => {
  let i = 0;
  return {
    ...service,
    words: service.name.split(" ").map((word) => [...word].map((ch) => ({ ch, i: i++ }))),
  };
});
---

<section class="svc" data-svc>
  <div class="svc-inner">
    <p class="svc-eyebrow">(Services)</p>

    <div class="svc-body">
      <ul class="svc-list">
        {
          lettered.map((service, i) => (
            <li class:list={["svc-row", i === 0 && "is-active"]} data-svc-row data-index={i}>
              {/*
                A button, not a div with a mouse listener: this is the control
                that changes the panel, so it can be tabbed to and it answers
                a keyboard the same way it answers a pointer.
              */}
              {/* The letters are scenery; the button says what it is. */}
              <button
                class="svc-trigger"
                type="button"
                aria-controls="svc-preview"
                aria-label={service.name}
              >
                <span class="svc-num" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="svc-name" aria-hidden="true">
                  {service.words.map((word, w) => (
                    <>
                      <span class="svc-word">
                        {word.map(({ ch, i: pos }) => (
                          <span class="svc-char" style={`--i:${pos}`}>
                            <span class="svc-roll">
                              <span class="svc-face">{ch}</span>
                              <span class="svc-face svc-face--on">{ch}</span>
                            </span>
                          </span>
                        ))}
                      </span>
                      {w < service.words.length - 1 ? " " : ""}
                    </>
                  ))}
                </span>
                <span class="svc-arrow" aria-hidden="true">
                  →
                </span>
              </button>

              {/* Touch has no hover, so on a phone each service simply carries
                  its own picture instead of pointing at a shared one. */}
              <div class="svc-inline">
                <img src={service.image} alt="" loading="lazy" decoding="async" />
              </div>
            </li>
          ))
        }
      </ul>

      <div class="svc-preview" id="svc-preview" data-svc-preview aria-hidden="true">
        {
          lettered.map((service, i) => (
            <figure class:list={["svc-figure", i === 0 && "is-active"]} data-svc-figure data-index={i}>
              <img src={service.image} alt="" loading="lazy" decoding="async" />
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .svc {
    padding: var(--space-section) 1.5rem;
  }

  .svc-inner {
    margin: 0 auto;
    max-width: 1400px;
  }

  .svc-eyebrow {
    color: var(--color-ink-muted);
    font-size: 0.95rem;
  }

  .svc-list {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .svc-row {
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
  }
  .svc-row:first-child {
    border-top: 1px solid rgb(0 0 0 / 0.08);
  }

  .svc-trigger {
    display: grid;
    width: 100%;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0;
    background: none;
    border: 0;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }

  .svc-num {
    color: var(--color-ink-muted);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .svc-name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1rem + 3.4vw, 4rem);
    font-size: clamp(1.5rem, min(1rem + 3.2vw, 5vh), 3.75rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-transform: uppercase;
    /*
      Full strength here. Greying the list only makes sense where one of them
      can be singled out by a pointer; on a phone it would just be seven
      headings nobody can read.
    */
    color: var(--color-ink);
  }

  .svc-word {
    display: inline-block;
    white-space: nowrap;
  }

  /*
    Each letter is a window one line tall with two faces stacked inside it.
    The height has to be stated: without it the box simply grows to hold both
    faces and there is nothing for the overflow to clip, which shows the ink
    copy sitting under the grey one instead of hiding it.
  */
  .svc-char {
    display: inline-block;
    height: 1.05em;
    height: 1lh;
    overflow: hidden;
    vertical-align: top;
  }

  .svc-roll {
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    /* The beat per letter. Small enough to read as one gesture sweeping
       across the word rather than as letters taking turns. */
    transition-delay: calc(var(--i) * 18ms);
  }

  .svc-face {
    display: block;
  }

  .svc-arrow {
    color: var(--color-blue);
    font-size: 1.25rem;
    opacity: 0;
    transform: translateX(-0.5rem);
    transition:
      opacity 0.35s ease,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .svc-inline {
    padding-bottom: 1.25rem;
  }

  .svc-inline img,
  .svc-figure img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 1rem;
    object-fit: cover;
  }

  .svc-inline img {
    aspect-ratio: 4 / 3;
  }

  .svc-preview {
    display: none;
  }

  @media (min-width: 768px) {
    /*
      Sized off the height of the window, not just its width. Seven services at
      a width-driven size ran past the bottom of the screen, so the last one had
      to be scrolled to — and a list whose whole point is to be scanned is no
      use if it cannot be seen at once. The top padding clears the header.
    */
    .svc {
      display: flex;
      min-height: 100svh;
      flex-direction: column;
      justify-content: center;
      padding: clamp(7rem, 14vh, 9rem) 1.5rem clamp(3rem, 7vh, 5rem);
    }

    .svc-body {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: clamp(2rem, 5vw, 5rem);
    }

    .svc-list {
      margin-top: 0;
    }

    .svc-inline {
      display: none;
    }

    .svc-trigger {
      padding: clamp(0.5rem, 1.7vh, 1.4rem) 0;
    }

    .svc-preview {
      /*
        The stacked figures measure themselves against this box, so it has to
        be the one they are positioned in. It used to be `sticky`, which did
        that as a side effect; dropping sticky without saying `relative` sent
        them out to the size of the page.
      */
      position: relative;
      display: block;
      height: clamp(16rem, 58vh, 32rem);
      aspect-ratio: 3 / 4;
      width: auto;
      justify-self: end;
    }

    /* Every picture is stacked in the same frame and cross-faded, so the panel
       never collapses to nothing between two services. */
    .svc-figure {
      position: absolute;
      inset: 0;
      margin: 0;
      opacity: 0;
      transform: scale(1.03);
      transition:
        opacity 0.55s ease,
        transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .svc-figure.is-active {
      opacity: 1;
      transform: none;
    }

    /* Grey until it is the one being looked at — the whole list at full
       strength is what makes a wall of names impossible to scan. */
    .svc-face {
      color: var(--color-gray);
    }

    .svc-face--on {
      color: var(--color-blue);
    }

    /* Half the stack is exactly one face, so the ink one lands where the grey
       one was rather than near it. */
    .svc-row.is-active .svc-roll {
      transform: translateY(-50%);
    }

    .svc-row.is-active .svc-arrow {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-roll,
    .svc-arrow,
    .svc-figure {
      transition-duration: 0.001ms;
    }
    .svc-roll {
      transition-delay: 0ms;
    }
  }
</style>

<script>
  const rows = [...document.querySelectorAll<HTMLElement>("[data-svc-row]")];
  const figures = [...document.querySelectorAll<HTMLElement>("[data-svc-figure]")];

  if (rows.length && figures.length) {
    let active = 0;

    const show = (index: number) => {
      if (index === active) return;
      active = index;
      rows.forEach((row, i) => row.classList.toggle("is-active", i === index));
      figures.forEach((figure, i) => figure.classList.toggle("is-active", i === index));
    };

    rows.forEach((row, i) => {
      // Pointer and keyboard both land here; the last one looked at stays up
      // rather than snapping back, so the panel is never empty.
      row.addEventListener("pointerenter", () => show(i));
      row.addEventListener("focusin", () => show(i));
    });
  }
</script>
