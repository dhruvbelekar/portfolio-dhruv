---
/*
  The .mp4 mark as a solid object.

  The glyph outline is traced from the finished lockup and extruded here rather
  than loaded as a model file. It is eight points and a rectangle, so the
  geometry costs a few hundred bytes of source instead of a megabyte of GLB,
  the bevel stays crisp at any size, and there is no export to keep in sync
  when the mark is redrawn.

  Everything the chrome shows is reflection. Lights do almost nothing to a
  polished metal, so the look comes from a small floating point panorama of
  bright strips on black, generated in the browser. That panorama is what puts
  the streaks across the faces and the blown out lines along every edge.
*/
---

<section data-mp4hero class="relative w-full overflow-hidden bg-black">
  <div data-mp4hero-stage class="relative mx-auto aspect-[16/9] max-h-[86vh] w-full">
    {/*
      The render stands in until the geometry is on screen, so the section is
      never an empty black box, and it is what anyone without WebGL keeps.
    */}
    <img
      data-mp4hero-poster
      src="/img/projects/mp4/hero-chrome.webp"
      alt="The .mp4 Productions mark in polished chrome"
      width="1672"
      height="941"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover transition-opacity duration-[1200ms] ease-out"
    />
    <canvas
      data-mp4hero-canvas
      aria-hidden="true"
      class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-[1200ms] ease-out"
    ></canvas>
  </div>
</section>

<script>
  // A corner carries an optional radius as its third number.
  type Vertex = [number, number] | [number, number, number];

  /*
    Traced from the finished .mp4 productions lockup, y up, in glyph units:
    77 wide by 57 tall. The path walks counterclockwise from the foot of the
    upright, up the hypotenuse of the counter, back down its right wall, out
    along the underside of the stem, up the right edge, left across the top,
    then down the long diagonal.
  */
  const BODY: Vertex[] = [
    [0, 15],
    [18.8, 15],
    // The point of the counter is milled round, not sharp: a 53 degree wedge
    // has nowhere for a bevel to go.
    [56, 43.1, 2.6],
    [56, 15],
    [77, 15],
    [77, 57],
    [41.5, 57],
    [0, 26.5],
  ];

  // In the flat mark the base and the body meet at a single corner. Milled as
  // one solid that corner would be a pinch that no bevel can turn, which is why
  // the render splits the base off as its own piece. VOID is the gap left
  // between the two once both have been beveled outward.
  const VOID = 1.1;
  const BEVEL = 0.7;
  const INSET = VOID + BEVEL * 2;
  const BAR: Vertex[] = [
    [0, 0],
    [56 - INSET, 0],
    [56 - INSET, 15 - INSET],
    [0, 15 - INSET],
  ];

  // The mark is 1 unit tall once normalised; these are the extents of the
  // bounding box after the resting tilt, used to frame it in any plate.
  const FRAME_W = 1.56;
  const FRAME_H = 1.3;
  const REST_Z = -0.2;
  const REST_X = 0.07;
  const REST_Y = -0.22;
  const SWING_X = 0.26;
  const SWING_Y = 0.42;

  const root = document.querySelector<HTMLElement>("[data-mp4hero]");
  const stage = document.querySelector<HTMLElement>("[data-mp4hero-stage]");
  const canvas = document.querySelector<HTMLCanvasElement>("[data-mp4hero-canvas]");
  const poster = document.querySelector<HTMLImageElement>("[data-mp4hero-poster]");

  if (root && stage && canvas && poster) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let started = false;

    const start = async () => {
      if (started) return;
      started = true;

      const THREE = await import("three");
      const { EffectComposer } = await import("three/examples/jsm/postprocessing/EffectComposer.js");
      const { RenderPass } = await import("three/examples/jsm/postprocessing/RenderPass.js");
      const { UnrealBloomPass } = await import("three/examples/jsm/postprocessing/UnrealBloomPass.js");
      const { OutputPass } = await import("three/examples/jsm/postprocessing/OutputPass.js");

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 0.95;

      const scene = new THREE.Scene();
      // Enough lens to let a reflection travel across a face rather than sit on it.
      const camera = new THREE.PerspectiveCamera(38, 16 / 9, 0.1, 100);
      camera.position.set(0, 0, 4);

      /*
        The set: black, with a handful of long narrow softboxes. Values run well
        past 1, which is what lets the chrome blow out to white along an edge
        while the face beside it stays near black. Angles and widths are in
        radians of longitude, so a strip keeps its shape as it wraps.
      */
      const environment = () => {
        const W = 1024;
        const H = 512;
        const data = new Float32Array(W * H * 4);
        /*
          Two kinds of light. The panels are broad and soft: a flat face of the
          mark reflects a different part of one across its whole width, which is
          where the sweep from black to white on each face comes from. The
          strips are narrow and fierce, and it is those the bevels pick up as
          the hot line running around every edge.

          Positions are u across the full turn and v from pole to pole, so a
          longitude covers twice the angle a latitude does.
        */
        const panels = [
          { u: 0.6, v: 0.3, ru: 0.26, rv: 0.2, i: 2.4 },
          { u: 0.28, v: 0.46, ru: 0.18, rv: 0.26, i: 1.3 },
          { u: 0.86, v: 0.62, ru: 0.16, rv: 0.16, i: 0.9 },
          { u: 0.06, v: 0.34, ru: 0.2, rv: 0.18, i: 0.6 },
        ];
        const strips = [
          { u: 0.16, v: 0.4, a: 0.44, l: 0.62, w: 0.02, i: 26 },
          { u: 0.53, v: 0.26, a: -0.3, l: 0.5, w: 0.026, i: 20 },
          { u: 0.79, v: 0.56, a: 1.05, l: 0.44, w: 0.016, i: 30 },
          { u: 0.4, v: 0.75, a: -0.15, l: 0.55, w: 0.02, i: 14 },
        ];
        for (let y = 0; y < H; y++) {
          const v = (y + 0.5) / H;
          for (let x = 0; x < W; x++) {
            const u = (x + 0.5) / W;
            let e = 0.004;
            for (const s of panels) {
              let du = u - s.u;
              if (du > 0.5) du -= 1;
              else if (du < -0.5) du += 1;
              const dx = (du * 2) / s.ru;
              const dy = (v - s.v) / s.rv;
              e += s.i * Math.exp(-(dx * dx + dy * dy) * 1.6);
            }
            for (const s of strips) {
              let du = u - s.u;
              if (du > 0.5) du -= 1;
              else if (du < -0.5) du += 1;
              const dx = du * 2;
              const dy = v - s.v;
              const c = Math.cos(s.a);
              const sn = Math.sin(s.a);
              const px = Math.abs(dx * c + dy * sn) / s.l;
              const py = Math.abs(dy * c - dx * sn) / s.w;
              if (px >= 1 || py >= 1) continue;
              // Soft along the length, tight across it: a strip light, not a blob.
              e += s.i * Math.sqrt(1 - px) * (1 - py) * (1 - py);
            }
            const o = (y * W + x) * 4;
            data[o] = e;
            data[o + 1] = e;
            data[o + 2] = e;
            data[o + 3] = 1;
          }
        }
        const tex = new THREE.DataTexture(data, W, H, THREE.RGBAFormat, THREE.FloatType);
        tex.mapping = THREE.EquirectangularReflectionMapping;
        tex.colorSpace = THREE.LinearSRGBColorSpace;
        // A data texture samples nearest by default, and a mirror magnifies the
        // set enormously: without this the lights arrive as a staircase.
        tex.minFilter = THREE.LinearFilter;
        tex.magFilter = THREE.LinearFilter;
        tex.needsUpdate = true;
        return tex;
      };

      const pmrem = new THREE.PMREMGenerator(renderer);
      const panorama = environment();
      scene.environment = pmrem.fromEquirectangular(panorama).texture;
      panorama.dispose();
      pmrem.dispose();

      const trace = (points: Vertex[]) => {
        const shape = new THREE.Shape();
        const n = points.length;
        const at = (i: number) => points[(i + n) % n];
        // A point back along the edge from `to` toward `from`, where a rounded
        // corner leaves the straight run.
        const back = (from: Vertex, to: Vertex, d: number): [number, number] => {
          const dx = from[0] - to[0];
          const dy = from[1] - to[1];
          const len = Math.hypot(dx, dy) || 1;
          return [to[0] + (dx / len) * d, to[1] + (dy / len) * d];
        };
        let open = false;
        const step = (x: number, y: number) => {
          if (open) shape.lineTo(x, y);
          else shape.moveTo(x, y);
          open = true;
        };
        for (let i = 0; i < n; i++) {
          const p = at(i);
          const r = p[2] ?? 0;
          if (!r) {
            step(p[0], p[1]);
            continue;
          }
          const enter = back(at(i - 1), p, r);
          const leave = back(at(i + 1), p, r);
          step(enter[0], enter[1]);
          shape.quadraticCurveTo(p[0], p[1], leave[0], leave[1]);
        }
        shape.closePath();
        return shape;
      };

      const geometry = new THREE.ExtrudeGeometry([trace(BODY), trace(BAR)], {
        depth: 3,
        bevelEnabled: true,
        bevelThickness: BEVEL,
        bevelSize: BEVEL,
        bevelOffset: 0,
        bevelSegments: 4,
      });
      geometry.center();
      geometry.computeBoundingBox();
      const box = geometry.boundingBox!;
      geometry.scale(
        1 / (box.max.y - box.min.y),
        1 / (box.max.y - box.min.y),
        1 / (box.max.y - box.min.y)
      );

      const material = new THREE.MeshStandardMaterial({
        color: 0xffffff,
        metalness: 1,
        roughness: 0.05,
      });

      const mark = new THREE.Mesh(geometry, material);
      const group = new THREE.Group();
      group.add(mark);
      group.rotation.z = REST_Z;
      scene.add(group);

      const composer = new EffectComposer(renderer);
      composer.addPass(new RenderPass(scene, camera));
      // Only the hottest reflections bloom, so the edges flare and the faces
      // stay clean.
      const bloom = new UnrealBloomPass(new THREE.Vector2(1, 1), 0.0, 0.1, 4);
      composer.addPass(bloom);
      composer.addPass(new OutputPass());

      const fit = () => {
        const w = stage.clientWidth;
        const h = stage.clientHeight;
        if (!w || !h) return;
        renderer.setSize(w, h, false);
        composer.setSize(w, h);
        bloom.setSize(w, h);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        // Fill the same share of the plate whatever shape the plate is.
        const viewH = 2 * camera.position.z * Math.tan((camera.fov * Math.PI) / 360);
        const viewW = viewH * camera.aspect;
        group.scale.setScalar(Math.min(viewH / FRAME_H, viewW / FRAME_W) * 0.82);
      };
      fit();
      new ResizeObserver(fit).observe(stage);

      let targetX = 0;
      let targetY = 0;
      let turnX = REST_X;
      let turnY = REST_Y;
      let pointed = false;

      window.addEventListener(
        "pointermove",
        (e) => {
          // Measured across the window, so the mark answers the pointer
          // anywhere on the page rather than only while it is over the plate.
          targetY = (e.clientX / window.innerWidth) * 2 - 1;
          targetX = (e.clientY / window.innerHeight) * 2 - 1;
          pointed = true;
        },
        { passive: true }
      );

      let frame = 0;
      const paint = (now: number) => {
        if (!pointed) {
          // Nothing is driving it yet, or this is a touch screen: keep it
          // turning slowly so the metal still reads as metal.
          targetY = Math.sin(now / 4200) * 0.7;
          targetX = Math.sin(now / 6100) * 0.45;
        }
        // Eased rather than tracked, so it settles instead of snapping.
        turnY += (REST_Y + targetY * SWING_Y - turnY) * 0.055;
        turnX += (REST_X + targetX * SWING_X - turnX) * 0.055;
        group.rotation.y = turnY;
        group.rotation.x = turnX;
        composer.render();
        frame = requestAnimationFrame(paint);
      };

      const run = () => {
        if (!frame) frame = requestAnimationFrame(paint);
      };
      const halt = () => {
        if (frame) cancelAnimationFrame(frame);
        frame = 0;
      };

      if (reduced.matches) {
        // One frame at rest: the mark is still the hero, it just holds still.
        group.rotation.set(REST_X, REST_Y, REST_Z);
        composer.render();
      } else {
        run();
      }

      canvas.style.opacity = "1";
      poster.style.opacity = "0";

      // A WebGL loop left running under a scrolled past section is the main
      // reason a page like this feels heavy.
      new IntersectionObserver((entries) => {
        if (reduced.matches) return;
        entries.forEach((entry) => (entry.isIntersecting ? run() : halt()));
      }).observe(stage);
      document.addEventListener("visibilitychange", () => {
        if (reduced.matches) return;
        document.hidden ? halt() : run();
      });
    };

    // three.js is only worth downloading once the hero is in reach.
    const watcher = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          watcher.disconnect();
          start();
        }
      },
      { rootMargin: "300px" }
    );
    watcher.observe(root);
  }
</script>
