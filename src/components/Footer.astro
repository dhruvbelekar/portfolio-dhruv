---
const navigate = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/#projects" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];

// Corrected to match the footer's handles everywhere (per rebuild decision —
// the live site's /contact page pointed at different handles than its own footer).
const social = [
  { label: "Behance", href: "https://www.behance.net/dhruvbelekar1" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/dhruv-belekar-089636214/" },
  { label: "Instagram", href: "https://www.instagram.com/dhruvv.mp4/?hl=en" },
];
---

<footer class="overflow-x-hidden border-t border-black/5 px-6 pb-10 pt-6">
  <div class="mx-auto max-w-[1400px]">
    <a href="mailto:dhruv.belekar@gmail.com" class="group block">
      <h2
        class="select-none text-center font-bold leading-[1.1] text-blue transition-colors duration-500 ease-out group-hover:text-ink"
        style="font-family: var(--font-display); font-size: clamp(3rem, var(--shell) * 0.165, 260px); letter-spacing: -0.05em;"
      >
        Get in touch
      </h2>
    </a>

    <div class="mt-10 flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <div>
        <p class="text-2xl text-gray">Still here?</p>
        <p class="text-2xl text-gray">Let's make something cool.</p>
      </div>
      <div class="text-left sm:text-right">
        <a
          href="mailto:dhruv.belekar@gmail.com"
          class="block w-fit text-2xl text-blue transition-colors duration-500 ease-out hover:text-ink sm:ml-auto"
        >
          Say Hello
        </a>
        <a
          href="mailto:dhruv.belekar@gmail.com"
          class="block w-fit text-2xl text-blue transition-colors duration-500 ease-out hover:text-ink sm:ml-auto"
        >
          dhruv.belekar@gmail.com
        </a>
      </div>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-10 border-t border-black/10 pt-10 sm:grid-cols-[2fr_1.3fr_1.3fr_0.5fr] sm:items-start">
      <p
        class="w-fit select-none font-bold uppercase leading-[0.9] text-blue"
        style="font-family: var(--font-display); font-size: clamp(2.5rem, var(--shell) * 0.055, 80px); letter-spacing: -0.04em;"
      >
        {/*
          DHRUV is two letters shorter than BELEKAR, which leaves a gap at the
          end of the first line; the mascot sits in it. Centred in that gap it
          could not grow past 1em without its chin landing on BELEKAR's A and R,
          so it stands on DHRUV's baseline the way a letter would and grows
          upward instead — it then keeps the same clearance above BELEKAR as the
          two lines keep from each other, at any size. The negative margins stop
          it adding height to the line and the lift puts its chin on the
          baseline. Sized in em so the fit holds at every breakpoint; past about
          1.2em it crowds the divider above on desktop.
        */}
        <span class="flex items-center justify-between gap-[0.08em]">
          Dhruv
          <img
            src="/icons/logo-mark.webp"
            alt=""
            width="256"
            height="256"
            loading="lazy"
            decoding="async"
            class="relative -top-[0.187em] -my-[0.1em] h-[1.1em] w-auto"
          />
        </span>
        Belekar
      </p>

      <div>
        <p class="mb-3 text-base text-gray">(Navigate)</p>
        <ul class="font-bold text-blue" style="font-size: clamp(1.25rem, var(--shell) * 0.025, 36px); letter-spacing: -0.04em;">
          {
            navigate.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-block transition-colors duration-500 ease-out hover:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="mb-3 text-base text-gray">(Social)</p>
        <ul class="font-bold text-blue" style="font-size: clamp(1.25rem, var(--shell) * 0.025, 36px); letter-spacing: -0.04em;">
          {
            social.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-block transition-colors duration-500 ease-out hover:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <a
        href="#top"
        class="group flex items-center gap-2 text-base text-blue transition-colors duration-300 hover:text-ink sm:justify-self-end"
      >
        Back to Top
        <span
          aria-hidden="true"
          class="inline-block transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-1"
        >
          ↑
        </span>
      </a>
    </div>
  </div>
</footer>
