---
import path from "node:path";
import sharp from "sharp";

/*
  The OPE gallery, told rather than listed.

  Nine photographs from one day, each one held beside a few lines about what is
  happening inside it. The plain gallery ran them edge to edge with nothing
  said, which reads as a contact sheet: you scroll past nine frames in four
  seconds and remember none of them.

  Built to the reference: a photograph takes the middle of the screen while its
  writing sits pinned beside it, and the writing rolls up and out of sight as
  the next photograph comes to take its place. Only one story is ever settled
  and readable, so each frame gets looked at for as long as it takes to read
  the lines next to it.

  The writing is about the feeling in the frame rather than the running order
  of the day: what the room was like at that moment, not what was on the
  agenda.
*/

interface Story {
  /* A short line that names the feeling, not the activity. */
  title: string;
  body: string;
  /* What is actually visible, for anyone who cannot see it. */
  alt: string;
}

const stories: Story[] = [
  {
    title: "The first laugh",
    body:
      "At nine in the morning nobody knew anybody. Somewhere before ten, someone said something daft enough to crack the whole table open, and the room stopped being a room full of strangers.",
    alt: "A man in a lanyard laughing mid conversation against a brick wall",
  },
  {
    title: "Heads down",
    body:
      "There is a particular quiet a room goes into when it is working. Not bored quiet. Twenty people leaning over the same table, nobody checking how long is left.",
    alt: "A long table seen from one end, the whole room bent over paper and materials",
  },
  {
    title: "Careful with it",
    body:
      "Card, tape, and about four minutes of work, held like it is made of glass. That is what making something in front of people does. It stops being scrap the second you care whether it stands up.",
    alt: "Two hands holding a small paper prototype, scissors just out of frame",
  },
  {
    title: "Say that again",
    body:
      "One of them is explaining. The other has stopped assembling his reply and is just listening, head tilted, hands empty. Easy to photograph, rare to actually see.",
    alt: "A younger man gesturing mid sentence while an older man listens across the table",
  },
  {
    title: "Permission to play",
    body:
      "Grown adults were handed a box of colour and told to build something. For a few seconds nobody could remember what they did for a living. This is what that looks like on a face.",
    alt: "A woman laughing with her eyes closed, holding a strip of coloured beads",
  },
  {
    title: "Four hands, one thing",
    body:
      "Nobody is looking at anybody's face. They are looking at the joint, the tape, the corner that keeps giving way. You trust someone quickly when you are both holding the same structure up.",
    alt: "Two pairs of hands binding paper straws into a frame with tape",
  },
  {
    title: "Before anyone sees it",
    body:
      "A bicycle, in red, small in the corner of the page. The quiet minute before an idea has to be explained to anybody, while it is still only yours, and still perfect.",
    alt: "A hand sketching a bicycle in red pencil under low warm light",
  },
  {
    title: "Your turn",
    body:
      "Arms folded, weight on one leg, everyone watching one person talk. Nobody here is relaxed. Presenting to a room of designers is its own specific kind of nervous.",
    alt: "A group standing and sitting around a table with pastel balloons, watching someone present",
  },
  {
    title: "The huddle",
    body:
      "One voice, and everybody bent slightly toward it. By the end of the day the circles had stopped being teams and started being people who had built something together.",
    alt: "A cluster of people leaning in to listen to one man speaking, warm evening light",
  },
];

/*
  Measured at build time rather than guessed, so the browser holds the right
  amount of room for each photograph before it has loaded and nothing below it
  jumps when it arrives.
*/
const frames = await Promise.all(
  stories.map(async (story, i) => {
    const src = `/img/projects/ope/gallery-${String(i + 1).padStart(2, "0")}.webp`;
    const { width, height } = await sharp(path.join(process.cwd(), "public", src)).metadata();
    return { ...story, src, width, height, n: String(i + 1).padStart(2, "0") };
  })
);
---

<div class="ps" data-photo-story>
  {
    frames.map((f) => (
      <figure class="ps-row" data-ps-row>
        <div class="ps-frame">
          <img
            src={f.src}
            width={f.width}
            height={f.height}
            alt={f.alt}
            loading="lazy"
            decoding="async"
          />
        </div>

        {/*
          Pinned to the middle of the screen for as long as its photograph owns
          the screen, so the writing holds still to be read while everything
          around it moves.
        */}
        <figcaption class="ps-text">
          {/*
            Every line sits in a box that clips it. The line itself is what
            moves, rising out from behind the edge on the way in and climbing
            out through the top on the way out.
          */}
          <span class="ps-line" style="--i:0" aria-hidden="true"><span class="ps-n">{f.n}</span></span>
          <h3 class="ps-title"><span class="ps-line" style="--i:1"><span>{f.title}</span></span></h3>
          <p class="ps-body"><span class="ps-line" style="--i:2"><span>{f.body}</span></span></p>
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .ps {
    margin-inline: auto;
    max-width: 1400px;
    padding-inline: 1.5rem;
  }

  @media (min-width: 768px) {
    .ps {
      padding-inline: 2.5rem;
    }
  }

  .ps-row {
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }

  /* Stacked on a phone, where there is no room beside anything and no pinning
     that would make sense. */
  .ps-row + .ps-row {
    margin-top: clamp(4rem, 10vw, 7rem);
  }

  .ps-frame {
    overflow: hidden;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--color-ink) 4%, var(--color-paper));
  }

  .ps-frame img {
    display: block;
    width: 100%;
    height: auto;
    will-change: transform;
  }

  .ps-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .ps-line > span {
    display: block;
    will-change: transform;
  }

  .ps-n {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--color-blue) 55%, transparent);
  }

  .ps-title {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 1.1rem + 1.6vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.05em;
    color: var(--color-blue);
  }

  .ps-body {
    margin: 1rem 0 0;
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.125rem);
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--color-ink-muted);
  }

  /*
    Past this width the two sit side by side, each row is given most of the
    screen to itself, and the writing is pinned to the middle of it. Handing a
    row this much height is what gives the photograph the screen on its own,
    the way the reference does, instead of three of them competing at once.
  */
  @media (min-width: 900px) {
    .ps-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
      gap: clamp(2rem, 5vw, 5.5rem);
      align-items: center;
      min-height: 88vh;
    }

    .ps-row + .ps-row {
      margin-top: clamp(3rem, 6vw, 6rem);
    }

    .ps-text {
      position: sticky;
      top: 50vh;
      transform: translateY(-50%);
      max-width: 36ch;
    }
  }

  /*
    Every moving part is held by script rather than by the stylesheet: with no
    JavaScript the rows are simply in place and readable rather than blank.
  */
  [data-photo-story].is-armed .ps-frame {
    clip-path: inset(100% 0 0 0);
    transition: clip-path 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-photo-story].is-armed .ps-row.is-in .ps-frame {
    clip-path: inset(0 0 0 0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-photo-story].is-armed .ps-frame {
      clip-path: none;
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-photo-story]");

  if (root) {
    const rows = [...root.querySelectorAll<HTMLElement>("[data-ps-row]")];
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    const wide = window.matchMedia("(min-width: 900px)");

    if (rows.length && !reduced.matches && "IntersectionObserver" in window) {
      // Armed only once the observer is certain to run, so a browser that never
      // reaches here shows the photographs rather than hiding them.
      root.classList.add("is-armed");

      /* The photograph wipes upward out of nothing, once, on the way in. */
      const arrive = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-in");
            arrive.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -12% 0px", threshold: 0.08 }
      );
      rows.forEach((row) => arrive.observe(row));

      /*
        The rest is tied to the scroll rather than fired once, which is what
        makes the writing swap as its photograph takes and loses the middle of
        the screen.

        `p` is where the row sits: +1 with its middle at the bottom of the
        window, 0 as it passes the centre, -1 at the top. Inside DEAD the
        writing is settled and still, so it holds long enough to be read. Past
        that it rolls the rest of the way out over RAMP, up through the top if
        the row is leaving and back down below if it has not arrived yet.
      */
      const DEAD = 0.34;
      const RAMP = 0.3;
      const TRAVEL = 118;

      const live = new Set<HTMLElement>();
      let frame = 0;

      const paint = () => {
        frame = 0;
        const vh = window.innerHeight;
        const pinned = wide.matches;

        for (const row of live) {
          const r = row.getBoundingClientRect();
          const raw = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2);
          const p = Math.max(-1, Math.min(1, raw));

          let t = 0;
          if (p > DEAD) t = Math.min(1, (p - DEAD) / RAMP);
          else if (p < -DEAD) t = Math.max(-1, (p + DEAD) / RAMP);

          const lines = row.querySelectorAll<HTMLElement>(".ps-line > span");
          lines.forEach((line, i) => {
            // Pinning is a desktop arrangement; stacked on a phone the writing
            // belongs under its photograph and should simply stay there.
            if (!pinned) {
              line.style.transform = "";
              line.style.opacity = "";
              return;
            }
            // A touch more travel for each line down the block, so the three
            // arrive and leave as a run rather than as one slab.
            const shift = t * TRAVEL * (1 + i * 0.07);
            line.style.transform = `translateY(${shift.toFixed(2)}%)`;
            line.style.opacity = String(Math.max(0, 1 - Math.abs(t) * 1.1).toFixed(3));
          });

          // The picture eases back to its own size as its row reaches the
          // middle, so there is still movement in the frame while it is held.
          const img = row.querySelector<HTMLElement>(".ps-frame img");
          if (img) img.style.transform = `scale(${(1 + Math.abs(p) * 0.05).toFixed(4)})`;
        }

        if (live.size) frame = requestAnimationFrame(paint);
      };

      const run = () => {
        if (!frame && live.size) frame = requestAnimationFrame(paint);
      };

      /* Only rows on screen are measured, and the loop stops itself when the
         last one leaves, so an idle page costs nothing. */
      const watch = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) live.add(entry.target as HTMLElement);
            else live.delete(entry.target as HTMLElement);
          }
          run();
        },
        { rootMargin: "25% 0px" }
      );
      rows.forEach((row) => watch.observe(row));

      // Crossing the breakpoint changes whether the writing is pinned at all,
      // so the inline styles from the other arrangement have to be cleared.
      wide.addEventListener("change", run);
    }
  }
</script>
