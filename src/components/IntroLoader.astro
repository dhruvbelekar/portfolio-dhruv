---
---

<div id="intro-loader" class="intro-loader" aria-hidden="true">
  <div class="intro-panel"></div>
  <div class="intro-panel"></div>
  <div class="intro-panel"></div>
  <div class="intro-panel"></div>
  <div class="intro-content">
    <h1 id="intro-text" class="intro-text" lang="en">Hello.</h1>
    {/*
      In the markup from the first paint rather than created when its turn
      comes, so the browser has already fetched and decoded it by the time the
      greetings are done and it never pops in a frame late.
    */}
    <img
      id="intro-logo"
      class="intro-logo"
      src="/icons/logo-mark.webp"
      alt=""
      width="256"
      height="256"
      decoding="async"
    />
  </div>
</div>

<style>
  .intro-loader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .intro-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    width: calc(25% + 2px);
    background: var(--color-paper);
  }
  .intro-panel:nth-child(1) {
    left: 0;
  }
  .intro-panel:nth-child(2) {
    left: calc(25% - 1px);
  }
  .intro-panel:nth-child(3) {
    left: calc(50% - 1px);
  }
  .intro-panel:nth-child(4) {
    left: calc(75% - 1px);
  }

  .intro-content {
    position: relative;
    z-index: 1;
    padding: 0 1.5rem;
    /*
      One cell, and the greeting and the face are both placed in it, so the
      face takes the spot the words were standing in rather than arriving
      underneath them and shifting the whole block up.
    */
    display: grid;
    place-items: center;
    /*
      The exit used to drop this to zero with nothing to ease it, so the
      greeting blinked out a beat before the panels moved. Fading it lets
      whatever is on screen leave under the panels on their way up.
    */
    transition: opacity 0.45s ease;
  }

  .intro-content > * {
    grid-area: 1 / 1;
  }

  .intro-text {
    font-family: var(--font-display);
    font-weight: 900;
    color: var(--color-blue);
    font-size: clamp(2.5rem, 1.5rem + 7vw, 6rem);
    letter-spacing: -0.03em;
    text-align: center;
    line-height: 1;
    transition:
      opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Hands the spot over to the face, on the curve the face arrives on. */
  .intro-text.is-out {
    opacity: 0;
    transform: translateY(-10px) scale(0.96);
    filter: blur(8px);
  }

  .intro-text span {
    display: inline-block;
    will-change: transform, filter, opacity;
  }

  /*
    Arrives the way the letters do — out of a blur, from just below — so the
    last greeting and the face read as one movement rather than two effects.
  */
  .intro-logo {
    display: block;
    width: clamp(5rem, 3rem + 9vw, 9.5rem);
    height: auto;
    border-radius: 1rem;
    opacity: 0;
    transform: translateY(12px) scale(0.84);
    filter: blur(10px);
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .intro-logo.is-in {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }

  .intro-loader.intro-loader--exiting .intro-content {
    opacity: 0;
  }

  .intro-loader.intro-loader--exiting .intro-panel {
    transition: transform 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    transform: translateY(-105%);
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(1) {
    transition-delay: 0ms;
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(2) {
    transition-delay: 60ms;
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(3) {
    transition-delay: 120ms;
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(4) {
    transition-delay: 180ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-loader {
      display: none !important;
    }
  }
</style>

<script>
  import { splitWords } from "../scripts/split-words";

  (function () {
    const loader = document.getElementById("intro-loader");
    const textEl = document.getElementById("intro-text");
    const logoEl = document.getElementById("intro-logo");
    if (!loader || !textEl) return;

    const skipIntro = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (skipIntro) {
      loader.remove();
      return;
    }

    document.body.style.overflow = "hidden";

    /*
      The hero reveal is driven from here rather than from the page, because
      only this file knows when the panels start moving — and the whole point
      is that the two are one gesture rather than a loader followed by a page.

      Everything below is hidden by script and only while the panels are up. A
      visitor with no JS, or with reduced motion, never reaches this code and
      gets the hero as it has always been.
    */
    const heroName = document.querySelector<HTMLElement>("[data-hero-name]");
    const heroMascot = document.querySelector<HTMLElement>("[data-hero-mascot]");
    const heroCopy = document.querySelector<HTMLElement>("[data-hero-copy]");
    const copyWords = heroCopy ? splitWords(heroCopy, "hero-word") : [];

    // Wiped in from the left rather than faded: the name is the one thing on
    // the page big enough to read as being written.
    if (heroName) heroName.style.clipPath = "inset(0 100% 0 0)";
    if (heroMascot) heroMascot.style.opacity = "0";
    copyWords.forEach((word) => (word.style.opacity = "0"));

    const FLIGHT = 960;
    const NAME_DELAY = 200;
    const NAME_WIPE = 600;
    const COPY_DELAY = 480;
    const COPY_STEP = 16;
    const HANDOVER = 180;

    /*
      The face does not fade out of the loader and fade back into the hero —
      it is the same face, so it travels. A fixed copy of it is measured off
      the loader and moved to the perch on the "k" while the panels rise
      behind it, which is what ties the intro to the page instead of merely
      preceding it.
    */
    function flyMascot() {
      if (!logoEl || !heroMascot) return;
      const from = logoEl.getBoundingClientRect();
      const to = heroMascot.getBoundingClientRect();
      if (!from.width || !to.width) {
        heroMascot.style.opacity = "1";
        return;
      }

      const flier = document.createElement("div");
      flier.setAttribute("aria-hidden", "true");
      flier.style.cssText = [
        "position:fixed",
        "left:0",
        "top:0",
        `width:${from.width}px`,
        `height:${from.height}px`,
        // Above the panels: it has to stay visible while they slide past it.
        "z-index:260",
        "pointer-events:none",
        "transform-origin:0 0",
        `transform:translate(${from.left}px, ${from.top}px)`,
        `transition:transform ${FLIGHT}ms cubic-bezier(0.16, 1, 0.3, 1), opacity ${HANDOVER}ms ease`,
      ].join(";");

      const img = document.createElement("img");
      img.src = (logoEl as HTMLImageElement).currentSrc || (logoEl as HTMLImageElement).src;
      img.alt = "";
      img.style.cssText = [
        "display:block",
        "width:100%",
        "height:100%",
        "border-radius:0.875rem",
        "transform:rotate(0deg)",
        `transition:transform ${FLIGHT}ms cubic-bezier(0.16, 1, 0.3, 1)`,
      ].join(";");
      flier.appendChild(img);
      document.body.appendChild(flier);

      // The original goes at once: the loader's copy is fading out behind it
      // and two faces must never be on screen together.
      logoEl.style.opacity = "0";

      requestAnimationFrame(() => {
        flier.style.transform =
          `translate(${to.left}px, ${to.top}px) scale(${to.width / from.width}, ${to.height / from.height})`;
        // Lands at the same tilt the hero draws it at, so the settle is part
        // of the flight rather than a jump once it arrives.
        img.style.transform = "rotate(8deg)";
      });

      // The two marks are drawn at slightly different crops, so the last beat
      // is a cross-fade at rest rather than a swap — at matching size and
      // position the difference is never visible.
      setTimeout(() => {
        heroMascot.style.transition = `opacity ${HANDOVER}ms ease`;
        heroMascot.style.opacity = "1";
        flier.style.opacity = "0";
        setTimeout(() => {
          flier.remove();
          heroMascot.style.transition = "";
        }, HANDOVER + 80);
      }, FLIGHT - HANDOVER);
    }

    function revealHero() {
      flyMascot();

      if (heroName) {
        setTimeout(() => {
          heroName.style.transition = `clip-path ${NAME_WIPE}ms cubic-bezier(0.16, 1, 0.3, 1)`;
          heroName.style.clipPath = "inset(0 0% 0 0)";
          // Cleared once it has run: the mascot is perched above the line box
          // and any inset at all would cut its hair off. This has to be gone
          // before the flight hands over.
          setTimeout(() => {
            heroName.style.clipPath = "";
            heroName.style.transition = "";
          }, NAME_WIPE + 20);
        }, NAME_DELAY);
      }

      copyWords.forEach((word, i) => {
        word.style.transition = `opacity 420ms ease ${COPY_DELAY + i * COPY_STEP}ms`;
      });
      requestAnimationFrame(() => {
        copyWords.forEach((word) => (word.style.opacity = "1"));
      });
      setTimeout(
        () => copyWords.forEach((word) => (word.style.transition = "")),
        COPY_DELAY + copyWords.length * COPY_STEP + 500
      );
    }

    const words = [
      { text: "Hello.", lang: "en", animate: true },
      { text: "नमस्ते.", lang: "hi", animate: false },
      { text: "नमस्कार.", lang: "mr", animate: false },
      { text: "Hallo!", lang: "de", animate: false },
    ];

    function renderWord(index: number) {
      const word = words[index];
      textEl!.setAttribute("lang", word.lang);

      if (!word.animate) {
        textEl!.textContent = word.text;
        return;
      }

      textEl!.textContent = "";
      [...word.text].forEach((ch, i) => {
        const span = document.createElement("span");
        span.textContent = ch === " " ? " " : ch;
        span.style.filter = "blur(10px)";
        span.style.opacity = "0";
        span.style.transform = "translateY(10px)";
        span.style.transition = `filter 0.5s ease ${i * 35}ms, opacity 0.5s ease ${i * 35}ms, transform 0.5s ease ${i * 35}ms`;
        textEl!.appendChild(span);
      });

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          textEl!.querySelectorAll("span").forEach((span) => {
            const el = span as HTMLElement;
            el.style.filter = "blur(0)";
            el.style.opacity = "1";
            el.style.transform = "translateY(0)";
          });
        });
      });
    }

    function finish() {
      // Before the exiting class, while the loader's face still has a box to
      // be measured from.
      revealHero();
      loader!.classList.add("intro-loader--exiting");
      document.body.style.overflow = "";
      setTimeout(() => loader!.remove(), 1000);
    }

    function advance(index: number) {
      if (index >= words.length - 1) {
        renderWord(index);
        // The last greeting gets a beat on its own, then hands the spot over:
        // the word blurs out as the face blurs in, both in the same place, so
        // it reads as one thing becoming another rather than two arrivals.
        setTimeout(() => {
          textEl!.classList.add("is-out");
          logoEl?.classList.add("is-in");
        }, 600);
        // Long enough for the face to land and be held before the panels go.
        setTimeout(finish, 1600);
        return;
      }
      renderWord(index);
      setTimeout(() => advance(index + 1), index === 0 ? 1000 : 600);
    }

    advance(0);
  })();
</script>
