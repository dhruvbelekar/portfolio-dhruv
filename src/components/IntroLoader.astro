---
---

<div id="intro-loader" class="intro-loader" aria-hidden="true">
  <div class="intro-panel"></div>
  <div class="intro-panel"></div>
  <div class="intro-panel"></div>
  <div class="intro-panel"></div>
  <div class="intro-content">
    <h1 id="intro-text" class="intro-text" lang="en">Hello.</h1>
  </div>
</div>

<style>
  .intro-loader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .intro-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    width: calc(25% + 2px);
    background: var(--color-paper);
  }
  .intro-panel:nth-child(1) {
    left: 0;
  }
  .intro-panel:nth-child(2) {
    left: calc(25% - 1px);
  }
  .intro-panel:nth-child(3) {
    left: calc(50% - 1px);
  }
  .intro-panel:nth-child(4) {
    left: calc(75% - 1px);
  }

  .intro-content {
    position: relative;
    z-index: 1;
    padding: 0 1.5rem;
  }

  .intro-text {
    font-family: var(--font-display);
    font-weight: 900;
    color: var(--color-blue);
    font-size: clamp(2.5rem, 1.5rem + 7vw, 6rem);
    letter-spacing: -0.03em;
    text-align: center;
    line-height: 1;
    transition: opacity 0.3s ease;
  }

  .intro-text span {
    display: inline-block;
    will-change: transform, filter, opacity;
  }

  .intro-loader.intro-loader--exiting .intro-content {
    opacity: 0;
  }

  .intro-loader.intro-loader--exiting .intro-panel {
    transition: transform 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    transform: translateY(-105%);
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(1) {
    transition-delay: 0ms;
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(2) {
    transition-delay: 60ms;
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(3) {
    transition-delay: 120ms;
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(4) {
    transition-delay: 180ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-loader {
      display: none !important;
    }
  }
</style>

<script>
  (function () {
    const loader = document.getElementById("intro-loader");
    const textEl = document.getElementById("intro-text");
    if (!loader || !textEl) return;

    const skipIntro = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (skipIntro) {
      loader.remove();
      return;
    }

    document.body.style.overflow = "hidden";

    const words = [
      { text: "Hello.", lang: "en", animate: true },
      { text: "नमस्ते.", lang: "hi", animate: false },
      { text: "नमस्कार.", lang: "mr", animate: false },
      { text: "Hallo!", lang: "de", animate: false },
    ];

    function renderWord(index: number) {
      const word = words[index];
      textEl!.setAttribute("lang", word.lang);

      if (!word.animate) {
        textEl!.textContent = word.text;
        return;
      }

      textEl!.textContent = "";
      [...word.text].forEach((ch, i) => {
        const span = document.createElement("span");
        span.textContent = ch === " " ? " " : ch;
        span.style.filter = "blur(10px)";
        span.style.opacity = "0";
        span.style.transform = "translateY(10px)";
        span.style.transition = `filter 0.5s ease ${i * 35}ms, opacity 0.5s ease ${i * 35}ms, transform 0.5s ease ${i * 35}ms`;
        textEl!.appendChild(span);
      });

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          textEl!.querySelectorAll("span").forEach((span) => {
            const el = span as HTMLElement;
            el.style.filter = "blur(0)";
            el.style.opacity = "1";
            el.style.transform = "translateY(0)";
          });
        });
      });
    }

    function finish() {
      loader!.classList.add("intro-loader--exiting");
      document.body.style.overflow = "";
      setTimeout(() => loader!.remove(), 1000);
    }

    function advance(index: number) {
      if (index >= words.length - 1) {
        renderWord(index);
        setTimeout(finish, 750);
        return;
      }
      renderWord(index);
      setTimeout(() => advance(index + 1), index === 0 ? 1000 : 600);
    }

    advance(0);
  })();
</script>
