---
---

<div id="intro-loader" class="intro-loader" aria-hidden="true">
  <div class="intro-panel"></div>
  <div class="intro-panel"></div>
  <div class="intro-panel"></div>
  <div class="intro-panel"></div>
  <div class="intro-content">
    <h1 id="intro-text" class="intro-text" lang="en">Hello.</h1>
    {/*
      In the markup from the first paint rather than created when its turn
      comes, so the browser has already fetched and decoded it by the time the
      greetings are done and it never pops in a frame late.
    */}
    <img
      id="intro-logo"
      class="intro-logo"
      src="/icons/logo-mark.webp"
      alt=""
      width="256"
      height="256"
      decoding="async"
    />
  </div>
</div>

<style>
  .intro-loader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .intro-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    width: calc(25% + 2px);
    background: var(--color-paper);
  }
  .intro-panel:nth-child(1) {
    left: 0;
  }
  .intro-panel:nth-child(2) {
    left: calc(25% - 1px);
  }
  .intro-panel:nth-child(3) {
    left: calc(50% - 1px);
  }
  .intro-panel:nth-child(4) {
    left: calc(75% - 1px);
  }

  .intro-content {
    position: relative;
    z-index: 1;
    padding: 0 1.5rem;
    /*
      One cell, and the greeting and the face are both placed in it, so the
      face takes the spot the words were standing in rather than arriving
      underneath them and shifting the whole block up.
    */
    display: grid;
    place-items: center;
    /*
      The exit used to drop this to zero with nothing to ease it, so the
      greeting blinked out a beat before the panels moved. Fading it lets
      whatever is on screen leave under the panels on their way up.
    */
    transition: opacity 0.45s ease;
  }

  .intro-content > * {
    grid-area: 1 / 1;
  }

  .intro-text {
    font-family: var(--font-display);
    font-weight: 900;
    color: var(--color-blue);
    font-size: clamp(2.5rem, 1.5rem + 7vw, 6rem);
    letter-spacing: -0.03em;
    text-align: center;
    line-height: 1;
    transition:
      opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Hands the spot over to the face, on the curve the face arrives on. */
  .intro-text.is-out {
    opacity: 0;
    transform: translateY(-10px) scale(0.96);
    filter: blur(8px);
  }

  .intro-text span {
    display: inline-block;
    will-change: transform, filter, opacity;
  }

  /*
    Arrives the way the letters do — out of a blur, from just below — so the
    last greeting and the face read as one movement rather than two effects.
  */
  .intro-logo {
    display: block;
    width: clamp(5rem, 3rem + 9vw, 9.5rem);
    height: auto;
    border-radius: 1rem;
    opacity: 0;
    transform: translateY(12px) scale(0.84);
    filter: blur(10px);
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .intro-logo.is-in {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }

  .intro-loader.intro-loader--exiting .intro-content {
    opacity: 0;
  }

  .intro-loader.intro-loader--exiting .intro-panel {
    transition: transform 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    transform: translateY(-105%);
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(1) {
    transition-delay: 0ms;
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(2) {
    transition-delay: 60ms;
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(3) {
    transition-delay: 120ms;
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(4) {
    transition-delay: 180ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-loader {
      display: none !important;
    }
  }
</style>

<script>
  import { splitChars, splitWords } from "../scripts/split-words";

  (function () {
    const loader = document.getElementById("intro-loader");
    const textEl = document.getElementById("intro-text");
    const logoEl = document.getElementById("intro-logo");
    if (!loader || !textEl) return;

    const skipIntro = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (skipIntro) {
      loader.remove();
      return;
    }

    document.body.style.overflow = "hidden";

    /*
      The hero reveal is driven from here rather than from the page, because
      only this file knows when the panels start moving — and the whole point
      is that the two are one gesture rather than a loader followed by a page.

      Everything below is hidden by script and only while the panels are up. A
      visitor with no JS, or with reduced motion, never reaches this code and
      gets the hero as it has always been.
    */
    const heroName = document.querySelector<HTMLElement>("[data-hero-name]");
    const heroCopy = document.querySelector<HTMLElement>("[data-hero-copy]");
    /*
      The face is perched on the "k" but arrives on its own, after both lines
      have landed, so it is held out of the letters it sits above.
    */
    const heroFace = document.querySelector<HTMLElement>("[data-hero-face]");
    const nameChars = heroName ? splitChars(heroName, "hero-char") : [];
    const copyWords = heroCopy ? splitWords(heroCopy, "hero-word") : [];

    // A heading that is now twelve spans would be spelled out letter by letter
    // by a screen reader, so it is named once instead.
    if (heroName && nameChars.length) {
      heroName.setAttribute("aria-label", heroName.textContent!.trim());
    }

    /*
      The name arrives the way the greeting did: each letter out of its own
      blur, from just below, one after the next. The offsets are in `em` so the
      blur stays the same fraction of the letter at every size — the name runs
      from 24px to 380px, and a fixed radius would be a smudge at one end and
      invisible at the other.
    */
    nameChars.forEach((ch) => {
      ch.style.display = "inline-block";
      ch.style.opacity = "0";
      ch.style.transform = "translateY(0.08em)";
      ch.style.filter = "blur(0.08em)";
      ch.style.willChange = "opacity, transform, filter";
    });
    copyWords.forEach((word) => (word.style.opacity = "0"));
    if (heroFace) {
      heroFace.style.opacity = "0";
      heroFace.style.transform = "translateY(25%) scale(0.72)";
      heroFace.style.filter = "blur(0.06em)";
    }

    /*
      Three beats, not one: the name, then the line under it, then the face.
      Everything is timed from the moment the panels start to rise, and the
      first beat waits for them to clear the screen — the point is a white page
      that fills, so nothing may be caught arriving behind a panel.
    */
    const NAME_DELAY = 820;
    const NAME_STEP = 26;
    const NAME_DURATION = 520;
    const COPY_DELAY = 1380;
    const COPY_STEP = 12;
    const COPY_DURATION = 380;
    const FACE_DELAY = 1980;
    const FACE_DURATION = 560;

    function revealHero() {
      nameChars.forEach((ch, i) => {
        const at = NAME_DELAY + i * NAME_STEP;
        ch.style.transition =
          `opacity ${NAME_DURATION}ms ease ${at}ms, ` +
          `transform ${NAME_DURATION}ms ease ${at}ms, ` +
          `filter ${NAME_DURATION}ms ease ${at}ms`;
      });

      copyWords.forEach((word, i) => {
        word.style.transition = `opacity ${COPY_DURATION}ms ease ${COPY_DELAY + i * COPY_STEP}ms`;
      });

      // Overshoots a little on the way in, which is the difference between the
      // face landing and the face popping.
      if (heroFace) {
        heroFace.style.transition =
          `opacity ${FACE_DURATION}ms ease ${FACE_DELAY}ms, ` +
          `transform ${FACE_DURATION}ms cubic-bezier(0.34, 1.45, 0.64, 1) ${FACE_DELAY}ms, ` +
          `filter ${FACE_DURATION}ms ease ${FACE_DELAY}ms`;
      }

      /*
        The usual frame callback between arming the transitions and releasing
        them is not used here, and deliberately: a tab opened in the background
        is never given one until it is looked at, and the clean-up below — on a
        timer, which does keep running — would then land first and strip the
        transitions before they had started. The hidden state was written when
        the script first ran and has been painted many times since, so reading
        a layout value is enough to fix it as the frame to move off.
      */
      void heroName?.offsetWidth;

      nameChars.forEach((ch) => {
        ch.style.opacity = "1";
        ch.style.transform = "translateY(0)";
        ch.style.filter = "blur(0)";
      });
      copyWords.forEach((word) => (word.style.opacity = "1"));
      if (heroFace) {
        heroFace.style.opacity = "1";
        heroFace.style.transform = "translateY(0) scale(1)";
        heroFace.style.filter = "blur(0)";
      }

      /*
        Everything the reveal wrote is taken back off once it has run. The face
        tilts on hover from its own class, and an inline transform left behind
        would be the one thing standing in the way of it.
      */
      setTimeout(() => {
        nameChars.forEach((ch) => {
          ch.style.transition = "";
          ch.style.transform = "";
          ch.style.filter = "";
          ch.style.willChange = "";
        });
        copyWords.forEach((word) => (word.style.transition = ""));
        if (heroFace) {
          heroFace.style.transition = "";
          heroFace.style.transform = "";
          heroFace.style.filter = "";
        }
      }, FACE_DELAY + FACE_DURATION + 100);
    }

    const words = [
      { text: "Hello.", lang: "en", animate: true },
      { text: "नमस्ते.", lang: "hi", animate: false },
      { text: "नमस्कार.", lang: "mr", animate: false },
      { text: "Hallo!", lang: "de", animate: false },
    ];

    function renderWord(index: number) {
      const word = words[index];
      textEl!.setAttribute("lang", word.lang);

      if (!word.animate) {
        textEl!.textContent = word.text;
        return;
      }

      textEl!.textContent = "";
      [...word.text].forEach((ch, i) => {
        const span = document.createElement("span");
        span.textContent = ch === " " ? " " : ch;
        span.style.filter = "blur(10px)";
        span.style.opacity = "0";
        span.style.transform = "translateY(10px)";
        span.style.transition = `filter 0.5s ease ${i * 35}ms, opacity 0.5s ease ${i * 35}ms, transform 0.5s ease ${i * 35}ms`;
        textEl!.appendChild(span);
      });

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          textEl!.querySelectorAll("span").forEach((span) => {
            const el = span as HTMLElement;
            el.style.filter = "blur(0)";
            el.style.opacity = "1";
            el.style.transform = "translateY(0)";
          });
        });
      });
    }

    function finish() {
      // Armed before the exiting class so the hero's own clock starts on the
      // same frame the panels do.
      revealHero();
      loader!.classList.add("intro-loader--exiting");
      document.body.style.overflow = "";
      setTimeout(() => loader!.remove(), 1000);
    }

    function advance(index: number) {
      if (index >= words.length - 1) {
        renderWord(index);
        // The last greeting gets a beat on its own, then hands the spot over:
        // the word blurs out as the face blurs in, both in the same place, so
        // it reads as one thing becoming another rather than two arrivals.
        setTimeout(() => {
          textEl!.classList.add("is-out");
          logoEl?.classList.add("is-in");
        }, 600);
        // Long enough for the face to land and be held before the panels go.
        setTimeout(finish, 1600);
        return;
      }
      renderWord(index);
      setTimeout(() => advance(index + 1), index === 0 ? 1000 : 600);
    }

    advance(0);
  })();
</script>
