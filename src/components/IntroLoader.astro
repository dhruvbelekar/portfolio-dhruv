---
---

<div id="intro-loader" class="intro-loader" aria-hidden="true">
  <div class="intro-panel"></div>
  <div class="intro-panel"></div>
  <div class="intro-panel"></div>
  <div class="intro-panel"></div>
  <div class="intro-content">
    <h1 id="intro-text" class="intro-text" lang="en">Hello.</h1>
    {/*
      Both faces are in the markup from the first paint rather than created
      when their turn comes, so they are fetched and decoded long before the
      greetings run out and neither pops in a frame late. They are the matched
      pair from the hero — same crop, same position, only the expression
      differs — which is what lets the wink land without the head moving.
    */}
    <img
      id="intro-logo"
      class="intro-face intro-face--greet"
      src="/img/hero/face.webp"
      alt=""
      width="420"
      height="400"
      decoding="async"
    />
    <img
      id="intro-logo-wink"
      class="intro-face intro-face--wink"
      src="/img/hero/face-tongue.webp"
      alt=""
      width="420"
      height="400"
      decoding="async"
    />
  </div>
</div>

<style>
  .intro-loader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .intro-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    width: calc(25% + 2px);
    background: var(--color-paper);
  }
  .intro-panel:nth-child(1) {
    left: 0;
  }
  .intro-panel:nth-child(2) {
    left: calc(25% - 1px);
  }
  .intro-panel:nth-child(3) {
    left: calc(50% - 1px);
  }
  .intro-panel:nth-child(4) {
    left: calc(75% - 1px);
  }

  .intro-content {
    position: relative;
    z-index: 1;
    padding: 0 1.5rem;
    /*
      One cell, and the greeting and the face are both placed in it, so the
      face takes the spot the words were standing in rather than arriving
      underneath them and shifting the whole block up.
    */
    display: grid;
    place-items: center;
    /*
      The exit used to drop this to zero with nothing to ease it, so the
      greeting blinked out a beat before the panels moved. Fading it lets
      whatever is on screen leave under the panels on their way up.
    */
    transition: opacity 0.45s ease;
  }

  .intro-content > * {
    grid-area: 1 / 1;
  }

  .intro-text {
    font-family: var(--font-display);
    font-weight: 900;
    color: var(--color-blue);
    font-size: clamp(2.5rem, 1.5rem + 7vw, 6rem);
    letter-spacing: -0.03em;
    text-align: center;
    line-height: 1;
    transition:
      opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Hands the spot over to the face, on the curve the face arrives on. */
  .intro-text.is-out {
    opacity: 0;
    transform: translateY(-10px) scale(0.96);
    filter: blur(8px);
  }

  .intro-text span {
    display: inline-block;
    will-change: transform, filter, opacity;
  }

  /* Both faces are sized and placed identically — only the face changes. */
  .intro-face {
    display: block;
    width: clamp(5.5rem, 3.25rem + 10vw, 10.5rem);
    height: auto;
  }

  /*
    The first one arrives the way the letters do — out of a blur, from just
    below — so the last greeting and the face read as one movement rather than
    two effects.
  */
  .intro-face--greet {
    opacity: 0;
    transform: translateY(12px) scale(0.84);
    filter: blur(10px);
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .intro-face--greet.is-in {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }

  /*
    The wink is a change of expression, not a second arrival, so it swaps on a
    short cut rather than easing in. Long enough not to flicker, short enough
    that the two drawings are never both half-there long enough to ghost.
    This has to sit after `.is-in` — same specificity, and the swap wins.
  */
  .intro-face--wink {
    opacity: 0;
    transition: opacity 0.16s ease;
  }

  .intro-face--wink.is-in {
    opacity: 1;
  }

  .intro-face--greet.is-winking {
    opacity: 0;
    transition: opacity 0.16s ease;
  }

  .intro-loader.intro-loader--exiting .intro-content {
    opacity: 0;
  }

  .intro-loader.intro-loader--exiting .intro-panel {
    transition: transform 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    transform: translateY(-105%);
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(1) {
    transition-delay: 0ms;
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(2) {
    transition-delay: 60ms;
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(3) {
    transition-delay: 120ms;
  }
  .intro-loader.intro-loader--exiting .intro-panel:nth-child(4) {
    transition-delay: 180ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-loader {
      display: none !important;
    }
  }
</style>

<script>
  (function () {
    const loader = document.getElementById("intro-loader");
    const textEl = document.getElementById("intro-text");
    const logoEl = document.getElementById("intro-logo");
    const winkEl = document.getElementById("intro-logo-wink");
    if (!loader || !textEl) return;

    const skipIntro = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (skipIntro) {
      loader.remove();
      return;
    }

    document.body.style.overflow = "hidden";

    const words = [
      { text: "Hello.", lang: "en", animate: true },
      { text: "नमस्ते.", lang: "hi", animate: false },
      { text: "नमस्कार.", lang: "mr", animate: false },
      { text: "Hallo!", lang: "de", animate: false },
    ];

    function renderWord(index: number) {
      const word = words[index];
      textEl!.setAttribute("lang", word.lang);

      if (!word.animate) {
        textEl!.textContent = word.text;
        return;
      }

      textEl!.textContent = "";
      [...word.text].forEach((ch, i) => {
        const span = document.createElement("span");
        span.textContent = ch === " " ? " " : ch;
        span.style.filter = "blur(10px)";
        span.style.opacity = "0";
        span.style.transform = "translateY(10px)";
        span.style.transition = `filter 0.5s ease ${i * 35}ms, opacity 0.5s ease ${i * 35}ms, transform 0.5s ease ${i * 35}ms`;
        textEl!.appendChild(span);
      });

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          textEl!.querySelectorAll("span").forEach((span) => {
            const el = span as HTMLElement;
            el.style.filter = "blur(0)";
            el.style.opacity = "1";
            el.style.transform = "translateY(0)";
          });
        });
      });
    }

    function finish() {
      loader!.classList.add("intro-loader--exiting");
      document.body.style.overflow = "";
      setTimeout(() => loader!.remove(), 1000);
    }

    function advance(index: number) {
      if (index >= words.length - 1) {
        renderWord(index);
        // The last greeting gets a beat on its own, then hands the spot over:
        // the word blurs out as the face blurs in, both in the same place, so
        // it reads as one thing becoming another rather than two arrivals.
        setTimeout(() => {
          textEl!.classList.add("is-out");
          logoEl?.classList.add("is-in");
        }, 550);
        // Held straight just long enough to be taken as the sign-off, then it
        // pulls a face — the beat that makes it read as a character rather
        // than a logo parked on screen.
        setTimeout(() => {
          logoEl?.classList.add("is-winking");
          winkEl?.classList.add("is-in");
        }, 1200);
        setTimeout(finish, 1850);
        return;
      }
      renderWord(index);
      setTimeout(() => advance(index + 1), index === 0 ? 1000 : 600);
    }

    advance(0);
  })();
</script>
