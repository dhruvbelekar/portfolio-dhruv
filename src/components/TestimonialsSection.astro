---
import Marquee from "./Marquee";
import ScrollReveal from "./ScrollReveal";
import { testimonials } from "../data/projects";

// Two rows running opposite ways, so the pair reads as one moving block rather
// than a single ticker. The four quotes are split across them and repeated to
// fill the track.
const rows = [
  { items: [testimonials[2], testimonials[3]], speed: 65, direction: "left" as const },
  { items: [testimonials[0], testimonials[1]], speed: 72, direction: "right" as const },
];
---

<section class="px-6 pt-16 md:px-10">
  <div class="mx-auto max-w-[1400px]">
    <ScrollReveal client:load>
      <h2
        class="select-none text-center font-black leading-[0.9] text-blue"
        style="font-family: var(--font-display); font-size: var(--type-section);"
      >
        Testimonials
      </h2>
    </ScrollReveal>
  </div>
</section>

<section class="px-6 pb-16 pt-10 md:px-10">
  <div class="mx-auto max-w-[1400px]">
    <div class="flex flex-col gap-2">
      {
        rows.map((row) => (
          <Marquee client:load speed={row.speed} gap="1rem" direction={row.direction}>
            {Array(4)
              .fill(row.items)
              .flat()
              .map((t, i) => (
                <div
                  key={i}
                  class="group flex h-[185px] w-[320px] shrink-0 flex-col rounded-2xl p-6 transition-[transform,box-shadow,background-color] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1.5 hover:bg-white hover:shadow-[0_18px_40px_rgba(19,67,240,0.10)]"
                >
                  <div class="flex items-center gap-3">
                    <img
                      src={t.avatar}
                      alt=""
                      class="h-10 w-10 shrink-0 rounded-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110"
                    />
                    <div>
                      <p class="font-bold text-ink transition-colors duration-300 group-hover:text-blue">
                        {t.name}
                      </p>
                      <p class="text-sm text-ink-muted">{t.role}</p>
                    </div>
                  </div>
                  <p class="mt-4 line-clamp-4 text-sm text-ink-muted">{t.quote}</p>
                </div>
              ))}
          </Marquee>
        ))
      }
    </div>
  </div>
</section>
