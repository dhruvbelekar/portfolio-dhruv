---
import LetterReveal from "./LetterReveal.astro";
import { testimonials } from "../data/projects";

// One quote at a time, in the order they are read: the frame pins while the
// page scrolls past it, and each stretch of scroll hands the stage to the next
// person, so every quote gets the whole screen to itself.
const order = ["Vaishakh Sajeevan", "Ankit Savla", "Rupak Shah", "Nikhil Kulkarni"];
const quotes = order.map((name) => testimonials.find((t) => t.name === name)!);
---

<section class="px-6 pt-[var(--space-section)] md:px-10">
  <div class="mx-auto max-w-[1400px]">
    <LetterReveal
      class="select-none text-center font-black leading-[0.9] text-blue"
      style="font-family: var(--font-display); font-size: var(--type-section);"
    >
      Testimonials
    </LetterReveal>
  </div>
</section>

<section class="tm" data-tm style={`--tm-count: ${quotes.length}`}>
  <div class="tm-frame">
    <div class="tm-inner">
      <div class="tm-people" role="tablist" aria-label="Testimonials">
        {
          quotes.map((t, i) => (
            <button
              type="button"
              role="tab"
              data-tm-person={i}
              aria-selected={i === 0 ? "true" : "false"}
              aria-label={t.name}
              class="tm-person"
            >
              <img src={t.avatar} alt="" width="56" height="56" loading="lazy" decoding="async" />
            </button>
          ))
        }
      </div>

      <div class="tm-stage">
        {
          quotes.map((t, i) => (
            <figure class="tm-quote" data-tm-quote={i} data-state={i === 0 ? "now" : "next"}>
              <blockquote>
                <p
                  class="tm-text"
                  style="font-family: var(--font-display);"
                >
                  “{t.quote}”
                </p>
              </blockquote>
              <figcaption class="tm-who">
                <span class="tm-name">{t.name}</span>
                <span class="tm-role">{t.role}</span>
              </figcaption>
              {t.metrics && t.metrics.length > 0 && (
                <dl class="tm-metrics">
                  {t.metrics.map((m) => (
                    <div class="tm-metric">
                      <dt class="tm-metric-label">{m.label}</dt>
                      <dd class="tm-metric-value" style="font-family: var(--font-display);">
                        <span data-tm-count={m.value}>{m.value}</span>
                        {m.suffix}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /*
    The section is as tall as the scroll the quotes take, and the frame inside
    it sticks to the window for that whole stretch. Each quote gets most of a
    screen of scrolling: it holds for the middle of that and hands over at the
    ends.
  */
  .tm {
    position: relative;
    height: calc(100svh + (var(--tm-count) - 1) * 85svh);
  }

  .tm-frame {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    padding: 6rem 1.5rem 3rem;
  }

  .tm-inner {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.75rem, 4vh, 3rem);
  }

  .tm-people {
    display: flex;
    gap: 0.75rem;
  }

  .tm-person {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    overflow: hidden;
    opacity: 0.35;
    filter: grayscale(1);
    transform: scale(0.82);
    box-shadow: 0 0 0 0 transparent;
    transition:
      opacity 0.5s ease,
      filter 0.5s ease,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.5s ease;
  }
  .tm-person img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tm-person:hover {
    opacity: 0.7;
  }
  .tm-person[aria-selected="true"] {
    opacity: 1;
    filter: none;
    transform: scale(1);
    box-shadow:
      0 0 0 3px var(--color-paper),
      0 0 0 5px var(--color-blue);
  }
  .tm-person:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 4px;
  }

  /* Every quote sits in the same cell, so the stage is as tall as the longest
     and nothing below it jumps when they change. */
  .tm-stage {
    display: grid;
    width: 100%;
  }
  /* Moved by the script below in step with the scroll, so there is no
     transition here to fight it. A quote only carries a blur while it is
     arriving or leaving; at rest it is plain type. */
  .tm-quote {
    grid-area: 1 / 1;
    margin: 0;
    text-align: center;
    will-change: opacity, transform, filter;
  }
  .tm-quote[data-state="next"],
  .tm-quote[data-state="past"] {
    pointer-events: none;
  }
  /* Before the script runs, only the first quote shows. */
  .tm-quote:not([data-state="now"]) {
    opacity: 0;
  }

  .tm-text {
    color: var(--color-ink);
    font-weight: 500;
    font-size: clamp(1.5rem, 1rem + 2.4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .tm-who {
    margin-top: clamp(1.25rem, 3vh, 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }
  .tm-name {
    font-weight: 700;
    color: var(--color-blue);
  }
  .tm-role {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }

  /* The numbers behind the quote: the largest type after the quote itself, in
     the brand blue, each over a short plain label. The label sits under the
     number visually but first in the markup, so it is read before the value. */
  .tm-metrics {
    margin: clamp(1.5rem, 4vh, 2.5rem) auto 0;
    padding-top: clamp(1.25rem, 3vh, 2rem);
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 6vw, 4.5rem);
    max-width: 760px;
  }
  .tm-metric {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
  }
  .tm-metric-value {
    margin: 0;
    color: var(--color-blue);
    font-weight: 900;
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .tm-metric-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink-muted);
    text-wrap: balance;
  }
  @media (max-width: 480px) {
    .tm-metrics {
      gap: 1rem;
    }
    .tm-metric-label {
      font-size: 0.6875rem;
    }
  }

  /*
    The way in. While the section is coming up the page, the script sets one
    value per part, 0 to 1, and each part rises into place on its own: the
    faces first, then the quote out of a blur, the name and the numbers.
    Only the quote on stage is touched; the rest are hidden anyway.
  */
  .tm[data-entering] .tm-people {
    opacity: var(--tm-in-people);
    transform: translate3d(0, calc((1 - var(--tm-in-people)) * 24px), 0);
  }
  .tm[data-entering] .tm-quote[data-state="now"] .tm-text {
    opacity: var(--tm-in-text);
    transform: translate3d(0, calc((1 - var(--tm-in-text)) * 48px), 0);
    filter: blur(calc((1 - var(--tm-in-text)) * 12px));
  }
  .tm[data-entering] .tm-quote[data-state="now"] .tm-who {
    opacity: var(--tm-in-who);
    transform: translate3d(0, calc((1 - var(--tm-in-who)) * 24px), 0);
  }
  .tm[data-entering] .tm-quote[data-state="now"] .tm-metrics {
    opacity: var(--tm-in-metrics);
    transform: translate3d(0, calc((1 - var(--tm-in-metrics)) * 32px), 0);
  }

  /* With motion turned down the quotes simply stack, one after another. */
  @media (prefers-reduced-motion: reduce) {
    .tm {
      height: auto;
    }
    .tm-frame {
      position: static;
      height: auto;
      padding-top: 3rem;
    }
    .tm-people {
      display: none;
    }
    .tm-stage {
      gap: 4rem;
    }
    .tm-quote,
    .tm-quote[data-state] {
      grid-area: auto;
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>

<script>
  // Of each quote's stretch of scroll, the share either side of its middle it
  // holds perfectly still for, and the share it spends arriving or leaving.
  const HOLD = 0.18;
  const FADE = 0.32;
  // How far a quote travels as it arrives or leaves, in pixels.
  const LIFT = 56;
  // The most blur a quote carries, reached as it fades out completely.
  const BLUR = 12;
  // The share of the remaining distance covered each frame. The quotes trail
  // the scroll by a few frames, which turns the steps of a mouse wheel into
  // one glide.
  const EASE = 0.14;
  // How long a quote's numbers take to count up once it is on stage.
  const COUNT_MS = 1400;
  // Where the section's top sits, as a share of the window, when the reveal
  // starts. It is complete the moment the frame pins.
  const ENTER_FROM = 0.75;
  // The reveal in order: faces, quote, name, numbers. Each part
  // plays across its own share of the way in, overlapping the next, so the
  // stage fills one piece at a time.
  const STAGES: [string, number, number][] = [
    ["--tm-in-people", 0, 0.45],
    ["--tm-in-text", 0.15, 0.7],
    ["--tm-in-who", 0.4, 0.85],
    ["--tm-in-metrics", 0.55, 1],
  ];
  // How far in the numbers have to be before they start counting.
  const COUNT_AT = 0.55;

  const smooth = (t: number) => t * t * (3 - 2 * t);

  document.querySelectorAll<HTMLElement>("[data-tm]").forEach((section) => {
    const quotes = [...section.querySelectorAll<HTMLElement>("[data-tm-quote]")];
    const people = [...section.querySelectorAll<HTMLButtonElement>("[data-tm-person]")];
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    const count = quotes.length;
    let active = -1;
    let showing = false;

    // How far through its pinned stretch the section is, in quotes: 0 at the
    // start, `count` at the end.
    const target = () => {
      const rect = section.getBoundingClientRect();
      const travel = rect.height - window.innerHeight;
      const progress = travel > 0 ? Math.min(Math.max(-rect.top / travel, 0), 1) : 0;
      return progress * count;
    };
    let current = target();

    // How far the section has come up into the window, from 0 as its top
    // nears the fold to 1 as it pins.
    const entry = () => {
      const top = section.getBoundingClientRect().top;
      const from = window.innerHeight * ENTER_FROM;
      return Math.min(Math.max((from - top) / from, 0), 1);
    };
    let entered = entry();

    // Each time a quote takes the stage its numbers run up from zero, so the
    // result lands as the quote does. The page is served with the final
    // values, which is what shows with motion turned down.
    const countUp = (quote: HTMLElement) => {
      quote.querySelectorAll<HTMLElement>("[data-tm-count]").forEach((el) => {
        const goal = Number(el.dataset.tmCount);
        const run = Number(el.dataset.tmRun ?? 0) + 1;
        el.dataset.tmRun = String(run);
        const start = performance.now();
        const step = (now: number) => {
          if (el.dataset.tmRun !== String(run)) return;
          const t = Math.min(1, (now - start) / COUNT_MS);
          el.textContent = String(Math.round((1 - Math.pow(1 - t, 3)) * goal));
          if (t < 1) requestAnimationFrame(step);
        };
        el.textContent = "0";
        requestAnimationFrame(step);
        // Frames stop in a background tab; a timer still lands the final value.
        setTimeout(() => {
          if (el.dataset.tmRun === String(run)) el.textContent = String(goal);
        }, COUNT_MS + 100);
      });
    };

    const mark = (index: number) => {
      if (index === active) return;
      active = index;
      quotes.forEach((q, i) => {
        q.dataset.state = i === index ? "now" : i < index ? "past" : "next";
        q.setAttribute("aria-hidden", i === index ? "false" : "true");
      });
      people.forEach((p, i) => p.setAttribute("aria-selected", i === index ? "true" : "false"));
      if (showing) countUp(quotes[index]);
    };

    // Played by the scroll, so it runs back the way it came if the reader
    // scrolls up again. Once the stage is full the attribute comes off and
    // nothing is held on the type.
    const reveal = (e: number) => {
      if (e >= 1) {
        section.removeAttribute("data-entering");
      } else {
        section.setAttribute("data-entering", "");
        STAGES.forEach(([name, a, b]) =>
          section.style.setProperty(name, smooth(Math.min(Math.max((e - a) / (b - a), 0), 1)).toFixed(3))
        );
      }
      // The numbers count up as they come into view, and again each time the
      // section is come back to from above or below.
      const rect = section.getBoundingClientRect();
      const now = e >= COUNT_AT && rect.bottom > window.innerHeight * 0.3;
      if (now && !showing && active >= 0) {
        showing = true;
        countUp(quotes[active]);
      } else if (!now) {
        showing = false;
      }
    };

    const paint = (pos: number) => {
      quotes.forEach((q, i) => {
        // Distance from this quote's middle, in quotes. The first has nothing
        // to arrive after and the last nothing to leave for, so they hold at
        // the ends instead.
        let d = pos - (i + 0.5);
        if (i === 0 && d < 0) d = 0;
        if (i === count - 1 && d > 0) d = 0;
        const away = smooth(Math.min(Math.max((Math.abs(d) - HOLD) / FADE, 0), 1));
        q.style.opacity = String(1 - away);
        q.style.transform = `translate3d(0, ${-Math.sign(d) * away * LIFT}px, 0) scale(${1 - away * 0.04})`;
        // The blur is only there while a quote is on the move, and taken off
        // the moment it settles, so a quote sitting still costs nothing to
        // draw. Two at most are ever in motion at once.
        q.style.filter = away > 0.005 && away < 0.995 ? `blur(${(away * BLUR).toFixed(2)}px)` : "";
      });
      mark(Math.min(Math.floor(pos), count - 1));
    };

    let frame = 0;
    const tick = () => {
      frame = 0;
      const goal = target();
      current += (goal - current) * EASE;
      if (Math.abs(goal - current) < 0.001) current = goal;
      const way = entry();
      entered += (way - entered) * EASE;
      if (Math.abs(way - entered) < 0.001) entered = way;
      paint(current);
      reveal(entered);
      if (current !== goal || entered !== way) frame = requestAnimationFrame(tick);
    };
    const wake = () => {
      if (reduced.matches || frame) return;
      frame = requestAnimationFrame(tick);
    };

    // Picking a face scrolls to the middle of that person's stretch, so the
    // page and the quote on screen never disagree.
    people.forEach((person, i) =>
      person.addEventListener("click", () => {
        const travel = section.offsetHeight - window.innerHeight;
        const top = section.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({
          top: top + ((i + 0.5) / count) * travel,
          behavior: reduced.matches ? "auto" : "smooth",
        });
      })
    );

    if (reduced.matches) {
      mark(0);
      return;
    }
    paint(current);
    reveal(entered);
    window.addEventListener("scroll", wake, { passive: true });
    window.addEventListener("resize", wake);
  });
</script>
