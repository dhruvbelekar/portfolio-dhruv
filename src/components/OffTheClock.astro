---
import { offTheClock } from "../data/projects";

// Line icons rather than photographs: the site's own mark is blue line art, so
// these sit in the same family, and nothing here pretends to be a photo of a
// thing that was never shot.
const icons: Record<string, string> = {
  ball: `<circle cx="12" cy="12" r="9"/><path d="m12 8 3.5 2.5-1.3 4.1h-4.4L8.5 10.5z"/><path d="M12 3v5M3.4 9.6l5.1 1M20.6 9.6l-5.1 1M6.5 19.4l3.3-4.8M17.5 19.4l-3.3-4.8"/>`,
  food: `<path d="M7 21V10.5a5 5 0 0 1 10 0V21"/><path d="M5.5 21h13"/><path d="M9.5 10.2c1.7 1 3.3 1 5 0M9.5 14c1.7 1 3.3 1 5 0M9.5 17.6c1.7 1 3.3 1 5 0"/>`,
  ring: `<circle cx="12" cy="14.5" r="6"/><path d="m8.6 9.2 1.6-4.7h3.6l1.6 4.7"/>`,
  wheel: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3v6M4.2 16.5 9.4 13.5M19.8 16.5 14.6 13.5"/>`,
};
---

<section class="px-6 md:px-10">
  <div class="mx-auto max-w-[1400px]">
    <p class="text-xs font-bold tracking-wide text-ink-muted">Off the clock</p>

    <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        offTheClock.map((item) => (
          <li class="group rounded-2xl border border-ink/10 p-6 transition-[transform,border-color,box-shadow] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-blue/40 hover:shadow-[0_14px_34px_rgba(19,67,240,0.10)]">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="h-9 w-9 text-blue transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-rotate-6 group-hover:scale-110"
              set:html={icons[item.icon]}
            />
            <h4 class="mt-5 text-lg font-bold text-ink transition-colors duration-300 group-hover:text-blue">
              {item.title}
            </h4>
            <p class="mt-1 text-sm leading-relaxed text-ink-muted">{item.note}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
