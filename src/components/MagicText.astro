---
/*
  The copy lights up a word at a time as it scrolls through the viewport.

  It takes a slot rather than a string so the highlight spans inside the
  bio survive — the words are split out of the DOM after render, so every
  word keeps whatever colour its parent gave it. Splitting a plain string
  would flatten all of that into one grey run.
*/
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div data-magic-text class={className}><slot /></div>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const blocks = [...document.querySelectorAll<HTMLElement>("[data-magic-text]")];

  // The words are dimmed by script, never by the stylesheet: with no JS the
  // copy is simply legible instead of stuck at a fifth of its contrast.
  const DIM = 0.2;
  const RAMP = 3;

  type Block = { el: HTMLElement; words: HTMLElement[]; last: number[]; live: boolean };

  const split = (root: HTMLElement) => {
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const texts: Text[] = [];
    let node: Node | null;
    while ((node = walker.nextNode())) {
      if (node.textContent && node.textContent.trim()) texts.push(node as Text);
    }

    const words: HTMLElement[] = [];
    for (const text of texts) {
      const frag = document.createDocumentFragment();
      // Whitespace is put back as its own node so wrapping, spacing and
      // selection behave exactly as they did before the split.
      for (const piece of text.textContent!.split(/(\s+)/)) {
        if (!piece) continue;
        if (!piece.trim()) {
          frag.appendChild(document.createTextNode(piece));
          continue;
        }
        const span = document.createElement("span");
        span.className = "magic-word";
        span.textContent = piece;
        span.style.opacity = String(DIM);
        frag.appendChild(span);
        words.push(span);
      }
      text.replaceWith(frag);
    }
    return words;
  };

  if (blocks.length && !reduced.matches) {
    const items: Block[] = [];
    for (const el of blocks) {
      const words = split(el);
      if (words.length) items.push({ el, words, last: words.map(() => DIM), live: false });
    }

    let frame = 0;
    const paint = () => {
      frame = 0;
      const vh = window.innerHeight;
      for (const b of items) {
        if (!b.live) continue;
        const rect = b.el.getBoundingClientRect();
        // Starts when the block's top reaches 85% of the viewport and finishes
        // when its bottom passes 60%, so the light travels with the reading
        // rather than racing ahead of a block taller than the screen.
        const travel = rect.height + vh * 0.25;
        const progress = Math.min(1, Math.max(0, (vh * 0.85 - rect.top) / travel));
        const n = b.words.length;
        for (let i = 0; i < n; i++) {
          // Each word fades across RAMP words' worth of progress rather than
          // its own slice alone. At this length a slice is about nine pixels
          // of scroll, which snaps a word from dim to lit and reads as a hard
          // edge travelling down the copy; overlapping the fades softens that
          // into a gradient without slowing the wipe down.
          const t = Math.min(1, Math.max(0, ((progress - i / n) * n) / RAMP));
          // Rounded so a frame that moves nothing visible writes no style at
          // all; only the few words at the frontier touch the DOM.
          const o = Math.round((DIM + (1 - DIM) * t) * 100) / 100;
          if (o === b.last[i]) continue;
          b.last[i] = o;
          b.words[i].style.opacity = String(o);
        }
      }
    };

    const request = () => {
      if (!frame) frame = requestAnimationFrame(paint);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const b = items.find((x) => x.el === entry.target);
          if (b) b.live = entry.isIntersecting;
        }
        request();
      },
      { rootMargin: "20% 0px" }
    );
    items.forEach((b) => io.observe(b.el));

    window.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", request, { passive: true });
    request();
  }
</script>
