---
import { techStack } from "../data/projects";

/*
  The title is split here rather than in the browser, so the letters are in the
  markup from the first paint and a page with no script simply has a heading.

  Each letter carries where it sits in the line, as a fraction of the way out
  from the middle: `--c` signed, -1 at the first letter and 1 at the last, and
  `--a` the same without its sign. The signed one throws the letters apart; the
  unsigned one says how far round the letter has been rolled, which is why the
  middle of the line lands first and the ends last. Both are multiplied by the
  single value the scroll handler writes, so one property write re-rolls the
  whole line and the browser does the rest.
*/
const title = "My Tech Stack";
const letters = [...title];
const middle = (letters.length - 1) / 2;
const titleChars = letters.map((ch, i) => {
  const c = Number(((i - middle) / middle).toFixed(3));
  return { ch, space: ch === " ", c, a: Math.abs(c) };
});

/*
  The row rolls in on exactly the same terms as the title: its own place in the
  line, signed and unsigned. So the pair in the middle is standing while the
  ones at the ends are still edge-on, and both sides of a pair land together.
*/
const rowMiddle = (techStack.length - 1) / 2;
const tools = techStack.map((tool, i) => {
  const c = Number(((i - rowMiddle) / rowMiddle).toFixed(3));
  return { ...tool, c, a: Math.abs(c) };
});
---

<section class="ts" data-ts>
  <div class="ts-inner">
    {/* The letters are scenery; the heading is named once. */}
    <h2 class="ts-title" data-ts-title aria-label={title}>
      {
        titleChars.map(({ ch, space, c, a }) =>
          space ? (
            <span class="ts-space" aria-hidden="true">
              &nbsp;
            </span>
          ) : (
            <span class="ts-char" style={`--c: ${c}; --a: ${a}`} aria-hidden="true">
              {ch}
            </span>
          )
        )
      }
    </h2>

    <ul class="ts-row" data-ts-row>
      {
        tools.map((tool) => (
          <li class="ts-tool" style={`--c: ${tool.c}; --a: ${tool.a}`} data-ts-tool>
            {tool.mark ? (
              <img src={tool.mark} alt={tool.name} width="56" height="56" loading="lazy" decoding="async" />
            ) : (
              <span class="ts-name">{tool.name}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ts {
    padding: var(--space-section) 1.5rem;
    /*
      The letters are thrown apart before they land, which on a narrow phone
      puts the ends of the line past the edge of the page for a moment. Clipped
      rather than scrollable: a sideways scrollbar that appears halfway through
      an animation and leaves again is worse than a letter grazing the edge.
    */
    overflow-x: clip;
  }

  .ts-inner {
    margin: 0 auto;
    max-width: 1400px;
  }

  /*
    Sized off the shell like every other section headline, but capped so the
    thirteen letters stay on one line at any width. The bend is measured along
    a line; a heading that wrapped would be two arcs pretending to be one.
  */
  .ts-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: min(var(--type-section), calc(var(--shell) * 0.093));
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-blue);
    /*
      Flat is the resting state and the state a page with no script keeps. The
      script lifts this to 1 the moment it runs and scrubs it back down as the
      line climbs the screen.
    */
    --k: 0;
    /*
      Getting on for two turns at the ends of the line and none at the middle.
      It has to be more than half a turn: the letters are meant to be caught at
      every stage of the roll at once — some upright, some edge-on, some fully
      over and reading backwards — which is what makes the line look scattered
      rather than bent, and what makes it unwind from the middle outwards.
    */
    --ts-roll: 620deg;
    --ts-spread: 1.1em;
    /*
      The letters roll about their own horizontal axis, so the ones away from
      the middle are seen from the side of the vanishing point rather than
      straight on. That is what leans them as they turn — the shear is the
      perspective, not a skew, and without this the roll is a flat squash.
    */
    perspective: 800px;
  }

  .ts-char {
    display: inline-block;
    transform: translateX(calc(var(--c) * var(--k) * var(--ts-spread)))
      rotateX(calc(var(--a) * var(--k) * var(--ts-roll)));
    will-change: transform;
  }

  .ts-space {
    display: inline-block;
  }

  .ts-row {
    display: flex;
    margin: clamp(2.5rem, 6vh, 5rem) 0 0;
    padding: 0;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 3.4vw, 3.5rem);
    list-style: none;
    /*
      The row keeps its own clock rather than borrowing the title's. It is
      lower down the page, so it reaches the line where things stand upright
      later — which is what puts the marks behind the heading rather than
      alongside it, exactly as the recording does.
    */
    --k: 0;
    /*
      A quarter turn at the ends and no more. These are pictures, not letters:
      a mark taken past edge-on is showing its own back, which reads as a
      mistake where eleven letters doing it read as a device. Stopping here
      also keeps the row in order — furthest out is flattest, the middle pair
      stand first, and the rest unfold outwards from them.
    */
    --ts-roll: 95deg;
    --ts-spread: 1.6rem;
    perspective: 700px;
  }

  .ts-tool {
    transform: translateX(calc(var(--c) * var(--k) * var(--ts-spread)))
      rotateX(calc(var(--a) * var(--k) * var(--ts-roll)));
    will-change: transform;
  }

  /*
    A square box and `contain` for every mark, so what decides how big a logo
    looks is the box and never the amount of margin its author left around the
    artwork.
  */
  .ts-tool img {
    display: block;
    width: clamp(2.25rem, 4vw, 3.5rem);
    height: clamp(2.25rem, 4vw, 3.5rem);
    object-fit: contain;
  }

  .ts-name {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(0.72rem, 0.55rem + 0.4vw, 0.95rem);
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-ink);
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    /*
      A full screen to itself. The bend is scrubbed by how far the line has
      climbed the window, so it needs the room to climb: in a section only as
      tall as its contents the whole straightening would be over in a flick of
      the wheel.
    */
    .ts {
      display: flex;
      min-height: 100svh;
      flex-direction: column;
      justify-content: center;
      padding: clamp(5rem, 12vh, 8rem) 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ts-title {
      --k: 0 !important;
    }
    .ts-row {
      --k: 0 !important;
    }
  }
</style>

<script>
  (function () {
    const section = document.querySelector<HTMLElement>("[data-ts]");
    const title = document.querySelector<HTMLElement>("[data-ts-title]");
    const row = document.querySelector<HTMLElement>("[data-ts-row]");
    if (!section || !title) return;

    // Both roll on the same terms; each is measured where it actually is, so
    // the title has landed by the time the marks under it are still turning.
    const parts = [title, row].filter(Boolean) as HTMLElement[];

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    /*
      Fully rolled while it is still down at the bottom of the window, and
      standing by the time it has climbed to a little above the middle, which
      is where it is actually read. Scrolling back down rolls it over again —
      it follows the wheel rather than firing once and being spent.
    */
    const BENT_AT = 0.92;
    const FLAT_AT = 0.4;

    let frame = 0;

    const measure = () => {
      frame = 0;
      const vh = window.innerHeight;
      const start = vh * BENT_AT;
      const end = vh * FLAT_AT;
      for (const part of parts) {
        const top = part.getBoundingClientRect().top;
        const k = Math.min(1, Math.max(0, (top - end) / (start - end)));
        part.style.setProperty("--k", k.toFixed(3));
      }
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(measure);
    };

    /*
      The handler is only attached while the section is within a screen of the
      window. Every other section on this page would otherwise be paying for a
      measurement on every frame of every scroll.
    */
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              window.addEventListener("scroll", onScroll, { passive: true });
              onScroll();
            } else {
              window.removeEventListener("scroll", onScroll);
            }
          }
        },
        { rootMargin: "100% 0px" }
      );
      io.observe(section);
    } else {
      window.addEventListener("scroll", onScroll, { passive: true });
    }

    window.addEventListener("resize", onScroll);
    measure();
  })();
</script>
