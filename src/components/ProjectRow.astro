---
import path from "node:path";
import sharp from "sharp";

interface Props {
  slug: string;
  title: string;
  category: string;
  image: string;
  alt: string;
  description: string;
  timeline?: string;
  index: number;
}

const { slug, title, category, image, alt, description, timeline, index } = Astro.props;
const { width, height } = await sharp(path.join(process.cwd(), "public", image)).metadata();
// Passion Project's poster and Frelo's circular badge both lose their top and
// bottom to the shared 4:3 crop, so they are fitted whole. Every other cover
// keeps the crop.
const fitWhole = slug === "passion-project" || slug === "frelo";
---

<a
  href={`/projects-detail/${slug}`}
  class="group relative block border-t border-ink/10 py-10 focus:outline-none lg:py-14"
>
  {/* The hover outline is an overlay rather than a border on the row itself:
      it can then sit inside the row's padding — clear of the divider rule and
      of the next row — without pushing the content around. */}
  <span
    class="pointer-events-none absolute -inset-x-4 inset-y-4 rounded-2xl ring-1 ring-blue/0 transition-[box-shadow] duration-500 ease-out group-hover:ring-blue/70 group-focus-visible:ring-blue/70 md:-inset-x-6 lg:inset-y-6"
  ></span>
  <div class="grid items-center gap-7 md:grid-cols-[1.15fr_1fr] md:gap-12 lg:gap-20">
    <div class="overflow-hidden rounded-2xl">
      <img
        src={image}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        class={`aspect-[4/3] w-full transition-transform duration-[900ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.05] group-focus-visible:scale-[1.05] ${fitWhole ? "object-contain" : "object-cover"}`}
      />
    </div>

    <div>
      <div class="flex items-baseline gap-4">
        <span class="text-xs font-bold tabular-nums text-ink-muted">
          {String(index + 1).padStart(2, "0")}
        </span>
        <span class="text-xs font-bold tracking-wide text-ink-muted">{category}</span>
      </div>

      <h3
        class="mt-3 font-black leading-[0.95] text-ink transition-colors duration-300 group-hover:text-blue group-focus-visible:text-blue"
        style="font-family: var(--font-display); font-size: clamp(2rem, 1.2rem + var(--shell) * 0.024, 3.5rem);"
      >
        {title}
      </h3>

      {/* Collapsed to nothing until hover on pointer screens; always open on touch,
          where there is no hover to reveal it. */}
      <div
        class="grid grid-rows-[1fr] transition-[grid-template-rows] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] md:grid-rows-[0fr] md:group-hover:grid-rows-[1fr] md:group-focus-visible:grid-rows-[1fr]"
      >
        <div class="overflow-hidden">
          <div
            class="pt-4 opacity-100 transition-opacity duration-500 ease-out md:opacity-0 md:group-hover:opacity-100 md:group-focus-visible:opacity-100"
          >
            <p class="max-w-xl text-sm leading-relaxed text-ink-muted">{description}</p>

            <div class="mt-5 flex flex-wrap items-center gap-x-8 gap-y-3">
              {
                timeline && (
                  <div>
                    <p class="text-[0.7rem] font-bold tracking-wide text-ink-muted">Timeline</p>
                    <p class="text-sm font-bold text-ink">{timeline}</p>
                  </div>
                )
              }
              <span
                class="flex items-center gap-2 text-sm font-bold text-blue transition-transform duration-300 ease-out group-hover:translate-x-1"
              >
                View project
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="h-4 w-4"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</a>
