---
// The custom cursor: a dot that tracks the pointer exactly and a ring that
// trails it. The ring used a motion-library spring; the same feel comes out of
// a critically-damped lerp on rAF, and costs no framework on every page.
---

<div data-cursor hidden>
  <div
    data-cursor-dot
    class="pointer-events-none fixed top-0 left-0 z-9999 h-2 w-2 rounded-full bg-blue opacity-0 transition-opacity duration-200"
  >
  </div>
  <div
    data-cursor-ring
    class="pointer-events-none fixed top-0 left-0 z-9999 h-8 w-8 rounded-full border border-blue opacity-0 transition-[opacity,width,height,background-color] duration-200 ease-out"
  >
  </div>
</div>

<script>
  const HOVER_SELECTOR = 'a, button, input, textarea, select, [role="button"], .cursor-hover';

  const root = document.querySelector<HTMLElement>("[data-cursor]");
  const dot = document.querySelector<HTMLElement>("[data-cursor-dot]");
  const ring = document.querySelector<HTMLElement>("[data-cursor-ring]");

  if (root && dot && ring) {
    const fine = window.matchMedia("(pointer: fine)");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    let frame = 0;
    let listening = false;
    let x = -100;
    let y = -100;
    let ringX = -100;
    let ringY = -100;
    let visible = false;
    let hovering = false;
    let pressed = false;

    const paint = () => {
      // The ring eases toward the pointer; 0.18 lands close to the spring the
      // motion library was configured with.
      ringX += (x - ringX) * 0.18;
      ringY += (y - ringY) * 0.18;
      const scale = pressed ? 0.85 : 1;
      dot.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%) scale(${pressed ? 0.6 : 1})`;
      ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate(-50%, -50%) scale(${scale})`;
      frame = requestAnimationFrame(paint);
    };

    const onMove = (e: MouseEvent) => {
      x = e.clientX;
      y = e.clientY;
      if (!visible) {
        visible = true;
        dot.style.opacity = hovering ? "0" : "1";
        ring.style.opacity = "1";
      }
    };
    const onOver = (e: MouseEvent) => {
      const target = e.target as HTMLElement | null;
      hovering = !!target?.closest?.(HOVER_SELECTOR);
      // The ring opens up over anything clickable and the dot steps out of the way.
      ring.style.width = hovering ? "56px" : "32px";
      ring.style.height = hovering ? "56px" : "32px";
      ring.style.backgroundColor = hovering ? "rgba(19, 67, 240, 0.12)" : "transparent";
      dot.style.opacity = visible && !hovering ? "1" : "0";
    };
    const onDown = () => {
      pressed = true;
    };
    const onUp = () => {
      pressed = false;
    };
    const onLeave = () => {
      visible = false;
      dot.style.opacity = "0";
      ring.style.opacity = "0";
    };

    const start = () => {
      if (listening) return;
      listening = true;
      root.hidden = false;
      document.addEventListener("mousemove", onMove, { passive: true });
      document.addEventListener("mouseover", onOver, { passive: true });
      document.addEventListener("mousedown", onDown, { passive: true });
      document.addEventListener("mouseup", onUp, { passive: true });
      document.documentElement.addEventListener("mouseleave", onLeave);
      frame = requestAnimationFrame(paint);
    };

    const stop = () => {
      if (!listening) return;
      listening = false;
      root.hidden = true;
      cancelAnimationFrame(frame);
      document.removeEventListener("mousemove", onMove);
      document.removeEventListener("mouseover", onOver);
      document.removeEventListener("mousedown", onDown);
      document.removeEventListener("mouseup", onUp);
      document.documentElement.removeEventListener("mouseleave", onLeave);
    };

    const sync = () => (fine.matches && !reduced.matches ? start() : stop());
    sync();
    fine.addEventListener("change", sync);
    reduced.addEventListener("change", sync);
  }
</script>
