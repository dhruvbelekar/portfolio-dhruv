---
import path from "node:path";
import sharp from "sharp";

interface Props {
  slug: string;
  title: string;
  category: string;
  image: string;
  alt: string;
}

const { slug, title, category, image, alt } = Astro.props;
const { width, height } = await sharp(path.join(process.cwd(), "public", image)).metadata();
---

<a href={`/projects-detail/${slug}`} class="group block">
  <div class="aspect-[3/2] w-full overflow-hidden rounded-2xl ring-1 ring-blue/0 transition-shadow duration-500 ease-out group-hover:shadow-[0_18px_40px_rgba(19,67,240,0.12)] group-hover:ring-blue/70">
    <img
      src={image}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      class="h-full w-full object-contain transition-transform duration-500 ease-out group-hover:scale-105"
    />
  </div>
  <h3 class="mt-4 text-lg font-bold text-ink transition-colors duration-300 group-hover:text-blue">
    {title}
  </h3>
  <p class="text-sm text-ink-muted">{category}</p>
</a>
