---
interface Props {
  slug: string;
  title: string;
  category: string;
  image: string;
  alt: string;
}

const { slug, title, category, image, alt } = Astro.props;
---

<a href={`/projects-detail/${slug}`} class="group block">
  <div class="aspect-[4/5] w-full overflow-hidden rounded-2xl bg-gray-100">
    <img
      src={image}
      alt={alt}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
    />
  </div>
  <h3 class="mt-4 text-lg font-bold text-ink">{title}</h3>
  <p class="text-sm text-ink-muted">{category}</p>
</a>
