---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Cursor from "../components/Cursor.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Dhruv Belekar",
  description = "I design digital experiences, create visual stories and bring ideas to life through design and film.",
  ogImage = "/og/og-home-sidequest.png",
} = Astro.props;

// LinkedIn, WhatsApp and Slack drop a relative og:image without complaint, and
// the share card comes back blank. Resolving against `site` makes them absolute.
const ogImageUrl = new URL(ogImage, Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {/*
      Every headline on the site is set in this one file, and a font referenced
      from a stylesheet is only discovered once that stylesheet has parsed.
      Preloading starts it with the CSS instead of after it.
    */}
    <link
      rel="preload"
      href="/fonts/inter-latin-opsz-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {/* The reveals start hidden and are released by script; without one, the page is the content. */}
    <noscript>
      <style>
        .reveal,
        [data-ts-tool] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body id="top">
    <Cursor />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import Lenis from "lenis";

      // Smooth scrolling for the whole page. A wheel notch is one large jump,
      // and the browser applies it in a single step; Lenis takes the notch and
      // plays it out across frames instead, which is what makes a mouse feel
      // like a trackpad. Touch is left alone — the OS already does this better
      // than script can, and hijacking it only adds lag to a direct gesture.
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
      const coarse = window.matchMedia("(pointer: coarse)");

      let lenis: Lenis | null = null;

      const startLenis = () => {
        if (lenis || reduced.matches || coarse.matches) return;
        lenis = new Lenis({
          duration: 0.9,
          // Eases out hard at the start and settles slowly, so a single notch
          // moves immediately rather than creeping away from the wheel.
          easing: (t: number) => 1 - Math.pow(1 - t, 3),
          smoothWheel: true,
          syncTouch: false,
        });

        const raf = (time: number) => {
          if (!lenis) return;
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      };

      const stopLenis = () => {
        lenis?.destroy();
        lenis = null;
      };

      startLenis();
      // Someone turning motion down mid-session gets the plain scroller back.
      reduced.addEventListener("change", () => (reduced.matches ? stopLenis() : startLenis()));

      document.addEventListener("click", (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        const link = (event.target as HTMLElement | null)?.closest?.("a[href*='#']") as
          | HTMLAnchorElement
          | null;
        if (!link || link.target === "_blank") return;

        // Only links landing somewhere on this same page — anything crossing a
        // document still needs the browser's own navigation.
        const url = new URL(link.href, location.href);
        if (
          url.origin !== location.origin ||
          url.pathname !== location.pathname ||
          url.hash.length < 2
        ) {
          return;
        }

        const target = document.querySelector<HTMLElement>(url.hash);
        if (!target) return;

        event.preventDefault();
        // Lenis owns the scroll position while it is running, so an anchor has
        // to be handed to it rather than scrolled around it.
        if (lenis) {
          lenis.scrollTo(target);
        } else {
          target.scrollIntoView({
            behavior: reduced.matches ? "auto" : "smooth",
            block: "start",
          });
        }
        history.pushState(null, "", url.hash);
      });

      // The filter bar scrolls the projects section into view on click, which
      // needs the same treatment.
      window.addEventListener("lenis:scroll-to", (event) => {
        const target = (event as CustomEvent<HTMLElement>).detail;
        if (!target) return;
        if (lenis) lenis.scrollTo(target);
        else target.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    </script>

    <script>
      // One observer for every reveal on the page, in place of the framer-motion
      // island each of them used to be.
      const reveals = document.querySelectorAll<HTMLElement>(".reveal");

      if (!("IntersectionObserver" in window)) {
        document.documentElement.classList.add("no-reveal");
      } else {
        let observerReported = false;
        const io = new IntersectionObserver(
          (entries) => {
            observerReported = true;
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-revealed");
              io.unobserve(entry.target);
            });
          },
          { rootMargin: "-10% 0px" }
        );

        // Anything already on screen is released by measuring its own box. A
        // page loaded in a background tab gets no intersection callbacks at
        // all, so its first screen would otherwise sit blank until the visitor
        // switched to it — hence the same sweep again on load and on the tab
        // coming forward.
        const sweep = () => {
          reveals.forEach((el) => {
            if (el.classList.contains("is-revealed")) return;
            const rect = el.getBoundingClientRect();
            if (rect.top < window.innerHeight && rect.bottom > 0) {
              el.classList.add("is-revealed");
              io.unobserve(el);
            }
          });
        };

        reveals.forEach((el) => io.observe(el));
        sweep();
        window.addEventListener("load", sweep, { once: true });
        window.addEventListener("pageshow", sweep);
        // A viewport that only gets its real height after first paint (an
        // embedded or restored window) would leave the sweep with nothing to
        // measure against, so it runs again once there is a size to compare to.
        window.addEventListener("resize", sweep, { passive: true });
        document.addEventListener("visibilitychange", () => {
          if (!document.hidden) sweep();
        });

        // Last resort. The observer does the work in every real browser, so
        // this listener measures nothing unless the first scroll arrives with
        // no observer callback ever having run — an unrevealed page is worse
        // than a scroll handler.
        const onScroll = () => {
          if (observerReported) {
            window.removeEventListener("scroll", onScroll);
            return;
          }
          sweep();
        };
        window.addEventListener("scroll", onScroll, { passive: true });
      }
    </script>
  </body>
</html>
